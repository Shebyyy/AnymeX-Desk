# Security headers for STATIC ASSET responses.
#
# On Workers this file configures headers for assets only. The same set is
# duplicated in src/middleware.ts, which covers the on-demand half.
# **If you add a header here, add it there too.**

/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
