---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import PreferencesModal from '../components/PreferencesModal.astro';
import InstallBanner from '../components/InstallBanner.astro';
import RolePreviewBanner from '../components/RolePreviewBanner.astro';
import { currentUser } from '../lib/auth';
import { effectiveStaffLevel } from '../lib/staff';

interface Props {
  title: string;
  description?: string;
  /** Wide pages (the board) vs reading pages (docs, forms). */
  narrow?: boolean;
  fullWidth?: boolean;
  noFooter?: boolean;
}

const {
  title,
  description = 'AnymeX bug and suggestion tracker. Vote on what matters most.',
  narrow = false,
  fullWidth = false,
  noFooter = false,
} = Astro.props;

const baseUser = await currentUser(Astro);
const staffPreview = baseUser ? await effectiveStaffLevel(Astro, baseUser.id) : null;
const maybeSignedIn = Astro.cookies.get('signed_in')?.value === '1';

const reportIdMatch = Astro.url.pathname.match(/^\/report\/(\d+)$/);
const ogImage = reportIdMatch
  ? `${Astro.url.origin}/og/${reportIdMatch[1]}.svg`
  : undefined;
---

<!doctype html>
<html lang="en" class:list={[{ 'full-screen-layout': fullWidth }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · AnymeX Desk</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/gif" href="/favicon.gif" />
    <link rel="shortcut icon" href="/favicon.gif" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0c0d0e" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="AnymeX Desk" />

    {/* Synchronous zero-FOUC preference initialization */}
    <script is:inline>
      (function() {
        try {
          var raw = localStorage.getItem('anymex_desk_prefs');
          if (!raw) return;
          var p = JSON.parse(raw);
          var doc = document.documentElement;
          if (p.scale && p.scale !== 'default') doc.setAttribute('data-scale', p.scale);
          if (p.theme && p.theme !== 'midnight' && p.theme !== 'system') doc.setAttribute('data-theme', p.theme);
          if (p.accent && p.accent !== 'gold') doc.setAttribute('data-accent', p.accent);
          if (p.reduceMotion) doc.setAttribute('data-reduce-motion', 'true');
          if (p.highContrast) doc.setAttribute('data-high-contrast', 'true');
          if (p.codeWrap) doc.setAttribute('data-code-wrap', 'true');
        } catch (e) {}
      })();
    </script>

    <meta property="og:site_name" content="AnymeX Desk" />
    <meta property="og:title" content={`${title} · AnymeX Desk`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={`${title} · AnymeX Desk`} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <Font cssVariable="--font-ui-family" preload={[{ subset: 'latin' }]} />
    <Font
      cssVariable="--font-data-family"
      preload={[
        { subset: 'latin', weight: 400 },
        { subset: 'latin', weight: 600 },
      ]}
    />
  </head>

  <body class:list={[{ 'full-screen-layout': fullWidth }]}>
    {staffPreview?.isPreview && (
      <RolePreviewBanner realLevel={staffPreview.realLevel} effectiveLevel={staffPreview.effectiveLevel} />
    )}
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class:list={[{ shell: !fullWidth, prose: narrow, 'full-bleed': fullWidth }]}>
      <slot />
    </main>

    {!noFooter && (
    <footer class="shell foot">
      <p>
        AnymeX Bug & Suggestion Desk.
        <a href="https://github.com/RyanYuuki/AnymeX">AnymeX</a>.
      </p>
    </footer>
    )}

    <PreferencesModal />
    <InstallBanner />

    <style is:global>
      html.full-screen-layout,
      body.full-screen-layout {
        height: 100dvh !important;
        max-height: 100dvh !important;
        overflow: hidden !important;
      }
      body.full-screen-layout {
        display: flex !important;
        flex-direction: column !important;
      }
      body.full-screen-layout main.full-bleed {
        flex: 1 1 auto !important;
        min-height: 0 !important;
        height: calc(100dvh - 56px) !important;
        max-height: calc(100dvh - 56px) !important;
        overflow: hidden !important;
        padding-block: 0 !important;
        padding-inline: 0 !important;
        max-inline-size: 100% !important;
      }
    </style>
    <style>
      main {
        flex: 1 1 auto;
        min-height: 0;
        inline-size: 100%;
        padding-block: var(--space-5) clamp(var(--space-6), 5vh, var(--space-12));
      }
      main.prose {
        max-inline-size: var(--measure-prose);
      }
      .foot {
        margin-block-start: auto;
        inline-size: 100%;
        padding-block: var(--space-5) calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
        border-block-start: 1px solid var(--border-subtle);
        font-size: var(--text-sm);
        color: var(--text-muted);
      }
      .foot a {
        color: var(--text-tertiary);
        text-decoration: underline;
        text-decoration-color: var(--border-strong);
        text-underline-offset: 2px;
      }
      .foot a:hover {
        color: var(--text-secondary);
      }
    </style>

    {(baseUser || maybeSignedIn) && (
      <script is:inline>
        (function() {
          function pingPresence() {
            if (document.visibilityState === 'visible') {
              fetch('/api/presence', {
                method: 'POST',
                headers: { 'Accept': 'application/json' },
                keepalive: true,
              }).catch(function() {});
            }
          }
          // Initial ping
          pingPresence();
          // Heartbeat every 60 seconds
          setInterval(pingPresence, 60000);
          // Ping when user returns to the tab
          window.addEventListener('focus', pingPresence);
          document.addEventListener('visibilitychange', function() {
            if (document.visibilityState === 'visible') pingPresence();
          });
        })();
      </script>
    )}
    <script src="../scripts/sw-register.ts"></script>
  </body>
</html>
