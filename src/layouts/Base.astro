---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  /** Wide pages (the board) vs reading pages (docs, forms). */
  narrow?: boolean;
}

const {
  title,
  description = 'AnymeX bug and suggestion tracker. Vote on what matters most.',
  narrow = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · AnymeX Tracker</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.gif" type="image/gif" />

    <Font cssVariable="--font-ui-family" preload={[{ subset: 'latin' }]} />
    <Font
      cssVariable="--font-data-family"
      preload={[
        { subset: 'latin', weight: 400 },
        { subset: 'latin', weight: 600 },
      ]}
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class:list={['shell', { prose: narrow }]}>
      <slot />
    </main>

    <footer class="shell foot">
      <p>
        AnymeX Bug & Suggestion Tracker.
        <a href="https://github.com/RyanYuuki/AnymeX">AnymeX</a>.
      </p>
    </footer>

    <style>
      main {
        padding-block: var(--space-6) var(--space-16);
      }
      main.prose {
        max-inline-size: var(--measure-prose);
      }
      .foot {
        padding-block: var(--space-6);
        border-block-start: 1px solid var(--border-subtle);
        font-size: var(--text-sm);
        color: var(--text-muted);
      }
      .foot a {
        color: var(--text-tertiary);
        text-decoration: underline;
        text-decoration-color: var(--border-strong);
        text-underline-offset: 2px;
      }
      .foot a:hover {
        color: var(--text-secondary);
      }
    </style>

  </body>
</html>
