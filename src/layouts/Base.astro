---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import PreferencesModal from '../components/PreferencesModal.astro';
import RolePreviewBanner from '../components/RolePreviewBanner.astro';
import { currentUser } from '../lib/auth';
import { effectiveStaffLevel } from '../lib/staff';

interface Props {
  title: string;
  description?: string;
  /** Wide pages (the board) vs reading pages (docs, forms). */
  narrow?: boolean;
}

const {
  title,
  description = 'AnymeX bug and suggestion tracker. Vote on what matters most.',
  narrow = false,
} = Astro.props;

const baseUser = await currentUser(Astro);
const staffPreview = baseUser ? await effectiveStaffLevel(Astro, baseUser.id) : null;

const reportIdMatch = Astro.url.pathname.match(/^\/report\/(\d+)$/);
const ogImage = reportIdMatch
  ? `${Astro.url.origin}/og/${reportIdMatch[1]}.svg`
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · AnymeX Desk</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/gif" href="/favicon.gif" />
    <link rel="shortcut icon" href="/favicon.gif" />

    {/* Synchronous zero-FOUC preference initialization */}
    <script is:inline>
      (function() {
        try {
          var raw = localStorage.getItem('anymex_desk_prefs');
          if (!raw) return;
          var p = JSON.parse(raw);
          var doc = document.documentElement;
          if (p.scale && p.scale !== 'default') doc.setAttribute('data-scale', p.scale);
          if (p.theme && p.theme !== 'midnight' && p.theme !== 'system') doc.setAttribute('data-theme', p.theme);
          if (p.accent && p.accent !== 'gold') doc.setAttribute('data-accent', p.accent);
          if (p.reduceMotion) doc.setAttribute('data-reduce-motion', 'true');
          if (p.highContrast) doc.setAttribute('data-high-contrast', 'true');
          if (p.codeWrap) doc.setAttribute('data-code-wrap', 'true');
        } catch (e) {}
      })();
    </script>

    <meta property="og:site_name" content="AnymeX Desk" />
    <meta property="og:title" content={`${title} · AnymeX Desk`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={`${title} · AnymeX Desk`} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <Font cssVariable="--font-ui-family" preload={[{ subset: 'latin' }]} />
    <Font
      cssVariable="--font-data-family"
      preload={[
        { subset: 'latin', weight: 400 },
        { subset: 'latin', weight: 600 },
      ]}
    />
  </head>

  <body>
    {staffPreview?.isPreview && (
      <RolePreviewBanner realLevel={staffPreview.realLevel} effectiveLevel={staffPreview.effectiveLevel} />
    )}
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class:list={['shell', { prose: narrow }]}>
      <slot />
    </main>

    <footer class="shell foot">
      <p>
        AnymeX Bug & Suggestion Desk.
        <a href="https://github.com/RyanYuuki/AnymeX">AnymeX</a>.
      </p>
    </footer>

    <PreferencesModal />

    <style>
      main {
        padding-block: var(--space-6) var(--space-16);
      }
      main.prose {
        max-inline-size: var(--measure-prose);
      }
      .foot {
        padding-block: var(--space-6);
        border-block-start: 1px solid var(--border-subtle);
        font-size: var(--text-sm);
        color: var(--text-muted);
      }
      .foot a {
        color: var(--text-tertiary);
        text-decoration: underline;
        text-decoration-color: var(--border-strong);
        text-underline-offset: 2px;
      }
      .foot a:hover {
        color: var(--text-secondary);
      }
    </style>

    {baseUser && (
      <script is:inline>
        (function() {
          function pingPresence() {
            if (document.visibilityState === 'visible') {
              fetch('/api/presence', { method: 'POST', keepalive: true }).catch(function() {});
            }
          }
          // Initial ping
          pingPresence();
          // Heartbeat every 2 minutes
          setInterval(pingPresence, 120000);
          // Ping when user returns to the tab
          window.addEventListener('focus', pingPresence);
        })();
      </script>
    )}
  </body>
</html>
