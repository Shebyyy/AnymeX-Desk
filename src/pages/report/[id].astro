---
import Base from '../../layouts/Base.astro';
import VoteButton from '../../components/VoteButton.astro';
import MediaLightbox from '../../components/MediaLightbox.astro';
import { and, asc, eq, inArray, isNull, sql } from 'drizzle-orm';
import { db } from '../../lib/db/client';
import { OPEN_STATUSES, STATUSES, reports, votes, attachments, comments, users,
  KIND_LABELS, CATEGORY_LABELS, PLATFORM_LABELS,
  BUG_CATEGORIES, SUGGESTION_CATEGORIES, EXTENSION_SOURCES, PLATFORMS,
  reportEdits, labels, reportLabels, commentReactions,
  ROADMAP_STAGES, ROADMAP_STAGE_LABELS, type RoadmapStage, normalizeTitle,
} from '../../lib/db/schema';
import { avatarUrl, currentUser, dbUser } from '../../lib/auth';
import { reporterMeta } from '../../lib/reporter';
import { atLeast } from '../../lib/levels';
import { isResponse, levelOf, logAction, requireStaff } from '../../lib/staff';
import { announceFixed, statusColor } from '../../lib/webhook';
import { notifyWatchers, sendDiscordDm } from '../../lib/notify';
import { updateForumThread, updateForumStatus, deleteForumThread, syncReportStatusFromDiscord, syncForumThreadLock } from '../../lib/discord-forums';
import { readSetting } from '../../lib/settings';
import { relativeAge, statusLabel, kindLabel, categoryLabel, platformLabel } from '../../lib/format';
import { parseExtensionEntries } from '../../lib/extensions';
import { prepareCommentBody } from '../../lib/richtext';
import { fetchLinkPreviews } from '../../lib/link-preview';
import { getPresence } from '../../lib/presence';
import { isReportLocked } from '../../lib/writes';
import { env } from 'cloudflare:workers';

export const prerender = false;

const id = Number(Astro.params.id);
if (!Number.isInteger(id)) return Astro.rewrite('/404');

/* Actions (POST). */
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');

  if (intent === 'label_add' || intent === 'label_remove') {
    const gate = await requireStaff(Astro, 'mod');
    if (isResponse(gate)) return gate;
    const labelId = Number(form.get('label_id'));
    if (Number.isSafeInteger(labelId) && labelId > 0) {
      if (intent === 'label_add') {
        await db().insert(reportLabels).values({ reportId: id, labelId }).onConflictDoNothing();
        await logAction(gate.user, 'report.label_add', String(id), `label ${labelId}`);
      } else {
        await db().delete(reportLabels).where(and(eq(reportLabels.reportId, id), eq(reportLabels.labelId, labelId)));
        await logAction(gate.user, 'report.label_remove', String(id), `label ${labelId}`);
      }
    }
    return Astro.redirect(`/report/${id}`, 303);
  }

  if (intent === 'roadmap') {
    const gate = await requireStaff(Astro, 'mod');
    if (isResponse(gate)) return gate;
    const rawStage = String(form.get('roadmap_stage') ?? '').trim();
    const stage = (ROADMAP_STAGES as readonly string[]).includes(rawStage) ? (rawStage as RoadmapStage) : null;
    const milestone = String(form.get('milestone') ?? '').trim().slice(0, 32) || null;

    await db()
      .update(reports)
      .set({ roadmapStage: stage, milestone, updatedAt: sql`(unixepoch())` })
      .where(eq(reports.id, id));
    await logAction(gate.user, 'report.roadmap', String(id), `stage=${stage ?? 'none'}, milestone=${milestone ?? 'none'}`);
    return Astro.redirect(`/report/${id}?saved=roadmap`, 303);
  }

  if (intent === 'edit') {
    // Must be the reporter (or a mod) and report must be open.
    const actingUser = await import('../../lib/auth').then((m) => m.currentUser(Astro));
    if (!actingUser) return Astro.redirect(`/auth/login?next=/report/${id}`, 302);

    const [target] = await db().select().from(reports).where(eq(reports.id, id));
    if (!target) return Astro.rewrite('/404');

    const isReporter = target.reporterId === actingUser.id;
    const isMod = await import('../../lib/staff').then((m) => m.levelOf(actingUser.id)).then((l) =>
      import('../../lib/levels').then((m) => m.atLeast(l, 'mod'))
    );

    if (!isReporter && !isMod) {
      return new Response('Forbidden', { status: 403 });
    }

    if (target.locked && !isMod) {
      return new Response('Forbidden: This report is locked', { status: 403 });
    }

    const newTitle    = String(form.get('title') ?? '').trim().slice(0, 200);
    const newBody     = String(form.get('body') ?? '').trim().slice(0, 5000) || null;
    const newSteps    = String(form.get('stepsToReproduce') ?? '').trim().slice(0, 5000) || null;
    const newCategory = String(form.get('category') ?? '').trim();
    const newPlatform = String(form.get('platform') ?? '').trim();

    // Build changed-field edit-history rows.
    const editRows: { reportId: number; editorId: string; field: string; oldValue: string | null; newValue: string | null }[] = [];
    if (newTitle && newTitle !== target.title) editRows.push({ reportId: id, editorId: actingUser.id, field: 'title', oldValue: target.title, newValue: newTitle });
    if (newBody !== target.body)             editRows.push({ reportId: id, editorId: actingUser.id, field: 'body',     oldValue: target.body,             newValue: newBody });
    if (newSteps !== target.stepsToReproduce) editRows.push({ reportId: id, editorId: actingUser.id, field: 'steps',    oldValue: target.stepsToReproduce, newValue: newSteps });
    if (newCategory && newCategory !== target.category) editRows.push({ reportId: id, editorId: actingUser.id, field: 'category', oldValue: target.category,         newValue: newCategory });
    if (newPlatform && (PLATFORMS as readonly string[]).includes(newPlatform) && newPlatform !== target.platform) {
      editRows.push({ reportId: id, editorId: actingUser.id, field: 'platform', oldValue: target.platform, newValue: newPlatform });
    }

    if (editRows.length > 0) {
      const updateSet: Record<string, unknown> = { updatedAt: sql`(unixepoch())`, editedAt: sql`(unixepoch())` };
      if (newTitle && newTitle !== target.title) {
        updateSet.title = newTitle;
        updateSet.normalizedTitle = normalizeTitle(newTitle);
      }
      if (newBody !== target.body) updateSet.body = newBody;
      if (newSteps !== target.stepsToReproduce) updateSet.stepsToReproduce = newSteps;
      if (editRows.some((r) => r.field === 'category') && newCategory) updateSet.category = newCategory;
      if (editRows.some((r) => r.field === 'platform') && newPlatform) updateSet.platform = newPlatform;

      const [updated] = await db().update(reports).set(updateSet as never).where(eq(reports.id, id)).returning();
      if (editRows.length > 0) {
        await db().insert(reportEdits).values(editRows);
      }
      const editTasks: Promise<unknown>[] = [
        import('../../lib/staff').then((m) =>
          m.logAction(actingUser, 'report.edit', String(id), `${editRows.map((r) => r.field).join(', ')}`, `${Astro.url.origin}/report/${id}`)
        ),
      ];
      if (updated) {
        editTasks.push(updateForumThread(updated, Astro.url.origin));
      }
      const cf = Astro.locals.cfContext;
      if (cf) for (const t of editTasks) cf.waitUntil(t);
      else await Promise.all(editTasks);
    }
    return Astro.redirect(`/report/${id}?saved=edit`, 303);
  }

  /* Moderator status / duplicate actions — require staff. */
  const gate = await requireStaff(Astro, 'mod');
  if (isResponse(gate)) return gate;

  const wanted = String(form.get('status') ?? '');

  if ((STATUSES as readonly string[]).includes(wanted)) {
    const status = wanted as (typeof STATUSES)[number];
    const rawNote = String(form.get('note') ?? '').trim().slice(0, 500);
    const statusNote = rawNote || null;
    const detail = statusNote ? `${status}: ${statusNote}` : status;
    const isClosing = ['fixed', 'wont_fix', 'duplicate'].includes(status);

    const updateSet: Record<string, unknown> = {
      status,
      statusNote,
      statusChangedAt: sql`(unixepoch())`,
      updatedAt: sql`(unixepoch())`,
    };
    if (isClosing) {
      updateSet.locked = true;
    } else {
      updateSet.locked = false;
    }

    const [updated] = await db()
      .update(reports)
      .set(updateSet as never)
      .where(eq(reports.id, id))
      .returning();
    if (updated) {
      const reportUrl = `${Astro.url.origin}/report/${id}`;
      await logAction(gate.user, 'report.status', String(id), detail, reportUrl);

      const after: Promise<unknown>[] = [
        notifyWatchers(id, 'status_changed', detail, gate.user.id),
        updateForumStatus(updated, status, statusNote, gate.user.username),
      ];

      if (updated.discordThreadId) {
        after.push(
          syncForumThreadLock(
            updated.discordThreadId,
            isClosing,
            updated.title,
            gate.user.username,
            statusNote || `Marked as ${statusLabel(status, wanted)}`,
            isClosing,
          ),
        );
      }

      if (updated.reporterId && updated.reporterId !== gate.user.id) {
        after.push(
          sendDiscordDm(updated.reporterId, {
            author: gate.user.username,
            title: `Report marked as ${statusLabel(status)}`,
            description: statusNote || undefined,
            url: reportUrl,
            color: statusColor(status),
            footer: updated.title,
          }),
        );
      }

      if (status === 'fixed') after.push(announceFixed(updated, Astro.url.origin));

      const cf = Astro.locals.cfContext;
      if (cf) for (const task of after) cf.waitUntil(task);
      else await Promise.all(after);
    }
    return Astro.redirect(`/report/${id}?saved=status`, 303);
  }

  /* Duplicate marking with smart voter migration. */
  const dupOf = String(form.get('duplicate_of') ?? '').trim();
  if (dupOf) {
    const dupId = Number(dupOf);
    if (Number.isSafeInteger(dupId) && dupId > 0 && dupId !== id) {
      const [updated] = await db()
        .update(reports)
        .set({
          status: 'duplicate',
          duplicateOf: dupId,
          locked: true,
          statusChangedAt: sql`(unixepoch())`,
          updatedAt: sql`(unixepoch())`,
        })
        .where(eq(reports.id, id))
        .returning();
      if (updated) {
        // Smart voter migration: transfer votes to canonical report
        const duplicateVoters = await db()
          .select({ discordId: votes.discordId })
          .from(votes)
          .where(eq(votes.reportId, id));

        if (duplicateVoters.length > 0) {
          const existingTargetVotes = await db()
            .select({ discordId: votes.discordId })
            .from(votes)
            .where(
              and(
                eq(votes.reportId, dupId),
                inArray(votes.discordId, duplicateVoters.map((v) => v.discordId)),
              ),
            );
          const existingSet = new Set(existingTargetVotes.map((v) => v.discordId));
          const newVotesToMigrate = duplicateVoters
            .filter((v) => !existingSet.has(v.discordId))
            .map((v) => ({ reportId: dupId, discordId: v.discordId }));

          if (newVotesToMigrate.length > 0) {
            await db().batch([
              db().insert(votes).values(newVotesToMigrate).onConflictDoNothing(),
              db()
                .update(reports)
                .set({ votes: sql`${reports.votes} + ${newVotesToMigrate.length}` })
                .where(eq(reports.id, dupId)),
            ]);
          }
        }

        await logAction(gate.user, 'report.duplicate', String(id), `merged into ${dupId}`, `${Astro.url.origin}/report/${id}`);
        const detail = `duplicate: merged into #${dupId}`;
        const dupTasks: Promise<unknown>[] = [
          notifyWatchers(id, 'duplicate', detail, gate.user.id),
          updateForumStatus(updated, 'duplicate', `Duplicate of #${dupId}`, gate.user.username),
        ];
        if (updated.discordThreadId) {
          dupTasks.push(
            syncForumThreadLock(
              updated.discordThreadId,
              true,
              updated.title,
              gate.user.username,
              `Merged into #${dupId}`,
              true,
            ),
          );
        }
        const cf = Astro.locals.cfContext;
        if (cf) for (const t of dupTasks) cf.waitUntil(t);
        else await Promise.all(dupTasks);
      }
      return Astro.redirect(`/report/${id}?saved=duplicate`, 303);
    }
  }

  return Astro.redirect(`/report/${id}`, 303);
}

/* Delete report (mod+ only). Cascades to votes, comments, attachments, notifications in DB.
   Also cleans up file blobs from KV and locks/archives the Discord forum thread. */
if (Astro.request.method === 'DELETE') {
  const gate = await requireStaff(Astro, 'mod');
  if (isResponse(gate)) return gate;

  // Collect attachment file paths for KV cleanup.
  const atts = await db()
    .select({ filePath: attachments.filePath })
    .from(attachments)
    .where(eq(attachments.reportId, id));

  // Delete the report — cascade handles votes, comments, attachments rows, notifications.
  const [deleted] = await db()
    .delete(reports)
    .where(eq(reports.id, id))
    .returning({ id: reports.id, title: reports.title, discordThreadId: reports.discordThreadId });

  if (deleted) {
    await logAction(gate.user, 'report.delete', String(id), deleted.title);

    const cleanup: Promise<unknown>[] = [];
    if (deleted.discordThreadId) {
      cleanup.push(deleteForumThread(deleted.discordThreadId, deleted.title));
    }
    const kv = env.SESSION as KVNamespace | undefined;
    if (kv && atts.length > 0) {
      for (const a of atts) cleanup.push(kv.delete(`upload:${a.filePath}`));
    }
    const cf = Astro.locals.cfContext;
    if (cf) for (const task of cleanup) cf.waitUntil(task);
    else await Promise.all(cleanup);

    return new Response(JSON.stringify({ deleted: true }), {
      status: 200,
      headers: { 'content-type': 'application/json' },
    });
  }
  return new Response(JSON.stringify({ error: 'not found' }), {
    status: 404,
    headers: { 'content-type': 'application/json' },
  });
}

let [report] = await db().select().from(reports).where(eq(reports.id, id));
if (!report) return Astro.rewrite('/404');

// Auto-sync status from Discord Forum thread tags if changed in Discord
if (report.discordThreadId) {
  const syncedStatus = await syncReportStatusFromDiscord(report);
  if (syncedStatus) {
    report.status = syncedStatus;
  }
}

// Report body and steps-to-reproduce get the same Discord-markdown
// rendering as comments — see richtext.ts. Title stays plain text.
const bodyRich = report.body ? prepareCommentBody(report.body) : null;
const stepsRich = report.stepsToReproduce ? prepareCommentBody(report.stepsToReproduce) : null;

const [user, reporter, reportAttachments, reportComments, commentAttachments, currentLabels, allLabels] = await Promise.all([
  currentUser(Astro),
  dbUser(report.reporterId),
  db()
    .select()
    .from(attachments)
    .where(and(eq(attachments.reportId, id), isNull(attachments.commentId)))
    .orderBy(asc(attachments.sortOrder)),
  db()
    .select({
      id: comments.id,
      body: comments.body,
      createdAt: comments.createdAt,
      updatedAt: comments.updatedAt,
      userId: comments.userId,
      username: users.username,
      avatarHash: users.avatarHash,
      lastSeen: users.lastSeen,
      lastLogin: users.lastLogin,
      replyToId: comments.replyToId,
    })
    .from(comments)
    .innerJoin(users, eq(comments.userId, users.discordId))
    .where(eq(comments.reportId, id))
    .orderBy(asc(comments.createdAt)),
  db()
    .select({
      commentId: attachments.commentId,
      id: attachments.id,
      fileName: attachments.fileName,
      filePath: attachments.filePath,
      fileType: attachments.fileType,
      mimeType: attachments.mimeType,
      fileSize: attachments.fileSize,
    })
    .from(attachments)
    .where(eq(attachments.reportId, id)),
  db()
    .select({ id: labels.id, name: labels.name, color: labels.color })
    .from(reportLabels)
    .innerJoin(labels, eq(reportLabels.labelId, labels.id))
    .where(eq(reportLabels.reportId, id)),
  db().select().from(labels).orderBy(labels.name),
]);

// Query reactions for all comments in one batch.
const commentIds = reportComments.map((c) => c.id);
const rawReactions = commentIds.length > 0
  ? await db()
      .select({
        commentId: commentReactions.commentId,
        emoji: commentReactions.emoji,
        discordId: commentReactions.discordId,
      })
      .from(commentReactions)
      .where(inArray(commentReactions.commentId, commentIds))
  : [];

// Group reactions: commentId -> list of { emoji, count, mine }
const reactionsByComment = new Map<number, { emoji: string; count: number; mine: boolean }[]>();
for (const cid of commentIds) {
  const cReactions = rawReactions.filter((r) => r.commentId === cid);
  const grouped = new Map<string, { count: number; mine: boolean }>();
  for (const r of cReactions) {
    const entry = grouped.get(r.emoji) ?? { count: 0, mine: false };
    entry.count++;
    if (user && r.discordId === user.id) entry.mine = true;
    grouped.set(r.emoji, entry);
  }
  reactionsByComment.set(
    cid,
    [...grouped.entries()].map(([emoji, v]) => ({ emoji, count: v.count, mine: v.mine })),
  );
}

// Group comment attachments by comment ID.
const attByComment = new Map<number, typeof commentAttachments>();
for (const a of commentAttachments) {
  if (a.commentId == null) continue;
  const list = attByComment.get(a.commentId) ?? [];
  list.push(a);
  attByComment.set(a.commentId, list);
}

// Order comments so each reply appears directly under its parent, not at
// the bottom in raw chronological order. Depth-first: every root comment is
// immediately followed by its replies (recursively), each in creation order.
type ReportComment = (typeof reportComments)[number];
const childrenByParent = new Map<number, ReportComment[]>();
const roots: ReportComment[] = [];
for (const c of reportComments) {
  if (c.replyToId != null) {
    const list = childrenByParent.get(c.replyToId) ?? [];
    list.push(c);
    childrenByParent.set(c.replyToId, list);
  } else {
    roots.push(c);
  }
}
const orderedComments: { comment: ReportComment; depth: number }[] = [];
function walk(list: ReportComment[], depth: number) {
  for (const c of list) {
    orderedComments.push({ comment: c, depth });
    const kids = childrenByParent.get(c.id);
    if (kids) walk(kids, depth + 1);
  }
}
walk(roots, 0);
// Orphans: replies whose parent got deleted end up with no root — append
// them at depth 0 so nothing silently disappears from the list.
const seen = new Set(orderedComments.map((o) => o.comment.id));
for (const c of reportComments) {
  if (!seen.has(c.id)) orderedComments.push({ comment: c, depth: 0 });
}

// Escape + linkify every comment body once, up front — inlining direct
// image/gif/video links as real media, and collecting every other pasted
// URL so its Open Graph preview can be fetched (cached) in one batch below,
// rather than re-parsing the body once per render.
const richByComment = new Map<number, ReturnType<typeof prepareCommentBody>>();
for (const { comment: c } of orderedComments) {
  if (c.body) richByComment.set(c.id, prepareCommentBody(c.body));
}
const allPreviewUrls = [
  ...(bodyRich?.previewUrls ?? []),
  ...(stepsRich?.previewUrls ?? []),
  ...[...richByComment.values()].flatMap((r) => r.previewUrls),
];
const linkPreviews = allPreviewUrls.length ? await fetchLinkPreviews(allPreviewUrls) : new Map();

const nowSeconds = Math.floor(Date.now() / 1000);
const canModerate = user ? atLeast(await levelOf(user.id), 'mod') : false;
// A report is "locked" if either a staff member manually locked it, OR its
// status is one of the closed ones (fixed/wont_fix/duplicate). See
// isReportLocked in lib/writes.ts. Members are blocked from commenting,
// reacting, editing, and attaching on locked reports. Staff bypass.
const isLocked = isReportLocked(report);
const isReporterCurrentViewer = user && reporter && (reporter.discordId === user.id || (user.telegramId && reporter.telegramId === user.telegramId));
const reporterPresence = canModerate && reporter
  ? getPresence(isReporterCurrentViewer ? nowSeconds : (reporter.lastSeen || reporter.lastLogin), reporter.lastLogin, nowSeconds)
  : null;
const mine = user
  ? (
      await db()
        .select({ r: votes.reportId })
        .from(votes)
        .where(and(eq(votes.reportId, id), eq(votes.discordId, user.id)))
    ).length > 0
  : false;

const joined = Astro.url.searchParams.has('joined');
const filed = Astro.url.searchParams.has('filed');
const saved = Astro.url.searchParams.get('saved');

const isLive = (OPEN_STATUSES as readonly string[]).includes(report.status);

/** Reporter (on open, unlocked report) or mod at any time. */
const canEdit = user != null && (
  (report.reporterId === user.id && isLive && !report.locked) || canModerate
);

const categories =
  report.kind === 'suggestion'
    ? SUGGESTION_CATEGORIES
    : report.kind === 'extension'
      ? EXTENSION_SOURCES
      : BUG_CATEGORIES;

let dupTarget = null;
if (report.duplicateOf) {
  const [target] = await db().select({ id: reports.id, title: reports.title }).from(reports).where(eq(reports.id, report.duplicateOf));
  dupTarget = target ?? null;
}

const contributorGuildId = (await readSetting('contributor_guild_id')) || '1545003117018357850';
const resolveAttUrl = (p: string) => p.startsWith('http') ? p : '/' + p;

Astro.response.headers.set(
  'Cache-Control',
  user ? 'private, no-store' : 'public, max-age=0, s-maxage=30, stale-while-revalidate=120',
);
---

<Base title={`${report.title}`} narrow>
  {
    saved && (
      <p class="flash" role="status">
        {saved === 'duplicate'
          ? dupTarget
            ? `Marked as a duplicate of #${report.duplicateOf}: ${dupTarget.title}`
            : 'Marked as a duplicate.'
          : saved === 'edit'
            ? 'Report updated.'
            : 'Status updated.'}
      </p>
    )
  }
  {
    (joined || filed) && (
      <p class="flash" role="status">
        {joined
          ? `Someone had already reported this. You've been added to it, so it now speaks for ${report.votes} people.`
          : "Filed. You're the first to report this one."}
      </p>
    )
  }

  <article>
    {isLocked && (
      <div class="locked-banner" role="status">
        <span class="locked-icon">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </span>
        <div class="locked-banner-text">
          <span>This report is locked. {canModerate ? 'You can still post as staff.' : 'Comments, reactions, and voting are disabled.'}</span>
          {report.statusNote && (
            <span class="locked-reason">Note: {report.statusNote}</span>
          )}
        </div>
      </div>
    )}
    <header class="head">
      <VoteButton reportId={report.id} votes={report.votes} mine={mine} closed={!isLive} locked={isLocked} />
      <div class="head-main">
        <h1>{report.title}</h1>
        <p class="meta-line">
          <span class="tag">{kindLabel(report.kind)}</span>
          <span class="tag">{categoryLabel(report.category)}</span>
          <span class="tag">{platformLabel(report.platform)}</span>
          {currentLabels.map((l) => (
            <span class="tag label-badge" style={`background: ${l.color}22; border-color: ${l.color}; color: ${l.color}; font-weight: 500;`}>
              {l.name}
            </span>
          ))}
          {report.appVersion && (
            <span class="ver">
              v{report.appVersion}
              {report.releaseChannel === 'beta' && <span class="badge-beta">Beta</span>}
            </span>
          )}
          <span class="by"> · filed by </span>
          <span class="filed-by">
            {(() => {
              const a = reporter ? avatarUrl({ id: reporter.discordId, avatarHash: reporter.avatarHash }, 20) : null;
              return (
                <div class:list={[{ 'avatar-presence-wrap': canModerate && reporterPresence }]}>
                  {a ? (
                    <img class="avatar" src={a} alt="" width="20" height="20" />
                  ) : (
                    <span class="avatar avatar-blank" aria-hidden="true" />
                  )}
                  {canModerate && reporterPresence && (
                    <span
                      class:list={['presence-cutout-dot', `presence-${reporterPresence.status}`]}
                      title={`Staff telemetry: ${reporterPresence.label}`}
                    ></span>
                  )}
                </div>
              );
            })()}
            {report.reporterId ? (
              <a href={`/user/${report.reporterId}`} class="reporter-link">
                {reporterMeta(report.reporterId, reporter).display}
              </a>
            ) : (
              <span>{reporterMeta(report.reporterId, reporter).display}</span>
            )}
          </span>
        </p>
      </div>
      {(canEdit || canModerate) && (
        <div class="head-actions">
          {canEdit && (
            <button
              type="button"
              class="btn btn-sm btn-head-action"
              id="toggle-edit-report-btn"
              title="Edit report title, description, or details"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              <span>Edit</span>
            </button>
          )}
          {canModerate && (
            <button
              type="button"
              class="btn btn-sm btn-head-action btn-staff-pill active"
              id="toggle-staff-panel-btn"
              title="Toggle staff moderation controls"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>Staff Controls</span>
            </button>
          )}
        </div>
      )}
    </header>

    <dl class="facts">
      <div>
        <dt class="label">Status</dt>
        <dd class="status" data-status={report.status}>
          {statusLabel(report.status, report.kind)}
        </dd>
      </div>
      {report.statusNote && (
        <div class="wide"><dt class="label">Note</dt><dd>{report.statusNote}</dd></div>
      )}
      <div><dt class="label">Category</dt><dd>{categoryLabel(report.category)}</dd></div>
      <div><dt class="label">Platform</dt><dd>{platformLabel(report.platform)}</dd></div>
      {report.appVersion && (
        <div>
          <dt class="label">App version</dt>
          <dd class="num">
            v{report.appVersion}
            {report.releaseChannel === 'beta' && <span class="badge-beta">Beta</span>}
          </dd>
        </div>
      )}
      {report.pluginVersion && (
        <div>
          <dt class="label">Plugin version</dt>
          <dd class="num">v{report.pluginVersion}</dd>
        </div>
      )}
      <div><dt class="label">{report.kind === 'suggestion' ? 'Suggested' : 'Reported'}</dt><dd>{relativeAge(report.createdAt)} ago</dd></div>
      {report.duplicateOf && dupTarget && (
        <div class="wide">
          <dt class="label">Duplicate of</dt>
          <dd><a href={`/report/${report.duplicateOf}`}>#{report.duplicateOf}: {dupTarget.title}</a></dd>
        </div>
      )}
      {report.discordThreadId && (
        <div class="wide">
          <dt class="label">Discord Thread</dt>
          <dd>
            <a
              href={`https://discord.com/channels/${contributorGuildId}/${report.discordThreadId}`}
              target="_blank"
              rel="noopener noreferrer"
              class="discord-thread-link"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="vertical-align: -2px; margin-right: 5px;">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
              </svg>
              Open Contributor Discord Thread ↗
            </a>
          </dd>
        </div>
      )}
    </dl>

    {/* ── Top-level Moderator controls (Mod+ only) ────────────────────── */}
    {
      canModerate && (
        <section class="mod-top-panel" id="staff-controls-panel">
          <div class="mod-panel-header">
            <div class="mod-panel-title">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>Staff Controls</span>
            </div>
            <span class="mod-staff-badge">Moderator View</span>
          </div>

          <div class="mod-panel-body">
            {/* Quick Status Bar */}
            <form method="POST" class="mod-status-form">
              <div class="mod-section-header">
                <span class="mod-label">Change Status</span>
                <span class="mod-hint">Move report to a new state</span>
              </div>
              <div class="field">
                <input id="note" name="note" class="input input-sm" maxlength="500" placeholder="Optional status note (shown publicly and in notifications)..." />
              </div>
              <div class="mod-status-pills">
                {STATUSES.map((st) => (
                  <button
                    class:list={['btn btn-sm mod-status-btn', { 'btn-status-active': st === report.status }]}
                    type="submit"
                    name="status"
                    value={st}
                    disabled={st === report.status}
                    data-status={st}
                  >
                    {statusLabel(st, report.kind)}
                  </button>
                ))}
              </div>
            </form>

            {/* Lock / Unlock */}
            <div class="mod-quick-row">
              <div class="mod-lock-box">
                <button
                  class="btn btn-sm lock-btn"
                  type="button"
                  id="lock-toggle-btn"
                  data-report-id={report.id}
                  data-locked={report.locked ? 'true' : 'false'}>
                  {report.locked ? (
                    <>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
                      </svg>
                      <span>Unlock report</span>
                    </>
                  ) : (
                    <>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                      </svg>
                      <span>Lock report</span>
                    </>
                  )}
                </button>
                <input
                  id="lock-reason-input"
                  class="input input-sm lock-reason-input"
                  type="text"
                  placeholder="Optional lock reason..."
                  maxlength="500"
                  style={report.locked ? 'display: none;' : ''}
                />
              </div>
            </div>

            {/* Labels Manager */}
            <div class="mod-labels-box">
              <div class="mod-section-header">
                <span class="mod-label">Labels</span>
              </div>
              <div class="mod-labels-current">
                {currentLabels.length === 0 ? (
                  <span class="mod-hint">No labels applied.</span>
                ) : (
                  currentLabels.map((l) => (
                    <form method="POST" class="label-chip-form">
                      <input type="hidden" name="intent" value="label_remove" />
                      <input type="hidden" name="label_id" value={l.id} />
                      <span class="tag label-badge" style={`background: ${l.color}22; border-color: ${l.color}; color: ${l.color};`}>
                        {l.name}
                        <button class="label-remove-btn" type="submit" title={`Remove ${l.name}`}>×</button>
                      </span>
                    </form>
                  ))
                )}
                {allLabels.filter((al) => !currentLabels.some((cl) => cl.id === al.id)).length > 0 && (
                  <form method="POST" class="label-add-inline">
                    <input type="hidden" name="intent" value="label_add" />
                    <select name="label_id" class="select select-sm" required onchange="this.form.submit()">
                      <option value="" disabled selected>+ Add label…</option>
                      {allLabels
                        .filter((al) => !currentLabels.some((cl) => cl.id === al.id))
                        .map((l) => <option value={l.id}>{l.name}</option>)}
                    </select>
                  </form>
                )}
              </div>
            </div>

            {/* Collapsible details for Roadmap, Duplicate, and Danger Zone */}
            <div class="mod-accordion-grid">
              <details class="mod-sub-details">
                <summary class="mod-sub-summary">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  <span>Roadmap &amp; Milestone</span>
                </summary>
                <form method="POST" class="mod-sub-content">
                  <input type="hidden" name="intent" value="roadmap" />
                  <div class="field-row">
                    <div class="field">
                      <label class="label" for="roadmap-stage">Stage</label>
                      <select id="roadmap-stage" name="roadmap_stage" class="select select-sm">
                        <option value="" selected={!report.roadmapStage}>None (Not on roadmap)</option>
                        {ROADMAP_STAGES.map((st) => (
                          <option value={st} selected={st === report.roadmapStage}>
                            {ROADMAP_STAGE_LABELS[st]}
                          </option>
                        ))}
                      </select>
                    </div>
                    <div class="field">
                      <label class="label" for="milestone">Milestone</label>
                      <input
                        id="milestone"
                        name="milestone"
                        class="input input-sm"
                        type="text"
                        maxlength="32"
                        placeholder="e.g. v2.4.0"
                        value={report.milestone ?? ''}
                      />
                    </div>
                  </div>
                  <button class="btn btn-sm" type="submit">Update roadmap</button>
                </form>
              </details>

              {report.status !== 'duplicate' && (
                <details class="mod-sub-details">
                  <summary class="mod-sub-summary">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    <span>Mark as Duplicate</span>
                  </summary>
                  <form method="POST" class="mod-sub-content">
                    <div class="field-row">
                      <input class="input input-sm num" name="duplicate_of" type="number" inputmode="numeric" placeholder="Target Report #" min="1" required />
                      <button class="btn btn-sm" type="submit">Mark duplicate</button>
                    </div>
                  </form>
                </details>
              )}

              <details class="mod-sub-details mod-danger-details">
                <summary class="mod-sub-summary text-danger">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                  <span>Danger Zone: Delete Report</span>
                </summary>
                <div class="mod-sub-content">
                  <p class="mod-hint">Permanently delete this report and all its votes, comments, and attachments. Cannot be undone.</p>
                  <button class="btn btn-danger btn-sm" type="button" id="delete-btn">Delete report permanently</button>
                </div>
              </details>
            </div>
          </div>
        </section>
      )
    }

    {/* ── Top-level In-place Edit report ─────────────────────────────── */}
    {canEdit && (
      <section class="edit-top-panel" id="report-edit-panel" style="display: none;">
        <div class="edit-panel-header">
          <div class="edit-panel-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            <span>Editing Report</span>
          </div>
          <button type="button" class="btn btn-ghost btn-sm" id="cancel-edit-btn">Cancel</button>
        </div>
        <form method="POST" class="edit-form">
          <input type="hidden" name="intent" value="edit" />

          <div class="field">
            <label class="label" for="edit-title">Title</label>
            <input
              id="edit-title"
              name="title"
              class="input"
              type="text"
              required
              maxlength="200"
              value={report.title}
            />
          </div>

          <div class="field-row">
            <div class="field">
              <label class="label" for="edit-category">Category</label>
              <select id="edit-category" name="category" class="select">
                {categories.map((c) => (
                  <option value={c} selected={c === report.category}>{CATEGORY_LABELS[c] ?? c}</option>
                ))}
              </select>
            </div>
            <div class="field">
              <label class="label" for="edit-platform">Platform</label>
              <select id="edit-platform" name="platform" class="select">
                {(['android','ios','windows','macos','linux','all'] as const).map((p) => (
                  <option value={p} selected={p === report.platform}>{PLATFORM_LABELS[p]}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="field">
            <label class="label" for="edit-body">Description</label>
            <textarea
              id="edit-body"
              name="body"
              class="textarea"
              rows="6"
              maxlength="5000"
            >{report.body ?? ''}</textarea>
          </div>

          {report.kind === 'bug' && (
            <div class="field">
              <label class="label" for="edit-steps">Steps to reproduce</label>
              <textarea
                id="edit-steps"
                name="stepsToReproduce"
                class="textarea"
                rows="4"
                maxlength="5000"
              >{report.stepsToReproduce ?? ''}</textarea>
            </div>
          )}

          <div class="edit-form-foot">
            <p class="mod-hint">Changes are recorded in the audit trail.</p>
            <div class="edit-actions">
              <button type="button" class="btn btn-ghost btn-sm" id="cancel-edit-btn-foot">Cancel</button>
              <button class="btn btn-primary btn-sm" type="submit">Save changes</button>
            </div>
          </div>
        </form>
      </section>
    )}

    {/* ── Main report view content (toggled off when editing) ────────── */}
    <div class="report-view-content" id="report-view-content">
      {report.body && (
        <div class="body" set:html={bodyRich?.html ?? ''} />
      )}
      {(bodyRich?.previewUrls ?? []).map((u) => {
        const p = linkPreviews.get(u);
        if (!p) return null;
        return (
          <a class="link-preview-card" href={u} target="_blank" rel="noopener noreferrer nofollow">
            {p.image && <img class="link-preview-thumb" src={p.image} alt="" loading="lazy" />}
            <div class="link-preview-text">
              {p.siteName && <span class="link-preview-site">{p.siteName}</span>}
              {p.title && <span class="link-preview-title">{p.title}</span>}
              {p.description && <span class="link-preview-desc">{p.description}</span>}
            </div>
          </a>
        );
      })}

      {report.stepsToReproduce && (
        <div class="steps">
          <h2>Steps to reproduce</h2>
          <div class="steps-body" set:html={stepsRich?.html ?? ''} />
        </div>
      )}
      {(stepsRich?.previewUrls ?? []).map((u) => {
        const p = linkPreviews.get(u);
        if (!p) return null;
        return (
          <a class="link-preview-card" href={u} target="_blank" rel="noopener noreferrer nofollow">
            {p.image && <img class="link-preview-thumb" src={p.image} alt="" loading="lazy" />}
            <div class="link-preview-text">
              {p.siteName && <span class="link-preview-site">{p.siteName}</span>}
              {p.title && <span class="link-preview-title">{p.title}</span>}
              {p.description && <span class="link-preview-desc">{p.description}</span>}
            </div>
          </a>
        );
      })}

      {report.kind === 'extension' && (
        <dl class="grid extension-details">
          <div class="wide">
            <dt class="label">Tested in native app</dt>
            <dd>{report.testedNativeApp ? 'Yes — only occurs in AnymeX' : 'Not confirmed'}</dd>
          </div>
          {report.extensionNames && (() => {
            const exts = parseExtensionEntries(report.extensionNames);
            const hasAnyIssue = exts.some((e) => Boolean(e.issue));
            return (
              <div class="wide">
                <dt class="label">Affected Extension(s)</dt>
                <dd>
                  {hasAnyIssue ? (
                    <div class="ext-detail-cards">
                      {exts.map((e) => (
                        <div class="ext-detail-card">
                          <div class="ext-detail-header">
                            <span class="ext-detail-name">{e.name}</span>
                            {e.version && (
                              <span class="ext-detail-ver">v{e.version.replace(/^v/i, '')}</span>
                            )}
                          </div>
                          {e.issue && (
                            <div class="ext-detail-issue">{e.issue}</div>
                          )}
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div class="ext-chips-grid">
                      {exts.map((e) => (
                        <div class="ext-chip">
                          <span class="ext-chip-name">{e.name}</span>
                          {e.version && (
                            <span class="ext-chip-ver">v{e.version.replace(/^v/i, '')}</span>
                          )}
                        </div>
                      ))}
                    </div>
                  )}
                </dd>
              </div>
            );
          })()}
          {report.extensionRepo && (
            <div class="wide">
              <dt class="label">Extension repository</dt>
              <dd><a href={report.extensionRepo} rel="noopener noreferrer nofollow">{report.extensionRepo}</a></dd>
            </div>
          )}
        </dl>
      )}

      {/* ── Attachments gallery ──────────────────────────────────────────── */}
      {reportAttachments.length > 0 && (
        <section class="attachments-section">
          <h2>Attachments ({reportAttachments.length})</h2>
          <div class="gallery">
            {reportAttachments.map((att) => (
              <div class="gallery-item" data-type={att.fileType}>
                {att.fileType === 'image' ? (
                  <button
                    type="button"
                    class="gallery-preview-btn"
                    data-lightbox-src={resolveAttUrl(att.filePath)}
                    data-lightbox-type="image"
                    data-lightbox-name={att.fileName}
                    aria-label={`View ${att.fileName}`}
                  >
                    <img
                      src={resolveAttUrl(att.filePath)}
                      alt={att.fileName}
                      loading="lazy"
                      class="gallery-img"
                    />
                    <span class="gallery-zoom-badge" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                    </span>
                  </button>
                ) : att.fileType === 'video' ? (
                  <div class="gallery-video-wrap">
                    <video
                      controls
                      preload="metadata"
                      class="gallery-video"
                      poster={att.thumbnailPath ? `/${att.thumbnailPath}` : undefined}
                      data-lightbox-src={resolveAttUrl(att.filePath)}
                      data-lightbox-type="video"
                      data-lightbox-name={att.fileName}
                    >
                      <source src={resolveAttUrl(att.filePath)} type={att.mimeType} />
                      Your browser does not support the video element.
                    </video>
                    <button
                      type="button"
                      class="gallery-expand-btn"
                      data-lightbox-src={resolveAttUrl(att.filePath)}
                      data-lightbox-type="video"
                      data-lightbox-name={att.fileName}
                      aria-label={`Open ${att.fileName} in full screen lightbox`}
                      title="Fullscreen in-app lightbox"
                    >
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
                    </button>
                  </div>
                ) : (
                  <a href={resolveAttUrl(att.filePath)} class="gallery-file" download={att.fileName}>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" />
                    </svg>
                    <span>{att.fileName} ({(att.fileSize / 1024).toFixed(0)} KB)</span>
                  </a>
                )}
                <span class="gallery-label">
                  {att.fileName} ({(att.fileSize / 1024).toFixed(0)} KB)
                </span>
              </div>
            ))}
          </div>
        </section>
      )}
    </div>

    {/* ── Comments section ─────────────────────────────────────────────── */}
    <section class="comments-section">
      <h2>Comments ({reportComments.length})</h2>

      <div class="comments-list" id="comments-list">
        {reportComments.length === 0 && (
          <p class="no-comments">No comments yet.</p>
        )}
        {orderedComments.map(({ comment: c, depth }) => {
          const avatar = avatarUrl({ id: c.userId, avatarHash: c.avatarHash }, 24);
          const isCommentAuthorViewer = user && c.userId === user.id;
          const commentPresence = canModerate
            ? getPresence(isCommentAuthorViewer ? nowSeconds : (c.lastSeen || c.lastLogin), c.lastLogin, nowSeconds)
            : null;
          const cAtts = attByComment.get(c.id) ?? [];
          const replyToUsername = c.replyToId != null
            ? reportComments.find((p) => p.id === c.replyToId)?.username ?? null
            : null;
          return (
            <div
              class="comment"
              id={`comment-${c.id}`}
              data-comment-id={c.id}
              data-is-reply={c.replyToId != null}
              style={depth > 0 ? `margin-inline-start: calc(${depth} * var(--space-6));` : undefined}
            >              <div class="comment-header">
                <div class="comment-author">
                  <a href={`/user/${c.userId}`} class="comment-author-link" title={`View ${c.username}'s profile`}>
                    <div class:list={[{ 'avatar-presence-wrap': canModerate && commentPresence }]}>
                      {avatar ? (
                        <img class="avatar" src={avatar} alt="" width="24" height="24" />
                      ) : (
                        <span class="avatar avatar-blank" aria-hidden="true" />
                      )}
                      {canModerate && commentPresence && (
                        <span
                          class:list={['presence-cutout-dot', `presence-${commentPresence.status}`]}
                          title={`Staff telemetry: ${commentPresence.label}`}
                        ></span>
                      )}
                    </div>
                    <span class="comment-username">{c.username}</span>
                  </a>
                  <span class="comment-time">{relativeAge(c.createdAt)} ago</span>
                  {c.updatedAt !== c.createdAt && <span class="comment-edited">(edited)</span>}
                </div>
              </div>
              {replyToUsername && (
                <p class="reply-context">↳ replying to <strong>{replyToUsername}</strong></p>
              )}
              {c.body && (
                <p
                  class="comment-body"
                  data-comment-body
                  data-raw-body={c.body}
                  set:html={richByComment.get(c.id)?.html ?? ''}
                />
              )}
              {(richByComment.get(c.id)?.previewUrls ?? []).map((u) => {
                const p = linkPreviews.get(u);
                if (!p) return null;
                return (
                  <a class="link-preview-card" href={u} target="_blank" rel="noopener noreferrer nofollow">
                    {p.image && <img class="link-preview-thumb" src={p.image} alt="" loading="lazy" />}
                    <div class="link-preview-text">
                      {p.siteName && <span class="link-preview-site">{p.siteName}</span>}
                      {p.title && <span class="link-preview-title">{p.title}</span>}
                      {p.description && <span class="link-preview-desc">{p.description}</span>}
                    </div>
                  </a>
                );
              })}
              {cAtts.length > 0 && (
                <div class="comment-attachments">
                  {cAtts.map((att) => (
                    <div class="comment-att" data-type={att.fileType}>
                      {att.fileType === 'image' ? (
                        <button
                          type="button"
                          class="comment-att-btn"
                          data-lightbox-src={resolveAttUrl(att.filePath)}
                          data-lightbox-type="image"
                          data-lightbox-name={att.fileName}
                          aria-label={`View ${att.fileName}`}
                        >
                          <img src={resolveAttUrl(att.filePath)} alt={att.fileName} class="comment-att-img" loading="lazy" />
                        </button>
                      ) : att.fileType === 'video' ? (
                        <div class="comment-video-wrap">
                          <video controls preload="metadata" class="comment-att-video">
                            <source src={resolveAttUrl(att.filePath)} type={att.mimeType} />
                          </video>
                          <button
                            type="button"
                            class="gallery-expand-btn"
                            data-lightbox-src={resolveAttUrl(att.filePath)}
                            data-lightbox-type="video"
                            data-lightbox-name={att.fileName}
                            title="Fullscreen in-app lightbox"
                            aria-label={`Open ${att.fileName} in full screen lightbox`}
                          >
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
                          </button>
                        </div>
                      ) : (
                        <a href={resolveAttUrl(att.filePath)} class="comment-att-file" download={att.fileName}>
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" />
                          </svg>
                          <span>{att.fileName} ({(att.fileSize / 1024).toFixed(0)} KB)</span>
                        </a>
                      )}
                      {canModerate && att.commentId != null && (
                        <button class="pin-btn" data-att-id={att.id} data-report-id={report.id} title="Pin to report attachments">
                          Pin to report
                        </button>
                      )}
                    </div>
                  ))}
                </div>
              )}

              {/* Comment Reactions */}
              <div class="comment-reactions" data-comment-id={c.id}>
                {(reactionsByComment.get(c.id) ?? []).map((rx) => (
                  <button
                    type="button"
                    class:list={['reaction-chip', { 'reaction-active': rx.mine }]}
                    data-reaction-btn
                    data-comment-id={c.id}
                    data-emoji={rx.emoji}
                    title={rx.mine ? `Remove ${rx.emoji}` : `React with ${rx.emoji}`}
                  >
                    <span class="rx-emoji">{rx.emoji}</span>
                    <span class="rx-count">{rx.count}</span>
                  </button>
                ))}
                {user && (
                  <details class="reaction-picker">
                    <summary class="reaction-picker-btn" title="Add reaction">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                      <span>+</span>
                    </summary>
                    <div class="reaction-picker-menu">
                      {(['👍', '✅', '🤔', '❌', '🎉'] as const).map((emoji) => (
                        <button
                          type="button"
                          class="reaction-emoji-btn"
                          data-reaction-btn
                          data-comment-id={c.id}
                          data-emoji={emoji}
                        >
                          {emoji}
                        </button>
                      ))}
                    </div>
                  </details>
                )}
              </div>

              <div class="comment-actions">
                {user && (
                  <button
                    type="button"
                    class="reply-btn"
                    data-comment-id={c.id}
                    data-username={c.username}
                  >
                    Reply
                  </button>
                )}
                {user && user.id === c.userId && c.body && (
                  <button
                    type="button"
                    class="reply-btn edit-btn"
                    data-comment-id={c.id}
                  >
                    Edit
                  </button>
                )}
                {user && (user.id === c.userId || canModerate) && (
                  <button
                    type="button"
                    class="reply-btn delete-comment-btn"
                    data-comment-id={c.id}
                  >
                    Delete
                  </button>
                )}
              </div>
            </div>
          );
        })}
      </div>

      {user && !isLocked && (
        <form class="comment-form" id="comment-form">
          <input type="hidden" name="reportId" value={report.id} />
          <input type="hidden" name="replyToId" id="reply-to-id" value="" />
          <p class="reply-indicator" id="reply-indicator" style="display: none;">
            Replying to <strong id="reply-indicator-username"></strong>
            <button type="button" id="cancel-reply-btn" class="cancel-reply-btn">Cancel</button>
          </p>
          <div class="comment-input-row">
            <input id="comment-file" type="file" multiple class="sr-only" />
            <button type="button" class="btn btn-ghost attach-btn" id="attach-btn" title="Attach a file">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48" />
              </svg>
              <span class="sr-only">Attach a file</span>
            </button>
            <span class="file-chip" id="file-chip"></span>
          </div>
          <div class="mention-wrap">
            <textarea
              name="body"
              class="textarea"
              id="comment-body"
              rows="3"
              maxlength="2000"
              placeholder="Add a comment... use @ to mention someone"
            ></textarea>
            <ul class="mention-dropdown" id="mention-dropdown" style="display: none;"></ul>
          </div>
          <div class="comment-form-actions">
            <span class="char-hint">Max 2000 characters</span>
            <button class="btn" type="submit" id="comment-btn">Post</button>
          </div>
        </form>
      )}

      {/* Staff can still comment on a locked report — render a separate form
          marked data-staff-locked so the client JS knows to bypass the lock
          notice. Members never see this (gated by canModerate). */}
      {user && isLocked && canModerate && (
        <form class="comment-form" id="comment-form" data-staff-locked>
          <input type="hidden" name="reportId" value={report.id} />
          <input type="hidden" name="replyToId" id="reply-to-id" value="" />
          <p class="reply-indicator" id="reply-indicator" style="display: none;">
            Replying to <strong id="reply-indicator-username"></strong>
            <button type="button" id="cancel-reply-btn" class="cancel-reply-btn">Cancel</button>
          </p>
          <div class="comment-input-row">
            <input id="comment-file" type="file" multiple class="sr-only" />
            <button type="button" class="btn btn-ghost attach-btn" id="attach-btn" title="Attach a file">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48" />
              </svg>
              <span class="sr-only">Attach a file</span>
            </button>
            <span class="file-chip" id="file-chip"></span>
          </div>
          <div class="mention-wrap">
            <textarea
              name="body"
              class="textarea"
              id="comment-body"
              rows="3"
              maxlength="2000"
              placeholder="Add a comment (staff posting on a locked report)..."
            ></textarea>
            <ul class="mention-dropdown" id="mention-dropdown" style="display: none;"></ul>
          </div>
          <div class="comment-form-actions">
            <span class="char-hint">Max 2000 characters</span>
            <button class="btn" type="submit" id="comment-btn">Post</button>
          </div>
        </form>
      )}

      {user && isLocked && !canModerate && (
        <p class="comments-locked-notice">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>Comments are locked on this report.</span>
        </p>
      )}
    </section>

    {/* Edit report and Moderator controls are placed at the top of the report */}
  </article>

  <MediaLightbox />
</Base>

<script>
  // ── File attachment for comment (multiple) ───────────────────────────
  const commentFile = document.getElementById('comment-file') as HTMLInputElement | null;
  const attachBtn = document.getElementById('attach-btn') as HTMLButtonElement | null;
  const fileChip = document.getElementById('file-chip');
  const MAX_FILES_PER_COMMENT = 5;
  let selectedFiles: File[] = [];

  attachBtn?.addEventListener('click', () => commentFile?.click());
  commentFile?.addEventListener('change', () => {
    for (const f of Array.from(commentFile.files ?? [])) {
      if (selectedFiles.length >= MAX_FILES_PER_COMMENT) break;
      if (!selectedFiles.find(x => x.name === f.name && x.size === f.size)) {
        selectedFiles.push(f);
      }
    }
    commentFile.value = '';
    renderFileChip();
  });

  function renderFileChip() {
    if (!fileChip) return;
    if (selectedFiles.length === 0) {
      fileChip.textContent = '';
      fileChip.style.display = 'none';
      return;
    }
    const parts = selectedFiles.map((f, i) => {
      const size = f.size > 1024 * 1024
        ? `${(f.size / (1024 * 1024)).toFixed(1)} MB`
        : `${(f.size / 1024).toFixed(0)} KB`;
      return `${f.name} (${size})`;
    });
    fileChip.textContent = `${selectedFiles.length} file${selectedFiles.length !== 1 ? 's' : ''}: ${parts.join(', ')}`;
    fileChip.style.display = '';
  }

  // ── Reply to a comment ─────────────────────────────────────────────
  const replyToIdInput = document.getElementById('reply-to-id') as HTMLInputElement | null;
  const replyIndicator = document.getElementById('reply-indicator') as HTMLElement | null;
  const replyIndicatorUsername = document.getElementById('reply-indicator-username');
  const cancelReplyBtn = document.getElementById('cancel-reply-btn') as HTMLButtonElement | null;

  function startReply(commentId: string, username: string) {
    if (replyToIdInput) replyToIdInput.value = commentId;
    if (replyIndicatorUsername) replyIndicatorUsername.textContent = username;
    if (replyIndicator) replyIndicator.style.display = '';
    commentBody?.focus();
    commentForm?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function cancelReply() {
    if (replyToIdInput) replyToIdInput.value = '';
    if (replyIndicator) replyIndicator.style.display = 'none';
  }

  document.querySelectorAll('.reply-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const commentId = (btn as HTMLElement).dataset.commentId;
      const username = (btn as HTMLElement).dataset.username;
      if (commentId && username) startReply(commentId, username);
    });
  });

  cancelReplyBtn?.addEventListener('click', cancelReply);

  // ── Comment posting (with optional file) ──────────────────────────
  const commentForm = document.getElementById('comment-form') as HTMLFormElement | null;
  const commentBody = document.getElementById('comment-body') as HTMLTextAreaElement | null;
  const commentBtn = document.getElementById('comment-btn') as HTMLButtonElement | null;

  commentForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const body = commentBody?.value.trim() ?? '';
    if (!body && selectedFiles.length === 0) return;
    commentBtn!.disabled = true;
    commentBtn!.textContent = 'Posting…';
    try {
      const fd = new FormData();
      fd.append('reportId', (commentForm!.querySelector('[name=reportId]') as HTMLInputElement).value);
      fd.append('body', body);
      if (replyToIdInput?.value) fd.append('replyToId', replyToIdInput.value);
      for (const f of selectedFiles) fd.append('files', f);
      const res = await fetch('/comments', { method: 'POST', body: fd });
      if (!res.ok) {
        const err = await res.json().catch(() => ({ error: 'Failed to post' }));
        alert(err.error || 'Failed to post');
        return;
      }
      commentBody!.value = '';
      selectedFiles = [];
      cancelReply();
      if (fileChip) { fileChip.textContent = ''; fileChip.style.display = 'none'; }
      await pollLiveUpdates();
      const newestEl = document.getElementById('comment-' + latestCommentId);
      if (newestEl) newestEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      else window.location.reload();
    } catch {
      alert('Network error');
    } finally {
      commentBtn!.disabled = false;
      commentBtn!.textContent = 'Post';
    }
  });

  // ── @mention autocomplete ───────────────────────────────────────────
  const mentionDropdown = document.getElementById('mention-dropdown') as HTMLUListElement | null;
  let mentionStart = -1; // index of the '@' that's currently being completed
  let mentionResults: { id: string; username: string; avatarUrl: string | null }[] = [];
  let mentionActiveIndex = -1;
  let mentionAbort: AbortController | null = null;

  function closeMentionDropdown() {
    mentionStart = -1;
    mentionActiveIndex = -1;
    if (mentionDropdown) { mentionDropdown.style.display = 'none'; mentionDropdown.innerHTML = ''; }
  }

  function renderMentionDropdown() {
    if (!mentionDropdown) return;
    if (mentionResults.length === 0) { closeMentionDropdown(); return; }
    mentionDropdown.innerHTML = '';
    mentionResults.forEach((u, i) => {
      const li = document.createElement('li');
      li.className = 'mention-option' + (i === mentionActiveIndex ? ' active' : '');
      li.dataset.index = String(i);
      li.innerHTML = `${u.avatarUrl ? `<img src="${u.avatarUrl}" width="18" height="18" alt="" />` : ''}<span>${u.username}</span>`;
      li.addEventListener('mousedown', (e) => {
        e.preventDefault(); // keep textarea focus
        applyMention(i);
      });
      mentionDropdown.appendChild(li);
    });
    mentionDropdown.style.display = '';
  }

  function applyMention(i: number) {
    const u = mentionResults[i];
    if (!u || !commentBody || mentionStart < 0) return;
    const caret = commentBody.selectionStart ?? commentBody.value.length;
    const before = commentBody.value.slice(0, mentionStart);
    const after = commentBody.value.slice(caret);
    const insertion = `@${u.username} `;
    commentBody.value = before + insertion + after;
    const newCaret = before.length + insertion.length;
    commentBody.setSelectionRange(newCaret, newCaret);
    closeMentionDropdown();
  }

  async function queryMentions(q: string) {
    mentionAbort?.abort();
    mentionAbort = new AbortController();
    try {
      const res = await fetch(`/users/search?q=${encodeURIComponent(q)}`, { signal: mentionAbort.signal });
      if (!res.ok) { closeMentionDropdown(); return; }
      mentionResults = await res.json();
      mentionActiveIndex = mentionResults.length > 0 ? 0 : -1;
      renderMentionDropdown();
    } catch {
      // aborted or network hiccup — just drop it, not worth surfacing
    }
  }

  commentBody?.addEventListener('input', () => {
    const caret = commentBody.selectionStart ?? 0;
    const uptoCaret = commentBody.value.slice(0, caret);
    const match = uptoCaret.match(/(?:^|\s)@([a-zA-Z0-9_.]{0,32})$/);
    if (match) {
      mentionStart = caret - match[1].length - 1;
      const q = match[1];
      if (q.length > 0) queryMentions(q);
      else closeMentionDropdown();
    } else {
      closeMentionDropdown();
    }
  });

  commentBody?.addEventListener('keydown', (e) => {
    if (mentionStart < 0 || mentionResults.length === 0) return;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      mentionActiveIndex = (mentionActiveIndex + 1) % mentionResults.length;
      renderMentionDropdown();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      mentionActiveIndex = (mentionActiveIndex - 1 + mentionResults.length) % mentionResults.length;
      renderMentionDropdown();
    } else if (e.key === 'Enter' || e.key === 'Tab') {
      if (mentionActiveIndex >= 0) {
        e.preventDefault();
        applyMention(mentionActiveIndex);
      }
    } else if (e.key === 'Escape') {
      closeMentionDropdown();
    }
  });

  commentBody?.addEventListener('blur', () => {
    // Delay so a mousedown selection on the dropdown can still register.
    setTimeout(closeMentionDropdown, 150);
  });

  // ── Edit a comment ───────────────────────────────────────────────────
  document.querySelectorAll('.edit-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const commentId = (btn as HTMLElement).dataset.commentId;
      const commentEl = document.querySelector(`.comment[data-comment-id="${commentId}"]`);
      const bodyEl = commentEl?.querySelector('[data-comment-body]') as HTMLElement | null;
      if (!commentId || !commentEl || !bodyEl || commentEl.querySelector('.edit-form')) return;

      // Prefer the raw, unrendered body — textContent alone would lose
      // image-link URLs entirely, since they're rendered as an <img> with
      // no visible text.
      const original = bodyEl.dataset.rawBody ?? bodyEl.textContent ?? '';
      bodyEl.style.display = 'none';

      const form = document.createElement('div');
      form.className = 'edit-form';
      form.innerHTML = `
        <textarea class="textarea edit-textarea" maxlength="2000">${original.replace(/</g, '&lt;')}</textarea>
        <div class="edit-form-actions">
          <button type="button" class="btn edit-save-btn">Save</button>
          <button type="button" class="btn btn-ghost edit-cancel-btn">Cancel</button>
        </div>
      `;
      bodyEl.insertAdjacentElement('afterend', form);
      const textarea = form.querySelector('.edit-textarea') as HTMLTextAreaElement;
      textarea.focus();
      textarea.setSelectionRange(textarea.value.length, textarea.value.length);

      form.querySelector('.edit-cancel-btn')?.addEventListener('click', () => {
        form.remove();
        bodyEl.style.display = '';
      });

      form.querySelector('.edit-save-btn')?.addEventListener('click', async () => {
        const newBody = textarea.value.trim();
        if (!newBody) { alert('Comment cannot be empty'); return; }
        const saveBtn = form.querySelector('.edit-save-btn') as HTMLButtonElement;
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving…';
        try {
          const fd = new FormData();
          fd.append('commentId', commentId);
          fd.append('body', newBody);
          const res = await fetch('/comments', { method: 'PUT', body: fd });
          if (!res.ok) {
            const err = await res.json().catch(() => ({ error: 'Failed to save' }));
            alert(err.error || 'Failed to save');
            saveBtn.disabled = false;
            saveBtn.textContent = 'Save';
            return;
          }
          window.location.reload();
        } catch {
          alert('Network error');
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save';
        }
      });
    });
  });

  // ── Delete a comment ─────────────────────────────────────────────────
  document.querySelectorAll('.delete-comment-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!confirm('Delete this comment? This cannot be undone.')) return;
      const commentId = (btn as HTMLElement).dataset.commentId;
      if (!commentId) return;
      (btn as HTMLButtonElement).disabled = true;
      try {
        const fd = new FormData();
        fd.append('commentId', commentId);
        const res = await fetch('/comments', { method: 'DELETE', body: fd });
        if (res.ok) { window.location.reload(); return; }
        const err = await res.json().catch(() => ({ error: 'Failed to delete' }));
        alert(err.error || 'Failed to delete');
        (btn as HTMLButtonElement).disabled = false;
      } catch {
        alert('Network error');
        (btn as HTMLButtonElement).disabled = false;
      }
    });
  });

  // ── Pin attachment (mod only) ─────────────────────────────────────
  document.querySelectorAll('.pin-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const attId = (btn as HTMLElement).dataset.attId;
      const reportId = (btn as HTMLElement).dataset.reportId;
      if (!attId || !reportId) return;
      btn.textContent = 'Pinning…';
      try {
        const fd = new FormData();
        fd.append('attachmentId', attId);
        fd.append('reportId', reportId);
        const res = await fetch('/comments/pin', { method: 'PUT', body: fd });
        if (res.ok) window.location.reload();
        else { alert('Failed to pin'); btn.textContent = 'Pin to report'; }
      } catch { alert('Network error'); btn.textContent = 'Pin to report'; }
    });
  });

  // ── Delete report ─────────────────────────────────────────────────
  const deleteBtn = document.getElementById('delete-btn') as HTMLButtonElement | null;
  deleteBtn?.addEventListener('click', async () => {
    if (!confirm('Are you sure? This will permanently delete this report, all votes, comments, and attachments.')) return;
    if (!confirm('Really delete? This cannot be undone.')) return;
    deleteBtn.disabled = true;
    deleteBtn.textContent = 'Deleting…';
    try {
      const res = await fetch(window.location.pathname, { method: 'DELETE' });
      if (res.ok) { window.location.href = '/'; }
      else {
        const err = await res.json().catch(() => ({ error: 'Delete failed' }));
        alert(err.error || 'Delete failed');
        deleteBtn.disabled = false;
        deleteBtn.textContent = 'Delete report';
      }
    } catch {
      alert('Network error');
      deleteBtn.disabled = false;
      deleteBtn.textContent = 'Delete report';
    }
  });
  // ── Comment reaction toggle ─────────────────────────────────────
  document.addEventListener('click', async (e) => {
    const btn = (e.target as Element).closest('[data-reaction-btn]') as HTMLButtonElement | null;
    if (!btn) return;
    const commentId = btn.dataset.commentId;
    const emoji = btn.dataset.emoji;
    if (!commentId || !emoji) return;

    btn.disabled = true;
    try {
      const res = await fetch('/react', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ commentId: Number(commentId), emoji }),
      });
      if (res.ok) {
        window.location.reload();
      } else if (res.status === 401) {
        window.location.href = `/auth/login?next=${encodeURIComponent(window.location.pathname)}`;
      } else {
        btn.disabled = false;
      }
    } catch {
      btn.disabled = false;
    }
  });

  // ── Live real-time polling (zero refresh needed) ──────────────────────────
  const reportIdMeta = Number((document.getElementById('comment-form')?.querySelector('[name=reportId]') as HTMLInputElement)?.value || 0);
  let currentReportStatus = document.querySelector('dd.status')?.getAttribute('data-status') || '';
  let latestCommentId = 0;
  document.querySelectorAll<HTMLElement>('.comment[data-comment-id]').forEach((el) => {
    const cid = Number(el.dataset.commentId) || 0;
    if (cid > latestCommentId) latestCommentId = cid;
  });

  async function pollLiveUpdates() {
    if (!reportIdMeta) return;
    try {
      const res = await fetch(`/api/v1/report-live?reportId=${reportIdMeta}&after=${latestCommentId}`);
      if (!res.ok) return;
      const data = await res.json();

      // 1. Live status update
      if (data.status && data.status !== currentReportStatus) {
        currentReportStatus = data.status;
        const statusEl = document.querySelector('dd.status');
        if (statusEl) {
          statusEl.setAttribute('data-status', data.status);
          statusEl.textContent = data.statusLabel || data.status;
          statusEl.classList.add('status-updated-flash');
          setTimeout(() => statusEl.classList.remove('status-updated-flash'), 1200);
        }
      }

      // 2. Live new comments injection
      if (Array.isArray(data.newComments) && data.newComments.length > 0) {
        const commentsSection = document.querySelector('.comments-section');
        let commentsList = commentsSection?.querySelector('.comments-list');

        if (!commentsList && commentsSection) {
          commentsList = document.createElement('div');
          commentsList.className = 'comments-list';
          const emptyNotice = commentsSection.querySelector('.empty');
          if (emptyNotice) emptyNotice.remove();
          commentsSection.appendChild(commentsList);
        }

        for (const c of data.newComments) {
          if (document.querySelector(`.comment[data-comment-id="${c.id}"]`)) continue;
          latestCommentId = Math.max(latestCommentId, c.id);

          const el = document.createElement('div');
          el.className = 'comment live-comment-enter';
          el.id = `comment-${c.id}`;
          el.dataset.commentId = String(c.id);

          let attsHtml = '';
          if (c.attachments && c.attachments.length > 0) {
            attsHtml = `<div class="comment-attachments">` + c.attachments.map((att: any) => {
              const srcUrl = att.filePath ? (att.filePath.startsWith('http') ? att.filePath : '/' + att.filePath.replace(/^\/+/, '')) : (att.url || '');
              if (att.fileType === 'image') {
                return `<div class="comment-att" data-type="image"><a href="${srcUrl}" target="_blank" rel="noopener"><img src="${srcUrl}" alt="${att.fileName}" class="comment-att-img" loading="lazy" /></a></div>`;
              } else if (att.fileType === 'video') {
                return `<div class="comment-att" data-type="video"><video controls preload="metadata" class="comment-att-video"><source src="${srcUrl}" type="${att.mimeType || 'video/mp4'}" /></video></div>`;
              } else {
                return `<div class="comment-att" data-type="file"><a href="${srcUrl}" class="comment-att-file" download="${att.fileName}"><span>${att.fileName}</span></a></div>`;
              }
            }).join('') + `</div>`;
          }

          el.innerHTML = `
            <div class="comment-header">
              <div class="comment-author">
                <a href="/user/${c.userId}" class="comment-author-link" title="View ${c.username}'s profile">
                  <img class="avatar" src="${c.avatarUrl || 'https://cdn.discordapp.com/embed/avatars/0.png'}" alt="" width="24" height="24" />
                  <span class="comment-username">${c.username}</span>
                </a>
                <span class="comment-time">just now</span>
              </div>
            </div>
            ${c.body ? `<div class="comment-body" data-comment-body data-raw-body="${c.body.replace(/"/g, '&quot;')}">${c.bodyHtml || c.body.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</div>` : ''}
            ${attsHtml}
          `;

          commentsList?.appendChild(el);
        }

        const countHeading = commentsSection?.querySelector('h2');
        if (countHeading && data.commentCount != null) {
          countHeading.textContent = 'Comments (' + data.commentCount + ')';
        }
      }

      // 3. Live comment deletion: remove any comments deleted on Discord/site
      if (Array.isArray(data.allCommentIds)) {
        const idSet = new Set(data.allCommentIds);
        document.querySelectorAll('.comment[data-comment-id]').forEach((el) => {
          const cid = Number((el as HTMLElement).dataset.commentId);
          if (cid && !idSet.has(cid)) {
            (el as HTMLElement).style.transition = 'all 0.3s ease';
            (el as HTMLElement).style.opacity = '0';
            (el as HTMLElement).style.transform = 'translateY(-8px)';
            setTimeout(() => el.remove(), 300);
          }
        });
      }

      // 4. Live lock synchronization: if lock state changed, reload to sync UI
      if (typeof data.locked === 'boolean') {
        const isCurrentlyLocked = lockBtn
          ? lockBtn.dataset.locked === 'true'
          : document.querySelector('.locked-banner') != null;
        if (data.locked !== isCurrentlyLocked) {
          window.location.reload();
        }
      }
    } catch {}
  }

  // Poll every 5 seconds
  if (reportIdMeta > 0) {
    setInterval(pollLiveUpdates, 5000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') pollLiveUpdates();
    });
  }

  // ── Lock / Unlock button (staff only) ────────────────────────────────
  const lockBtn = document.getElementById('lock-toggle-btn') as HTMLButtonElement | null;
  const lockReasonInput = document.getElementById('lock-reason-input') as HTMLInputElement | null;
  lockBtn?.addEventListener('click', async () => {
    const reportId = lockBtn.dataset.reportId;
    const currentlyLocked = lockBtn.dataset.locked === 'true';
    if (!reportId) return;
    const reason = lockReasonInput ? lockReasonInput.value.trim() : '';
    lockBtn.disabled = true;
    lockBtn.textContent = currentlyLocked ? 'Unlocking…' : 'Locking…';
    try {
      const res = await fetch(`/api/report/${reportId}/lock`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          locked: !currentlyLocked,
          reason: !currentlyLocked ? reason : null,
        }),
      });
      if (!res.ok) {
        const err = await res.json().catch(() => ({ error: 'Failed' }));
        alert(err.error || 'Failed');
        window.location.reload();
        return;
      }
      window.location.reload();
    } catch {
      alert('Network error');
      window.location.reload();
    } finally {
      lockBtn.disabled = false;
    }
  });

  // ── In-place Edit Report Toggle ──────────────────────────────────────
  const editToggleBtn = document.getElementById('toggle-edit-report-btn');
  const editPanel = document.getElementById('report-edit-panel');
  const reportViewContent = document.getElementById('report-view-content');
  const cancelEditBtn = document.getElementById('cancel-edit-btn');
  const cancelEditBtnFoot = document.getElementById('cancel-edit-btn-foot');

  function openEdit() {
    if (editPanel) editPanel.style.display = 'block';
    if (reportViewContent) reportViewContent.style.display = 'none';
    editPanel?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    (document.getElementById('edit-title') as HTMLInputElement | null)?.focus();
    editToggleBtn?.classList.add('active');
  }

  function closeEdit() {
    if (editPanel) editPanel.style.display = 'none';
    if (reportViewContent) reportViewContent.style.display = 'block';
    editToggleBtn?.classList.remove('active');
  }

  editToggleBtn?.addEventListener('click', () => {
    if (editPanel?.style.display === 'none') openEdit();
    else closeEdit();
  });
  cancelEditBtn?.addEventListener('click', closeEdit);
  cancelEditBtnFoot?.addEventListener('click', closeEdit);

  // ── Staff Controls Panel Toggle ──────────────────────────────────────
  const staffToggleBtn = document.getElementById('toggle-staff-panel-btn');
  const staffPanel = document.getElementById('staff-controls-panel');
  staffToggleBtn?.addEventListener('click', () => {
    if (!staffPanel) return;
    const isHidden = staffPanel.style.display === 'none';
    staffPanel.style.display = isHidden ? 'block' : 'none';
    staffToggleBtn.classList.toggle('active', isHidden);
  });
</script>

