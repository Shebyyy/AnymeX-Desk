---
import Base from '../layouts/Base.astro';
import ReportRow from '../components/ReportRow.astro';
import { avatarUrl, currentUser } from '../lib/auth';
import { safeReturnTo } from '../lib/redirect';
import { myBacked, myReports, myUpdates, markRead } from '../lib/notify';
import { relativeAge, statusLabel, kindLabel, categoryLabel } from '../lib/format';
import { STATUSES, KINDS, KIND_LABELS, PLATFORMS, PLATFORM_LABELS, CATEGORY_LABELS,
  BUG_CATEGORIES, SUGGESTION_CATEGORIES, EXTENSION_SOURCES, subscriptions, users } from '../lib/db/schema';
import { db } from '../lib/db/client';
import { eq, and } from 'drizzle-orm';

export const prerender = false;

/**
 * Your corner of the board.
 *
 * Shows everything you filed, everything you voted on, and what has changed.
 */

const user = await currentUser(Astro);
if (!user) {
  const rawNext = Astro.url.searchParams.get('next');
  const dest = rawNext ? safeReturnTo(rawNext, Astro.url.origin, '/me') : '/me';
  return Astro.redirect(`/auth/login?next=${encodeURIComponent(dest)}`, 302);
}

let done: string | null = null;
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');

  if (intent === 'subscribe') {
    const kind     = String(form.get('kind') ?? '').trim() || null;
    const category = String(form.get('category') ?? '').trim() || null;
    const platform = String(form.get('platform') ?? '').trim() || null;
    await db().insert(subscriptions).values({ userId: user.id, kind, category, platform });
    return Astro.redirect('/me?subscribed=1', 303);
  }

  if (intent === 'unsubscribe') {
    const subId = Number(form.get('subId') ?? '');
    if (Number.isSafeInteger(subId) && subId > 0) {
      await db().delete(subscriptions).where(and(eq(subscriptions.id, subId), eq(subscriptions.userId, user.id)));
    }
    return Astro.redirect('/me?unsubscribed=1', 303);
  }

  if (intent === 'update_notifications') {
    const notifyTelegram = form.get('notify_telegram') === 'on';
    const notifyDiscord = form.get('notify_discord') === 'on';
    await db()
      .update(users)
      .set({ notifyTelegram, notifyDiscord })
      .where(eq(users.discordId, user.id));
    return Astro.redirect('/me?prefs_saved=1', 303);
  }

  const ids = String(form.get('ids') ?? '')
    .split(',')
    .map(Number)
    .filter((n) => Number.isSafeInteger(n) && n > 0);
  await markRead(user.id, ids);
  return Astro.redirect('/me?read=1', 303);
}

const [updates, filed, backed, [dbUserRow]] = await Promise.all([
  myUpdates(user.id),
  myReports(user.id),
  myBacked(user.id),
  db()
    .select()
    .from(users)
    .where(eq(users.discordId, user.id)),
]);

if (Astro.url.searchParams.has('read')) done = 'Marked as read.';
if (Astro.url.searchParams.has('subscribed')) done = 'Subscription saved.';
const tgParam = Astro.url.searchParams.get('telegram');
if (tgParam === 'linked') done = 'Telegram account linked successfully!';
if (tgParam === 'unlinked') done = 'Telegram account unlinked.';
if (tgParam === 'cannot_unlink_primary') error = 'Cannot unlink Telegram: it is your only login method.';
if (tgParam === 'already_linked_to_other_account') error = 'That Telegram account is already linked to another user.';
if (tgParam?.startsWith('invalid_signature')) error = 'Failed to verify Telegram login signature. Please ensure the Telegram Bot Token in /admin is valid.';
if (tgParam === 'not_configured') error = 'Telegram bot is not configured yet. Please configure it in /admin.';
if (tgParam === 'missing_params') error = 'Telegram authorization was missing required parameters. Please try again.';
if (tgParam === 'failed') error = 'An error occurred while linking Telegram. Please try again.';

const dcParam = Astro.url.searchParams.get('discord');
if (dcParam === 'linked') done = 'Discord account linked successfully!';
if (dcParam === 'unlinked') done = 'Discord account unlinked.';
if (dcParam === 'cannot_unlink_primary') error = 'Cannot unlink Discord: it is your only login method.';
if (dcParam === 'already_linked_to_other_account') error = 'That Discord account is already linked to another user.';
if (dcParam === 'failed') error = 'An error occurred while linking Discord. Please try again.';

if (Astro.url.searchParams.has('prefs_saved')) done = 'Notification preferences updated.';

const isDiscordLinked = !user.id.startsWith('tg:') && dbUserRow?.discordLinked !== false;
const isTelegramLinked = !!dbUserRow?.telegramId;

// Profile avatars for connected services
const discordAvatar = isDiscordLinked && dbUserRow?.avatarHash && !dbUserRow.avatarHash.startsWith('http')
  ? avatarUrl({ id: dbUserRow.discordUserId || dbUserRow.discordId, avatarHash: dbUserRow.avatarHash }, 80)
  : null;

const telegramAvatar = isTelegramLinked ? dbUserRow?.telegramPhotoUrl : null;
const activeAvatar = avatarUrl(user, 64) || discordAvatar || telegramAvatar;

const unread = updates.filter((u) => u.readAt === null);

const WHAT_HAPPENED = {
  status_changed: 'moved to',
  comment: 'got a comment on',
  duplicate: 'was merged into',
  mentioned: 'was mentioned in',
  subscription_match: 'matched subscription on',
} as const;

const mySubs = await db().select().from(subscriptions).where(eq(subscriptions.userId, user.id));

Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<Base title="Your reports" narrow>
  <header class="head">
    <div class="user-profile-header">
      {activeAvatar ? (
        <img class="profile-header-avatar" src={activeAvatar} alt="" width="48" height="48" />
      ) : (
        <div class="profile-header-avatar-blank"></div>
      )}
      <div>
        <h1>Your reports</h1>
        <p class="sub">
          Signed in as <b>{user.username}</b> (<a href={`/user/${user.id}`} style="color: var(--signal-ink); text-decoration: underline;">view public profile</a>).
        </p>
      </div>
    </div>
  </header>

  {done && <p class="flash" role="status">{done}</p>}
  {error && <p class="flash flash-err" role="alert">{error}</p>}

  <section class="block">
    <div class="block-head">
      <h2>Updates</h2>
      {
        unread.length > 0 && (
          <form method="POST">
            <input type="hidden" name="ids" value={unread.map((u) => u.id).join(',')} />
            <button class="btn btn-ghost" type="submit">
              Mark {unread.length} as read
            </button>
          </form>
        )
      }
    </div>
    {
      updates.length === 0 ? (
        <p class="empty-line">
          Nothing yet. When a report you filed or voted on is updated, it turns up here.
        </p>
      ) : (
        <ol class="updates">
          {updates.map((u) => {
            const note = (() => {
              if (u.kind !== 'status_changed' || !u.detail) return null;
              const idx = u.detail.indexOf(':');
              if (idx === -1) return null;
              const prefix = u.detail.slice(0, idx).trim();
              if (!(STATUSES as readonly string[]).includes(prefix)) return null;
              const rest = u.detail.slice(idx + 1).trim();
              return rest || null;
            })();
            return (
            <li class:list={['update', { fresh: u.readAt === null }]}>
              <a href={`/report/${u.reportId}`}>
                <span class="u-what">
                  {u.readAt === null && <b class="u-new">New</b>}
                  <b class="u-src">{u.reportTitle}</b>
                  <span class="u-mid">
                    {WHAT_HAPPENED[u.kind as keyof typeof WHAT_HAPPENED] ?? u.kind} {statusLabel(u.reportStatus)}
                  </span>
                  {note && <span class="u-note"> — {note}</span>}
                </span>
                <span class="u-meta">
                  <span class="u-title">
                    {kindLabel(u.reportKind)} · {categoryLabel(u.reportCategory)}
                  </span>
                  <span>{relativeAge(u.createdAt)} ago</span>
                </span>
              </a>
            </li>
          )})}
        </ol>
      )
    }
  </section>

  <section class="block">
    <h2>You filed</h2>
    {
      filed.length === 0 ? (
        <p class="empty-line">
          You haven't filed anything yet. <a href="/new">File a report</a>.
        </p>
      ) : (
        <ol class="rows">
          {filed.map((r) => (
            <ReportRow report={r as never} mine={true} />
          ))}
        </ol>
      )
    }
  </section>

  <section class="block">
    <h2>You voted on</h2>
    {
      backed.length === 0 ? (
        <p class="empty-line">
          Nothing yet. Tapping the count on any report adds you to it, which is
          what moves it up the board.
        </p>
      ) : (
        <ol class="rows">
          {backed.map((r) => (
            <ReportRow report={r as never} mine={true} />
          ))}
        </ol>
      )
    }
  </section>

  {/* ── Subscriptions ──────────────────────────────────────────────────── */}
  <section class="block">
    <div class="block-head">
      <h2>Subscriptions</h2>
    </div>
    <p class="sub-desc">Get an in-app notification when a new report matches your filter.</p>

    {mySubs.length > 0 && (
      <ul class="sub-list">
        {mySubs.map((s) => (
          <li class="sub-item">
            <span class="sub-tags">
              {s.kind    && <span class="tag">{KIND_LABELS[s.kind] ?? s.kind}</span>}
              {s.category && <span class="tag">{CATEGORY_LABELS[s.category] ?? s.category}</span>}
              {s.platform && <span class="tag">{PLATFORM_LABELS[s.platform] ?? s.platform}</span>}
              {!s.kind && !s.category && !s.platform && <span class="tag tag-all">All reports</span>}
            </span>
            <form method="POST" class="sub-remove">
              <input type="hidden" name="intent" value="unsubscribe" />
              <input type="hidden" name="subId" value={s.id} />
              <button class="btn btn-ghost btn-sm" type="submit" aria-label="Remove subscription">Remove</button>
            </form>
          </li>
        ))}
      </ul>
    )}

    <details class="sub-add-details">
      <summary class="sub-add-summary">+ Add subscription</summary>
      <form method="POST" class="sub-add-form">
        <input type="hidden" name="intent" value="subscribe" />
        <div class="sub-add-row">
          <div class="field">
            <label class="label" for="sub-kind">Type</label>
            <select id="sub-kind" name="kind" class="select">
              <option value="">Any type</option>
              {KINDS.map((k) => <option value={k}>{KIND_LABELS[k]}</option>)}
            </select>
          </div>
          <div class="field">
            <label class="label" for="sub-platform">Platform</label>
            <select id="sub-platform" name="platform" class="select">
              <option value="">Any platform</option>
              {PLATFORMS.map((p) => <option value={p}>{PLATFORM_LABELS[p]}</option>)}
            </select>
          </div>
          <div class="field">
            <label class="label" for="sub-category">Category</label>
            <select id="sub-category" name="category" class="select">
              <option value="">Any category</option>
              {[...BUG_CATEGORIES, ...SUGGESTION_CATEGORIES, ...EXTENSION_SOURCES].map((c) => (
                <option value={c}>{CATEGORY_LABELS[c] ?? c}</option>
              ))}
            </select>
          </div>
          <button class="btn btn-primary sub-add-btn" type="submit">Subscribe</button>
        </div>
      </form>
    </details>
  </section>

  {/* ─── Linked Accounts & Notification Channels ──────────────────── */}
  <section class="block">
    <div class="block-head">
      <h2>Linked Accounts &amp; Notifications</h2>
    </div>
    <div class="accounts-card">
      <div class="account-row">
        <div class="account-info">
          {discordAvatar ? (
            <div class="account-avatar-wrapper">
              <img class="account-avatar-img" src={discordAvatar} alt="" width="38" height="38" />
              <span class="service-badge discord" title="Discord">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                </svg>
              </span>
            </div>
          ) : (
            <div class="account-icon discord">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
              </svg>
            </div>
          )}
          <div>
            <div class="account-name">Discord</div>
            <div class="account-status">
              {isDiscordLinked ? (
                <span>Connected as <b>{dbUserRow?.username || user.username}</b></span>
              ) : (
                <span class="text-muted">Not connected</span>
              )}
            </div>
          </div>
        </div>
        <div class="account-action">
          {isDiscordLinked ? (
            isTelegramLinked && (
              <form method="POST" action="/auth/discord/unlink">
                <button type="submit" class="btn btn-ghost btn-sm">Unlink</button>
              </form>
            )
          ) : (
            <a href="/auth/discord?next=/me" class="btn btn-sm btn-discord">
              Connect Discord
            </a>
          )}
        </div>
      </div>

      <div class="account-row">
        <div class="account-info">
          {telegramAvatar ? (
            <div class="account-avatar-wrapper">
              <img class="account-avatar-img" src={telegramAvatar} alt="" width="38" height="38" />
              <span class="service-badge telegram" title="Telegram">
                <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
                </svg>
              </span>
            </div>
          ) : (
            <div class="account-icon telegram">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
              </svg>
            </div>
          )}
          <div>
            <div class="account-name">Telegram</div>
            <div class="account-status">
              {isTelegramLinked ? (
                <span>Connected as <b>@{dbUserRow?.telegramUsername || dbUserRow?.telegramId}</b></span>
              ) : (
                <span class="text-muted">Not connected</span>
              )}
            </div>
          </div>
        </div>
        <div class="account-action">
          {isTelegramLinked ? (
            isDiscordLinked && (
              <form method="POST" action="/auth/telegram/unlink">
                <button type="submit" class="btn btn-ghost btn-sm">Unlink</button>
              </form>
            )
          ) : (
            <a href="/auth/telegram?next=/me" class="btn btn-sm btn-telegram">
              Connect Telegram
            </a>
          )}
        </div>
      </div>

      <hr class="accounts-divider" />

      <form method="POST" class="notif-prefs-form">
        <input type="hidden" name="intent" value="update_notifications" />
        <h3 class="prefs-subtitle">DM Notification Preferences</h3>
        <p class="prefs-hint">
          Receive direct messages when someone replies to your comment, mentions you, or changes your report's status.
        </p>

        <div class="pref-checkbox-row">
          <label class="pref-checkbox-label">
            <input
              type="checkbox"
              name="notify_discord"
              checked={dbUserRow?.notifyDiscord !== false}
              disabled={!isDiscordLinked}
            />
            <span>Send Discord DMs {!isDiscordLinked && '(Connect Discord above first)'}</span>
          </label>
        </div>

        <div class="pref-checkbox-row">
          <label class="pref-checkbox-label">
            <input
              type="checkbox"
              name="notify_telegram"
              checked={dbUserRow?.notifyTelegram !== false}
              disabled={!isTelegramLinked}
            />
            <span>Send Telegram DMs {!isTelegramLinked && '(Connect Telegram above first)'}</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary btn-sm" style="margin-block-start: var(--space-3);">
          Save Notification Preferences
        </button>
      </form>
    </div>
  </section>

  {/* ─── Display & Appearance Preferences ──────────────────────────── */}
  <section class="block">
    <div class="block-head">
      <h2>Display &amp; Appearance</h2>
    </div>
    <div class="prefs-card">
      <p class="prefs-lede">
        Customize your theme (OLED true black, light mode), accent colors, font size, and density across AnymeX Desk.
      </p>
      <button type="button" class="btn" data-open-prefs style="margin-block-start: var(--space-3);">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="3" />
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
        </svg>
        Customize Appearance
      </button>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block-end: var(--space-4);
    border-block-end: 1px solid var(--border-subtle);
  }
  h1 {
    font-size: var(--text-xl);
    letter-spacing: var(--track-tight);
  }
  .user-profile-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .profile-header-avatar {
    inline-size: 48px;
    block-size: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border-default);
    background: var(--bg-surface-elevated, #24262b);
    flex-shrink: 0;
  }
  .profile-header-avatar-blank {
    inline-size: 48px;
