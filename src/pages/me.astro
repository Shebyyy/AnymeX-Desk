---
import Base from '../layouts/Base.astro';
import { avatarUrl, currentUser } from '../lib/auth';
import { safeReturnTo } from '../lib/redirect';
import { myBacked, myReports, myUpdates, markRead } from '../lib/notify';
import { relativeAge, statusLabel, kindLabel, categoryLabel, platformLabel } from '../lib/format';
import { STATUSES, KINDS, KIND_LABELS, PLATFORMS, PLATFORM_LABELS, CATEGORY_LABELS,
  BUG_CATEGORIES, SUGGESTION_CATEGORIES, EXTENSION_SOURCES, subscriptions, users } from '../lib/db/schema';
import { db } from '../lib/db/client';
import { eq, and } from 'drizzle-orm';
import { LEVEL_LABELS } from '../lib/levels';

export const prerender = false;

/**
 * Your personal hub on AnymeX Desk.
 *
 * Tabbed dashboard showing updates/notifications, filed reports,
 * upvoted reports, subscriptions, and account preferences.
 */

const user = await currentUser(Astro);
if (!user) {
  const rawNext = Astro.url.searchParams.get('next');
  const dest = rawNext ? safeReturnTo(rawNext, Astro.url.origin, '/me') : '/me';
  return Astro.redirect(`/auth/login?next=${encodeURIComponent(dest)}`, 302);
}

let done: string | null = null;
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');

  if (intent === 'subscribe') {
    const kind     = String(form.get('kind') ?? '').trim() || null;
    const category = String(form.get('category') ?? '').trim() || null;
    const platform = String(form.get('platform') ?? '').trim() || null;
    await db().insert(subscriptions).values({ userId: user.id, kind, category, platform });
    return Astro.redirect('/me?subscribed=1#subscriptions', 303);
  }

  if (intent === 'unsubscribe') {
    const subId = Number(form.get('subId') ?? '');
    if (Number.isSafeInteger(subId) && subId > 0) {
      await db().delete(subscriptions).where(and(eq(subscriptions.id, subId), eq(subscriptions.userId, user.id)));
    }
    return Astro.redirect('/me?unsubscribed=1#subscriptions', 303);
  }

  if (intent === 'update_notifications') {
    const notifyTelegram = form.get('notify_telegram') === 'on';
    const notifyDiscord = form.get('notify_discord') === 'on';
    await db()
      .update(users)
      .set({ notifyTelegram, notifyDiscord })
      .where(eq(users.discordId, user.id));
    return Astro.redirect('/me?prefs_saved=1#account', 303);
  }

  const ids = String(form.get('ids') ?? '')
    .split(',')
    .map(Number)
    .filter((n) => Number.isSafeInteger(n) && n > 0);
  await markRead(user.id, ids);
  return Astro.redirect('/me?read=1#notifications', 303);
}

const [updates, filed, backed, [dbUserRow]] = await Promise.all([
  myUpdates(user.id),
  myReports(user.id),
  myBacked(user.id),
  db()
    .select()
    .from(users)
    .where(eq(users.discordId, user.id)),
]);

if (Astro.url.searchParams.has('read')) done = 'All notifications marked as read.';
if (Astro.url.searchParams.has('subscribed')) done = 'Subscription added successfully.';
if (Astro.url.searchParams.has('unsubscribed')) done = 'Subscription removed.';
const tgParam = Astro.url.searchParams.get('telegram');
if (tgParam === 'linked') done = 'Telegram account linked successfully!';
if (tgParam === 'unlinked') done = 'Telegram account unlinked.';
if (tgParam === 'cannot_unlink_primary') error = 'Cannot unlink Telegram: it is your only login method.';
if (tgParam === 'already_linked_to_other_account') error = 'That Telegram account is already linked to another user.';
if (tgParam?.startsWith('invalid_signature')) error = 'Failed to verify Telegram login signature.';
if (tgParam === 'not_configured') error = 'Telegram bot is not configured yet. Please configure it in /admin.';
if (tgParam === 'missing_params') error = 'Telegram authorization was missing required parameters.';
if (tgParam === 'failed') error = 'An error occurred while linking Telegram.';

const dcParam = Astro.url.searchParams.get('discord');
if (dcParam === 'linked') done = 'Discord account linked successfully!';
if (dcParam === 'unlinked') done = 'Discord account unlinked.';
if (dcParam === 'cannot_unlink_primary') error = 'Cannot unlink Discord: it is your only login method.';
if (dcParam === 'already_linked_to_other_account') error = 'That Discord account is already linked to another user.';
if (dcParam === 'failed') error = 'An error occurred while linking Discord.';

if (Astro.url.searchParams.has('prefs_saved')) done = 'Notification preferences updated.';

const isDiscordLinked = !user.id.startsWith('tg:') && dbUserRow?.discordLinked !== false;
const isTelegramLinked = !!dbUserRow?.telegramId;

// Profile avatars for connected services
const discordAvatar = isDiscordLinked && dbUserRow?.avatarHash && !dbUserRow.avatarHash.startsWith('http')
  ? avatarUrl({ id: dbUserRow.discordUserId || dbUserRow.discordId, avatarHash: dbUserRow.avatarHash }, 80)
  : null;

const telegramAvatar = isTelegramLinked ? dbUserRow?.telegramPhotoUrl : null;
const activeAvatar = avatarUrl(user, 80) || discordAvatar || telegramAvatar;
const initial = (user.username || '?')[0].toUpperCase();

const unread = updates.filter((u) => u.readAt === null);

const WHAT_HAPPENED = {
  status_changed: 'status moved to',
  comment: 'new comment on',
  duplicate: 'merged into',
  mentioned: 'mentioned in',
  subscription_match: 'matched alert on',
} as const;

const mySubs = await db().select().from(subscriptions).where(eq(subscriptions.userId, user.id));

// Breakdown counts for filter chips
const bugReportsCount = filed.filter((r) => r.kind === 'bug').length;
const suggestionReportsCount = filed.filter((r) => r.kind === 'suggestion').length;
const extensionReportsCount = filed.filter((r) => r.kind === 'extension').length;

Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<Base title="Your Reports & Activity">
  <!-- Contributor Hero Profile Card -->
  <header class="me-hero">
    <div class="me-hero-glow" aria-hidden="true"></div>
    <div class="me-hero-body">
      <div class="me-avatar-wrap">
        {activeAvatar ? (
          <img class="me-avatar" src={activeAvatar} alt={user.username} width="72" height="72" />
        ) : (
          <div class="me-avatar me-avatar-fallback">{initial}</div>
        )}
      </div>

      <div class="me-hero-info">
        <div class="me-title-row">
          <h1 class="me-username">{user.username}</h1>
          <span class={`staff-pill staff-${user.level}`}>
            {LEVEL_LABELS[user.level] || 'Contributor'}
          </span>
        </div>

        <div class="me-meta-row">
          {isDiscordLinked && (
            <span class="me-service-chip discord">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
              </svg>
              <span>Discord Connected</span>
            </span>
          )}
          {isTelegramLinked && (
            <span class="me-service-chip telegram">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
              </svg>
              <span>Telegram Connected</span>
            </span>
          )}
          <a href={`/user/${user.id}`} class="btn btn-ghost btn-sm me-public-profile-btn">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
            <span>Public Profile</span>
          </a>
        </div>
      </div>

      <!-- Quick KPI Counters -->
      <div class="me-kpi-bar">
        <div class="me-kpi-item">
          <span class="me-kpi-val num">{filed.length}</span>
          <span class="me-kpi-lbl">Filed</span>
        </div>
        <div class="me-kpi-item">
          <span class="me-kpi-val num">{backed.length}</span>
          <span class="me-kpi-lbl">Upvoted</span>
        </div>
        <div class="me-kpi-item">
          <span class="me-kpi-val num">{mySubs.length}</span>
          <span class="me-kpi-lbl">Alerts</span>
        </div>
        <div class="me-kpi-item">
          <span class:list={['me-kpi-val', 'num', { 'has-unread': unread.length > 0 }]}>
            {unread.length}
          </span>
          <span class="me-kpi-lbl">Unread</span>
        </div>
      </div>
    </div>
  </header>

  {done && <p class="flash" role="status">{done}</p>}
  {error && <p class="flash flash-err" role="alert">{error}</p>}

  <!-- Tab Navigation Bar -->
  <nav class="me-tabs-nav" aria-label="Personal dashboard sections">
    <button type="button" class="me-tab-btn active" data-me-tab="notifications" role="tab" aria-selected="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
      </svg>
      <span>Activity &amp; Updates</span>
      {unread.length > 0 ? (
        <span class="tab-badge warn">{unread.length}</span>
      ) : (
        <span class="tab-badge">{updates.length}</span>
      )}
    </button>

    <button type="button" class="me-tab-btn" data-me-tab="reports" role="tab" aria-selected="false">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
        <polyline points="14 2 14 8 20 8" />
      </svg>
      <span>My Reports</span>
      <span class="tab-badge">{filed.length}</span>
    </button>

    <button type="button" class="me-tab-btn" data-me-tab="upvoted" role="tab" aria-selected="false">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 19V5" />
        <polyline points="5 12 12 5 19 12" />
      </svg>
      <span>Upvoted</span>
      <span class="tab-badge">{backed.length}</span>
    </button>

    <button type="button" class="me-tab-btn" data-me-tab="subscriptions" role="tab" aria-selected="false">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 11a9 9 0 0 1 9 9" />
        <path d="M4 4a16 16 0 0 1 16 16" />
        <circle cx="5" cy="19" r="1" />
      </svg>
      <span>Subscriptions</span>
      <span class="tab-badge">{mySubs.length}</span>
    </button>

    <button type="button" class="me-tab-btn" data-me-tab="account" role="tab" aria-selected="false">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3" />
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
      </svg>
      <span>Account &amp; Settings</span>
    </button>
  </nav>

  <!-- TAB 1: NOTIFICATIONS & ACTIVITY -->
  <div class="me-tab-pane active" id="pane-notifications" data-me-pane="notifications">
    <section class="panel">
      <div class="panel-header-with-action">
        <div>
          <h2>Notifications &amp; Activity</h2>
          <p class="panel-sub">Recent status changes, developer replies, and mentions on reports you follow.</p>
        </div>
        {unread.length > 0 && (
          <form method="POST">
            <input type="hidden" name="ids" value={unread.map((u) => u.id).join(',')} />
            <button class="btn btn-ghost btn-sm" type="submit">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span>Mark all ({unread.length}) as read</span>
            </button>
          </form>
        )}
      </div>

      {updates.length === 0 ? (
        <div class="me-empty-card">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
          </svg>
          <h3>You're completely caught up!</h3>
          <p>When a report you filed, upvoted, or subscribed to is updated, notifications will appear here.</p>
        </div>
      ) : (
        <ol class="updates-feed">
          {updates.map((u) => {
            const note = (() => {
              if (u.kind !== 'status_changed' || !u.detail) return null;
              const idx = u.detail.indexOf(':');
              if (idx === -1) return null;
              const prefix = u.detail.slice(0, idx).trim();
              if (!(STATUSES as readonly string[]).includes(prefix)) return null;
              const rest = u.detail.slice(idx + 1).trim();
              return rest || null;
            })();

            return (
              <li class:list={['update-row', { 'is-unread': u.readAt === null }]}>
                <a href={`/report/${u.reportId}`} class="update-link">
                  <div class="update-indicator-col">
                    {u.readAt === null ? (
                      <span class="unread-dot" title="Unread notification" />
                    ) : (
                      <span class="read-dot" />
                    )}
                  </div>

                  <div class="update-content">
                    <div class="update-title-line">
                      <span class="update-report-title">{u.reportTitle}</span>
                      <span class="update-action">
                        {WHAT_HAPPENED[u.kind as keyof typeof WHAT_HAPPENED] ?? u.kind}
                      </span>
                      <span class={`status-badge status-${u.reportStatus}`}>
                        {statusLabel(u.reportStatus)}
                      </span>
                    </div>

                    {note && <p class="update-note">💬 {note}</p>}

                    <div class="update-meta-line">
                      <span class="update-tag">{kindLabel(u.reportKind)}</span>
                      <span class="update-tag">{categoryLabel(u.reportCategory)}</span>
                      <span class="update-time">{relativeAge(u.createdAt)} ago</span>
                    </div>
                  </div>
                </a>
              </li>
            );
          })}
        </ol>
      )}
    </section>
  </div>

  <!-- TAB 2: MY REPORTS -->
  <div class="me-tab-pane" id="pane-reports" data-me-pane="reports" hidden>
    <section class="panel">
      <div class="panel-header-with-action">
        <div>
          <h2>Reports You Filed</h2>
          <p class="panel-sub">All bug reports, feature suggestions, and extension issues you have submitted.</p>
        </div>
        <a href="/new" class="btn btn-primary btn-sm">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
          </svg>
          <span>File New Report</span>
        </a>
      </div>

      <!-- Filter & Search Toolbar -->
      <div class="me-toolbar">
        <div class="me-kind-filters" role="group" aria-label="Filter your reports by kind">
          <button type="button" class="chip active" data-filed-filter="all">
            All ({filed.length})
          </button>
          <button type="button" class="chip" data-filed-filter="bug">
            Bugs ({bugReportsCount})
          </button>
          <button type="button" class="chip" data-filed-filter="suggestion">
            Suggestions ({suggestionReportsCount})
          </button>
          <button type="button" class="chip" data-filed-filter="extension">
            Extensions ({extensionReportsCount})
          </button>
        </div>

        <div class="me-search-box">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input
            type="search"
            class="me-search-input"
            id="filed-search-input"
            placeholder="Filter your reports..."
            autocomplete="off"
          />
        </div>
      </div>

      {filed.length === 0 ? (
        <div class="me-empty-card">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
          </svg>
          <h3>You haven't filed any reports yet</h3>
          <p>Notice an issue or have an idea to improve AnymeX? Submit your feedback directly to the team.</p>
          <a href="/new" class="btn btn-primary" style="margin-block-start: var(--space-3);">File a Report</a>
        </div>
      ) : (
        <>
          <p class="empty-line" id="filed-empty-search" hidden style="display: none; padding: var(--space-4); text-align: center;">
            No filed reports match the current filter or search criteria.
          </p>
          <ul class="me-reports-grid" id="filed-reports-grid">
            {filed.map((r) => (
              <li
                class="me-report-card"
                data-kind={r.kind}
                data-search={`${r.title} ${r.category} ${r.platform} ${r.status}`.toLowerCase()}
              >
                <div class="me-report-main">
                  <div class="me-report-header">
                    <span class={`kind-tag kind-${r.kind}`}>{kindLabel(r.kind)}</span>
                    <a href={`/report/${r.id}`} class="me-report-title">
                      <span class="report-num">#{r.id}</span> {r.title}
                    </a>
                  </div>
                  <div class="me-report-meta">
                    <span class="tag-meta">{categoryLabel(r.category)}</span>
                    <span class="tag-meta">{platformLabel(r.platform)}</span>
                    <span class={`status-badge status-${r.status}`}>{statusLabel(r.status)}</span>
                    <span class="me-time">Filed {relativeAge(r.createdAt)} ago</span>
                    {r.commentCount > 0 && (
                      <span class="me-comment-chip">💬 {r.commentCount}</span>
                    )}
                  </div>
                </div>
                <div class="me-vote-box" title={`${r.votes} upvotes`}>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 4l-8 8h6v8h4v-8h6z" />
                  </svg>
                  <span class="num">{r.votes}</span>
                </div>
              </li>
            ))}
          </ul>
        </>
      )}
    </section>
  </div>

  <!-- TAB 3: UPVOTED REPORTS -->
  <div class="me-tab-pane" id="pane-upvoted" data-me-pane="upvoted" hidden>
    <section class="panel">
      <div class="panel-header-with-action">
        <div>
          <h2>Reports You Upvoted</h2>
          <p class="panel-sub">Community reports you have backed to help developers prioritize fixes and features.</p>
        </div>
        <a href="/" class="btn btn-ghost btn-sm">
          <span>Explore Public Boards</span>
        </a>
      </div>

      <div class="me-toolbar">
        <div class="me-search-box" style="inline-size: 100%; max-inline-size: 380px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8" />
