<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Tab Navigation
    const tabBtns = document.querySelectorAll('[data-me-tab]');
    const tabPanes = document.querySelectorAll('[data-me-pane]');

    function switchTab(tabId) {
      let matched = false;
      tabPanes.forEach(pane => {
        const isMatch = pane.getAttribute('data-me-pane') === tabId;
        pane.classList.toggle('active', isMatch);
        pane.hidden = !isMatch;
        if (isMatch) matched = true;
      });

      if (!matched && tabPanes.length > 0) {
        tabPanes[0].classList.add('active');
        tabPanes[0].hidden = false;
        tabId = tabPanes[0].getAttribute('data-me-pane');
      }

      tabBtns.forEach(btn => {
        const isMatch = btn.getAttribute('data-me-tab') === tabId;
        btn.classList.toggle('active', isMatch);
        btn.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      try {
        if (history.replaceState) {
          history.replaceState(null, '', `#${tabId}`);
        }
      } catch (e) {}
    }

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-me-tab');
        if (target) switchTab(target);
      });
    });

    // Check URL hash on load
    const currentHash = (window.location.hash || '').replace('#', '');
    if (currentHash && ['notifications', 'reports', 'upvoted', 'subscriptions', 'account'].includes(currentHash)) {
      switchTab(currentHash);
    }

    // 2. Filter & Search My Reports
    const filedSearchInput = document.getElementById('filed-search-input');
    const filedKindChips = document.querySelectorAll('[data-filed-filter]');
    const filedCards = document.querySelectorAll('#filed-reports-grid .me-report-card');
    const filedEmptySearch = document.getElementById('filed-empty-search');
    let currentFiledKind = 'all';

    function applyFiledFilters() {
      const q = (filedSearchInput && filedSearchInput.value ? filedSearchInput.value : '').trim().toLowerCase();
      let visible = 0;

      filedCards.forEach(card => {
        const kind = card.getAttribute('data-kind');
        const text = card.getAttribute('data-search') || '';

        const matchKind = currentFiledKind === 'all' || kind === currentFiledKind;
        const matchSearch = !q || text.includes(q);
        const isVisible = matchKind && matchSearch;

        card.hidden = !isVisible;
        card.style.display = isVisible ? '' : 'none';
        if (isVisible) visible++;
      });

      if (filedEmptySearch) {
        filedEmptySearch.hidden = visible > 0;
        filedEmptySearch.style.display = visible > 0 ? 'none' : 'block';
      }
    }

    if (filedSearchInput) {
      filedSearchInput.addEventListener('input', applyFiledFilters);
    }

    filedKindChips.forEach(chip => {
      chip.addEventListener('click', () => {
        filedKindChips.forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        currentFiledKind = chip.getAttribute('data-filed-filter') || 'all';
        applyFiledFilters();
      });
    });

    // 3. Search Upvoted Reports
    const backedSearchInput = document.getElementById('backed-search-input');
    const backedCards = document.querySelectorAll('#backed-reports-grid .me-report-card');
    const backedEmptySearch = document.getElementById('backed-empty-search');

    function applyBackedFilters() {
      const q = (backedSearchInput && backedSearchInput.value ? backedSearchInput.value : '').trim().toLowerCase();
      let visible = 0;

      backedCards.forEach(card => {
        const text = card.getAttribute('data-search') || '';
        const match = !q || text.includes(q);

        card.hidden = !match;
        card.style.display = match ? '' : 'none';
        if (match) visible++;
      });

      if (backedEmptySearch) {
        backedEmptySearch.hidden = visible > 0;
        backedEmptySearch.style.display = visible > 0 ? 'none' : 'block';
      }
    }

    if (backedSearchInput) {
      backedSearchInput.addEventListener('input', applyBackedFilters);
    }

    // 4. Subscriptions Drawer Toggle
    const toggleAddSubBtn = document.getElementById('toggle-add-sub-btn');
    const closeAddSubBtn = document.getElementById('close-add-sub-btn');
    const addSubDrawer = document.getElementById('add-sub-drawer');
    const subKindSelect = document.getElementById('sub-kind');

    function toggleSubDrawer(show) {
      if (!addSubDrawer || !toggleAddSubBtn) return;
      const isShowing = show !== undefined ? show : addSubDrawer.hidden;
      addSubDrawer.hidden = !isShowing;
      toggleAddSubBtn.classList.toggle('is-open', isShowing);
      toggleAddSubBtn.setAttribute('aria-expanded', isShowing ? 'true' : 'false');
      if (isShowing && subKindSelect) {
        subKindSelect.focus();
      }
    }

    if (toggleAddSubBtn) toggleAddSubBtn.addEventListener('click', () => toggleSubDrawer());
    if (closeAddSubBtn) closeAddSubBtn.addEventListener('click', () => toggleSubDrawer(false));
  });
</script>

