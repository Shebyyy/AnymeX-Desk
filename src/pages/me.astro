---
import Base from '../layouts/Base.astro';
import ReportRow from '../components/ReportRow.astro';
import { currentUser } from '../lib/auth';
import { safeReturnTo } from '../lib/redirect';
import { myBacked, myReports, myUpdates, markRead } from '../lib/notify';
import { relativeAge, statusLabel, kindLabel, categoryLabel } from '../lib/format';
import { STATUSES, KINDS, KIND_LABELS, PLATFORMS, PLATFORM_LABELS, CATEGORY_LABELS,
  BUG_CATEGORIES, SUGGESTION_CATEGORIES, EXTENSION_SOURCES, subscriptions } from '../lib/db/schema';
import { db } from '../lib/db/client';
import { eq, and } from 'drizzle-orm';

export const prerender = false;

/**
 * Your corner of the board.
 *
 * Shows everything you filed, everything you voted on, and what has changed.
 */

const user = await currentUser(Astro);
if (!user) {
  const rawNext = Astro.url.searchParams.get('next');
  const dest = rawNext ? safeReturnTo(rawNext, Astro.url.origin, '/me') : '/me';
  return Astro.redirect(`/auth/discord?next=${encodeURIComponent(dest)}`, 302);
}

let done: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');

  if (intent === 'subscribe') {
    const kind     = String(form.get('kind') ?? '').trim() || null;
    const category = String(form.get('category') ?? '').trim() || null;
    const platform = String(form.get('platform') ?? '').trim() || null;
    await db().insert(subscriptions).values({ userId: user.id, kind, category, platform });
    return Astro.redirect('/me?subscribed=1', 303);
  }

  if (intent === 'unsubscribe') {
    const subId = Number(form.get('subId') ?? '');
    if (Number.isSafeInteger(subId) && subId > 0) {
      await db().delete(subscriptions).where(and(eq(subscriptions.id, subId), eq(subscriptions.userId, user.id)));
    }
    return Astro.redirect('/me?unsubscribed=1', 303);
  }

  const ids = String(form.get('ids') ?? '')
    .split(',')
    .map(Number)
    .filter((n) => Number.isSafeInteger(n) && n > 0);
  await markRead(user.id, ids);
  return Astro.redirect('/me?read=1', 303);
}

const [updates, filed, backed] = await Promise.all([
  myUpdates(user.id),
  myReports(user.id),
  myBacked(user.id),
]);

if (Astro.url.searchParams.has('read')) done = 'Marked as read.';
if (Astro.url.searchParams.has('subscribed')) done = 'Subscription saved.';
if (Astro.url.searchParams.has('unsubscribed')) done = 'Subscription removed.';

const unread = updates.filter((u) => u.readAt === null);

const WHAT_HAPPENED = {
  status_changed: 'moved to',
  comment: 'got a comment on',
  duplicate: 'was merged into',
  mentioned: 'was mentioned in',
  subscription_match: 'matched subscription on',
} as const;

const mySubs = await db().select().from(subscriptions).where(eq(subscriptions.userId, user.id));

Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<Base title="Your reports" narrow>
  <header class="head">
    <h1>Your reports</h1>
    <p class="sub">
      Signed in as <b>{user.username}</b> (<a href={`/user/${user.id}`} style="color: var(--signal-ink); text-decoration: underline;">view your public profile</a>). Everything you've filed and everything
      you've voted on, plus what has changed since.
    </p>
  </header>

  {done && <p class="flash" role="status">{done}</p>}

  <section class="block">
    <div class="block-head">
      <h2>Updates</h2>
      {
        unread.length > 0 && (
          <form method="POST">
            <input type="hidden" name="ids" value={unread.map((u) => u.id).join(',')} />
            <button class="btn btn-ghost" type="submit">
              Mark {unread.length} as read
            </button>
          </form>
        )
      }
    </div>
    {
      updates.length === 0 ? (
        <p class="empty-line">
          Nothing yet. When a report you filed or voted on is updated, it turns up here.
        </p>
      ) : (
        <ol class="updates">
          {updates.map((u) => {
            const note = (() => {
              if (u.kind !== 'status_changed' || !u.detail) return null;
              const idx = u.detail.indexOf(':');
              if (idx === -1) return null;
              const prefix = u.detail.slice(0, idx).trim();
              if (!(STATUSES as readonly string[]).includes(prefix)) return null;
              const rest = u.detail.slice(idx + 1).trim();
              return rest || null;
            })();
            return (
            <li class:list={['update', { fresh: u.readAt === null }]}>
              <a href={`/report/${u.reportId}`}>
                <span class="u-what">
                  {u.readAt === null && <b class="u-new">New</b>}
                  <b class="u-src">{u.reportTitle}</b>
                  <span class="u-mid">
                    {WHAT_HAPPENED[u.kind as keyof typeof WHAT_HAPPENED] ?? u.kind} {statusLabel(u.reportStatus)}
                  </span>
                  {note && <span class="u-note"> — {note}</span>}
                </span>
                <span class="u-meta">
                  <span class="u-title">
                    {kindLabel(u.reportKind)} · {categoryLabel(u.reportCategory)}
                  </span>
                  <span>{relativeAge(u.createdAt)} ago</span>
                </span>
              </a>
            </li>
          )})}
        </ol>
      )
    }
  </section>

  <section class="block">
    <h2>You filed</h2>
    {
      filed.length === 0 ? (
        <p class="empty-line">
          You haven't filed anything yet. <a href="/new">File a report</a>.
        </p>
      ) : (
        <ol class="rows">
          {filed.map((r) => (
            <ReportRow report={r as never} mine={true} />
          ))}
        </ol>
      )
    }
  </section>

  <section class="block">
    <h2>You voted on</h2>
    {
      backed.length === 0 ? (
        <p class="empty-line">
          Nothing yet. Tapping the count on any report adds you to it, which is
          what moves it up the board.
        </p>
      ) : (
        <ol class="rows">
          {backed.map((r) => (
            <ReportRow report={r as never} mine={true} />
          ))}
        </ol>
      )
    }
  </section>

  {/* ── Subscriptions ──────────────────────────────────────────────────── */}
  <section class="block">
    <div class="block-head">
      <h2>Subscriptions</h2>
    </div>
    <p class="sub-desc">Get an in-app notification when a new report matches your filter.</p>

    {mySubs.length > 0 && (
      <ul class="sub-list">
        {mySubs.map((s) => (
          <li class="sub-item">
            <span class="sub-tags">
              {s.kind    && <span class="tag">{KIND_LABELS[s.kind] ?? s.kind}</span>}
              {s.category && <span class="tag">{CATEGORY_LABELS[s.category] ?? s.category}</span>}
              {s.platform && <span class="tag">{PLATFORM_LABELS[s.platform] ?? s.platform}</span>}
              {!s.kind && !s.category && !s.platform && <span class="tag tag-all">All reports</span>}
            </span>
            <form method="POST" class="sub-remove">
              <input type="hidden" name="intent" value="unsubscribe" />
              <input type="hidden" name="subId" value={s.id} />
              <button class="btn btn-ghost btn-sm" type="submit" aria-label="Remove subscription">Remove</button>
            </form>
          </li>
        ))}
      </ul>
    )}

    <details class="sub-add-details">
      <summary class="sub-add-summary">+ Add subscription</summary>
      <form method="POST" class="sub-add-form">
        <input type="hidden" name="intent" value="subscribe" />
        <div class="sub-add-row">
          <div class="field">
            <label class="label" for="sub-kind">Type</label>
            <select id="sub-kind" name="kind" class="select">
              <option value="">Any type</option>
              {KINDS.map((k) => <option value={k}>{KIND_LABELS[k]}</option>)}
            </select>
          </div>
          <div class="field">
            <label class="label" for="sub-platform">Platform</label>
            <select id="sub-platform" name="platform" class="select">
              <option value="">Any platform</option>
              {PLATFORMS.map((p) => <option value={p}>{PLATFORM_LABELS[p]}</option>)}
            </select>
          </div>
          <div class="field">
            <label class="label" for="sub-category">Category</label>
            <select id="sub-category" name="category" class="select">
              <option value="">Any category</option>
              {[...BUG_CATEGORIES, ...SUGGESTION_CATEGORIES, ...EXTENSION_SOURCES].map((c) => (
                <option value={c}>{CATEGORY_LABELS[c] ?? c}</option>
              ))}
            </select>
          </div>
          <button class="btn btn-primary sub-add-btn" type="submit">Subscribe</button>
        </div>
      </form>
    </details>
  </section>

  {/* ─── Display & Appearance Preferences ──────────────────────────── */}
  <section class="block">
    <div class="block-head">
      <h2>Display &amp; Appearance</h2>
    </div>
    <div class="prefs-card">
      <p class="prefs-lede">
        Customize your theme (OLED true black, light mode), accent colors, font size, and density across AnymeX Desk.
      </p>
      <button type="button" class="btn" data-open-prefs style="margin-block-start: var(--space-3);">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="3" />
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
        </svg>
        Customize Appearance
      </button>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block-end: var(--space-4);
    border-block-end: 1px solid var(--border-subtle);
  }
  h1 {
    font-size: var(--text-xl);
    letter-spacing: var(--track-tight);
  }
  .sub {
    max-inline-size: 62ch;
    margin-block-start: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }
  .flash {
    padding: var(--space-3);
    margin-block-start: var(--space-4);
    border: 1px solid var(--border-default);
    border-inline-start: 2px solid var(--signal);
    border-radius: var(--radius-md);
    background: var(--signal-fill);
    font-size: var(--text-sm);
  }

  .block {
    margin-block-start: var(--space-8);
  }
  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  h2 {
    font-size: var(--text-lg);
    letter-spacing: var(--track-tight);
    margin-block-end: var(--space-2);
  }

  .updates {
    display: grid;
    gap: var(--space-px);
  }
  .update a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
  }
  .update a:hover { border-color: var(--border-strong); }
  .fresh a { border-inline-start: 2px solid var(--signal); }
  .u-new {
    margin-inline-end: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--signal-ink);
  }
  .u-src { font-weight: var(--weight-semi); }
  .u-mid {
    margin-inline-start: var(--space-1);
    color: var(--text-secondary);
  }
  .u-note { color: var(--text-tertiary); font-style: italic; }
  .u-meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    min-inline-size: 0;
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }
  .u-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-inline-size: 28ch;
  }

  .foot-note {
    margin-block-start: var(--space-8);
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }
  .foot-note a,
  .empty-line a {
    color: var(--signal-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .u-title { max-inline-size: 100%; white-space: normal; }
    .u-meta { flex-basis: 100%; }
  }

  /* ── Subscriptions ── */
  .sub-desc {
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    margin-block-end: var(--space-3);
  }
  .sub-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-block-end: var(--space-3);
  }
  .sub-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
  }
  .sub-tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    align-items: center;
  }
  .tag {
    padding-inline: var(--space-1);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }
  .tag-all { border-color: var(--signal); color: var(--signal-ink); }
  .sub-remove { flex: none; }

  .sub-add-details {
    margin-block-start: var(--space-3);
  }
  .sub-add-summary {
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    user-select: none;
    list-style: none;
  }
  .sub-add-summary::-webkit-details-marker { display: none; }
  .sub-add-summary:hover { color: var(--text-primary); }

  .sub-add-form { margin-block-start: var(--space-3); }
  .sub-add-row {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    align-items: flex-end;
  }
  .sub-add-row .field { flex: 1; min-inline-size: 8rem; }
  .sub-add-btn { flex: none; }
  .btn-sm { font-size: var(--text-xs); padding: 4px 10px; }

  .prefs-card {
    padding: var(--space-4);
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }
  .prefs-lede {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
</style>
