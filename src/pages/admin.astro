---
import Base from '../layouts/Base.astro';
import { desc, eq, isNotNull, or } from 'drizzle-orm';
import { db } from '../lib/db/client';
import { audit, labels, STAFF_LEVELS, users, type StaffLevel } from '../lib/db/schema';
import { snowflakeCreatedAt } from '../lib/auth';
import { LEVEL_LABELS, combine } from '../lib/levels';
import { idList, readConfig, writeSettings } from '../lib/settings';
import { isOwner, isResponse, logAction, requireStaff, setManualLevel } from '../lib/staff';
import { testWebhook } from '../lib/webhook';
import { ensureForumTags, syncExistingReports } from '../lib/discord-forums';
import { relativeAge } from '../lib/format';

export const prerender = false;

/**
 * The dashboard.
 *
 * Admin-only, and every action is re-authorised against D1 rather than the
 * session — see lib/staff.ts.
 */
const gate = await requireStaff(Astro, 'admin');
if (isResponse(gate)) return gate;
const { user, level } = gate;

let error: string | null = null;
let done: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  const origin = Astro.url.origin;

  if (intent === 'roles') {
    const mod = idList(String(form.get('mod_role_ids') ?? '')).join(',');
    const admin = idList(String(form.get('admin_role_ids') ?? '')).join(',');
    await writeSettings({ mod_role_ids: mod, admin_role_ids: admin }, user.id);
    await logAction(user, 'settings.roles', null, `mod=[${mod}] admin=[${admin}]`);
    done = 'Role mapping saved. It applies to each person the next time they sign in.';
  } else if (intent === 'gate') {
    const days = Math.max(0, Math.min(3650, Number(form.get('min_account_age_days') ?? 30)));
    await writeSettings({ min_account_age_days: String(days) }, user.id);
    await logAction(user, 'settings.gate', null, `min_account_age_days=${days}`);
    done = `Accounts must now be ${days} days old to post or vote.`;
  } else if (intent === 'webhook') {
    const raw = String(form.get('webhook_url') ?? '').trim();
    const onFixed = form.get('webhook_on_fixed') === '1' ? '1' : '0';
    const onNewReport = form.get('webhook_on_new_report') === '1' ? '1' : '0';
    const threshold = Math.max(0, Math.min(9999, Number(form.get('webhook_vote_threshold') ?? 0)));
    const patch: Record<string, string> = {
      webhook_on_fixed: onFixed,
      webhook_on_new_report: onNewReport,
      webhook_vote_threshold: String(threshold),
    };
    if (raw === '__clear__') {
      patch.webhook_url = '';
    } else if (raw) {
      if (!/^https:\/\/(discord\.com|discordapp\.com)\/api\/webhooks\//.test(raw)) {
        error = 'That is not a Discord webhook URL. Copy it from Channel → Edit Channel → Integrations → Webhooks.';
      } else {
        patch.webhook_url = raw;
      }
    }
    if (!error) {
      await writeSettings(patch, user.id);
      await logAction(user, 'settings.webhook', null,
        `${patch.webhook_url === '' ? 'cleared' : raw ? 'replaced' : 'unchanged'}, on_fixed=${onFixed}, on_new_report=${onNewReport}, threshold=${threshold}`);
      done = 'Announcement settings saved.';
    }
  } else if (intent === 'webhook-test') {
    const cfg = await readConfig();
    if (!cfg.webhook_url) {
      error = 'Save a webhook URL first.';
    } else {
      const res = await testWebhook(cfg.webhook_url, origin, user.username);
      done = res.ok ? 'Test message sent. Check the channel.' : null;
      error = res.ok ? null : `Discord rejected it (${res.status}). ${res.body.slice(0, 200)}`;
    }
  } else if (intent === 'dm') {
    const dmEnabled = form.get('discord_dm_enabled') === '1' ? '1' : '0';
    const botToken = String(form.get('discord_bot_token') ?? '').trim();
    const patch: Record<string, string> = { discord_dm_enabled: dmEnabled };
    if (botToken && botToken !== '••••••••') {
      patch.discord_bot_token = botToken;
    }
    await writeSettings(patch, user.id);
    await logAction(user, 'settings.dm', null, `enabled=${dmEnabled}, token=${botToken ? 'changed' : 'unchanged'}`);
    done = 'DM notification settings saved.';
  } else if (intent === 'contributor-forums') {
    const syncEnabled = form.get('discord_forum_sync_enabled') === '1' ? '1' : '0';
    const guildId = String(form.get('contributor_guild_id') ?? '').trim();
    const bugsId = String(form.get('discord_forum_bugs_id') ?? '').trim();
    const suggestionsId = String(form.get('discord_forum_suggestions_id') ?? '').trim();
    const extensionsId = String(form.get('discord_forum_extensions_id') ?? '').trim();
    const syncSecret = String(form.get('discord_sync_secret') ?? '').trim();

    const patch: Record<string, string> = {
      discord_forum_sync_enabled: syncEnabled,
      contributor_guild_id: guildId,
      discord_forum_bugs_id: bugsId,
      discord_forum_suggestions_id: suggestionsId,
      discord_forum_extensions_id: extensionsId,
      discord_sync_secret: syncSecret,
    };
    await writeSettings(patch, user.id);
    await logAction(user, 'settings.forums', null, `enabled=${syncEnabled}, guild=${guildId}`);
    done = 'Contributor forum settings saved.';
  } else if (intent === 'setup-forum-tags') {
    const cfg = await readConfig();
    if (!cfg.discord_bot_token) {
      error = 'Please enter and save your Bot Token in the DM notifications section above first.';
    } else {
      let count = 0;
      if (cfg.discord_forum_bugs_id) {
        await ensureForumTags(cfg.discord_forum_bugs_id, cfg.discord_bot_token, 'bug');
        count++;
      }
      if (cfg.discord_forum_suggestions_id) {
        await ensureForumTags(cfg.discord_forum_suggestions_id, cfg.discord_bot_token, 'suggestion');
        count++;
      }
      if (cfg.discord_forum_extensions_id) {
        await ensureForumTags(cfg.discord_forum_extensions_id, cfg.discord_bot_token, 'extension');
        count++;
      }
      done = `Successfully verified and auto-created forum tags across ${count} channel(s)!`;
    }
  } else if (intent === 'sync-existing-reports') {
    const res = await syncExistingReports(origin, 50);
    done = `Sync completed: ${res.success} existing report(s) created in Discord! (${res.failed} failed)`;
  } else if (intent === 'block') {
    const target = String(form.get('discord_id') ?? '').trim();
    const blocked = form.get('blocked') === '1';
    if (!/^\d{17,20}$/.test(target)) {
      error = 'That is not a Discord user id. Enable Developer Mode in Discord, then right-click a name → Copy User ID.';
    } else if (isOwner(target)) {
      error = 'The owner cannot be blocked from here. That is the point of the environment variable.';
    } else if (target === user.id) {
      error = "You can't block yourself.";
    } else {
      await db()
        .insert(users)
        .values({
          discordId: target,
          username: 'not signed in yet',
          accountCreatedAt: Math.floor(snowflakeCreatedAt(target)),
          banned: blocked,
        })
        .onConflictDoUpdate({ target: users.discordId, set: { banned: blocked } });
      await logAction(user, blocked ? 'user.block' : 'user.unblock', target, null);
      done = blocked
        ? `${target} can no longer post or vote. Their existing reports and votes are untouched.`
        : `${target} can post and vote again.`;
    }
  } else if (intent === 'staff-set') {
    const target = String(form.get('discord_id') ?? '').trim();
    const wanted = String(form.get('level') ?? '');
    const newLevel = (STAFF_LEVELS as readonly string[]).includes(wanted)
      ? (wanted as StaffLevel)
      : null;
    if (!/^\d{17,20}$/.test(target)) {
      error = 'That is not a Discord user id. Enable Developer Mode in Discord, then right-click a name → Copy User ID.';
    } else if (target === user.id && level !== 'owner') {
      error = "You can't change your own level. Ask the owner, or edit OWNER_DISCORD_ID.";
    } else if (isOwner(target) && newLevel !== 'admin') {
      error = 'The owner cannot be demoted from here. That is the point of the environment variable.';
    } else {
      await db()
        .insert(users)
        .values({
          discordId: target,
          username: 'not signed in yet',
          accountCreatedAt: Math.floor(snowflakeCreatedAt(target)),
          manualLevel: newLevel,
        })
        .onConflictDoNothing();
      await setManualLevel(target, newLevel);
      await logAction(user, newLevel ? 'staff.grant' : 'staff.revoke', target, newLevel ?? 'none');
      done = newLevel
        ? `Granted ${LEVEL_LABELS[newLevel]} to ${target}.`
        : `Removed the manual grant from ${target}.`;
    }
  } else if (intent === 'label_create') {
    const name = String(form.get('name') ?? '').trim().toLowerCase().replace(/[^a-z0-9_-]/g, '-').slice(0, 32);
    const color = String(form.get('color') ?? '#6b7280').trim().slice(0, 16);
    if (!name) {
      error = 'Label name is required.';
    } else {
      await db().insert(labels).values({ name, color }).onConflictDoNothing();
      await logAction(user, 'label.create', name, color);
      done = `Label "${name}" created.`;
    }
  } else if (intent === 'label_delete') {
    const labelId = Number(form.get('label_id'));
    if (Number.isSafeInteger(labelId) && labelId > 0) {
      const [deleted] = await db().delete(labels).where(eq(labels.id, labelId)).returning();
      if (deleted) {
        await logAction(user, 'label.delete', deleted.name);
        done = `Label "${deleted.name}" deleted.`;
      }
    }
  }
}

const [cfg, staff, blocked, log, allLabels] = await Promise.all([
  readConfig(),
  db()
    .select({
      discordId: users.discordId,
      username: users.username,
      avatarHash: users.avatarHash,
      discordLevel: users.discordLevel,
      manualLevel: users.manualLevel,
      lastLogin: users.lastLogin,
    })
    .from(users)
    .where(or(isNotNull(users.discordLevel), isNotNull(users.manualLevel))),
  db()
    .select({ discordId: users.discordId, username: users.username })
    .from(users)
    .where(eq(users.banned, true)),
  db().select().from(audit).orderBy(desc(audit.createdAt)).limit(15),
  db().select().from(labels).orderBy(labels.name),
]);
const webhookSet = !!cfg.webhook_url;
const webhookTail = webhookSet ? cfg.webhook_url.slice(-6) : '';
const dmEnabled = cfg.discord_dm_enabled === '1';
const botTokenSet = !!cfg.discord_bot_token;
---

<Base title="Dashboard">
  <header class="head">
    <div>
      <h1>Dashboard</h1>
      <p class="sub">
        You're signed in as <b>{user.username}</b>, {LEVEL_LABELS[level]}.
        {level === 'owner' && ' Ownership comes from the environment, so nothing on this page can take it away from you.'}
      </p>
    </div>
  </header>

  {done && <p class="flash" role="status">{done}</p>}
  {error && <p class="error" role="alert">{error}</p>}

  <section class="panel">
    <h2>Staff</h2>
    <p class="panel-sub">
      Moderators change a report's status. Admins can also edit this page and block accounts.
    </p>

    {
      staff.length === 0 ? (
        <p class="empty-line">No staff yet. You are the only one who can act.</p>
      ) : (
        <ul class="staff">
          {staff.map((s) => {
            const eff = isOwner(s.discordId) ? 'owner' : combine(s.discordLevel, s.manualLevel);
            return (
              <li>
                <div class="staff-who">
                  <span class="staff-name">{s.username}</span>
                  <span class="staff-id num">{s.discordId}</span>
                </div>
                <div class="staff-meta">
                  <span class="tag">{LEVEL_LABELS[eff]}</span>
                  <span class="from">
                    {s.discordLevel && s.manualLevel
                      ? 'Discord role and manual grant'
                      : s.discordLevel
                        ? 'From Discord role'
                        : 'Granted here'}
                  </span>
                </div>
                <form method="POST" class="staff-actions">
                  <input type="hidden" name="intent" value="staff-set" />
                  <input type="hidden" name="discord_id" value={s.discordId} />
                  {eff !== 'admin' && eff !== 'owner' && (
                    <button class="btn btn-ghost" type="submit" name="level" value="admin">Make admin</button>
                  )}
                  {eff !== 'mod' && eff !== 'owner' && (
                    <button class="btn btn-ghost" type="submit" name="level" value="mod">Make moderator</button>
                  )}
                  {s.manualLevel && (
                    <button class="btn btn-ghost danger" type="submit" name="level" value="">Remove grant</button>
                  )}
                </form>
              </li>
            );
          })}
        </ul>
      )
    }

    <form method="POST" class="add">
      <input type="hidden" name="intent" value="staff-set" />
      <div class="field">
        <label class="label" for="discord_id">Add by Discord user id</label>
        <input class="input" id="discord_id" name="discord_id" inputmode="numeric" placeholder="e.g. 216154654256398347" autocomplete="off" />
        <p class="field-hint">Developer Mode in Discord → right-click a name → Copy User ID.</p>
      </div>
      <div class="add-actions">
        <button class="btn" type="submit" name="level" value="mod">Add as moderator</button>
        <button class="btn" type="submit" name="level" value="admin">Add as admin</button>
      </div>
    </form>
  </section>

  <section class="panel">
    <h2>Discord roles that grant staff</h2>
    <p class="panel-sub">
      Role <b>ids</b>, comma-separated. Names can't be resolved without a bot.
    </p>
    <form method="POST" class="rows-2">
      <input type="hidden" name="intent" value="roles" />
      <div class="field">
        <label class="label" for="mod_role_ids">Moderator roles</label>
        <input class="input num" id="mod_role_ids" name="mod_role_ids" value={cfg.mod_role_ids} autocomplete="off" />
      </div>
      <div class="field">
        <label class="label" for="admin_role_ids">Admin roles</label>
        <input class="input num" id="admin_role_ids" name="admin_role_ids" value={cfg.admin_role_ids} autocomplete="off" />
      </div>
      <div class="wide">
        <button class="btn btn-primary" type="submit">Save roles</button>
      </div>
    </form>
  </section>

  <section class="panel">
    <h2>Discord announcements</h2>
    <p class="panel-sub">
      A channel webhook for announcing fixes and new reports — and for logging every
      vote, comment, reply, filed report, and staff action. Channel → Edit Channel →
      Integrations → Webhooks → New Webhook → Copy URL.
    </p>
    <form method="POST" class="rows-2">
      <input type="hidden" name="intent" value="webhook" />
      <div class="field wide">
        <label class="label" for="webhook_url">Webhook URL</label>
        <input
          class="input"
          id="webhook_url"
          name="webhook_url"
          type="password"
          placeholder={webhookSet ? `saved, ending …${webhookTail}. Paste a new one to replace` : 'https://discord.com/api/webhooks/…'}
          autocomplete="off"
        />
        <p class="field-hint">
          {webhookSet ? 'Leave empty to keep it, or type __clear__ to remove it.' : 'Nothing is announced until this is set.'}
        </p>
      </div>
      <div class="field wide">
        <label class="check">
          <input type="checkbox" name="webhook_on_fixed" value="1" checked={cfg.webhook_on_fixed === '1'} />
          <span>Announce every fix / implementation</span>
        </label>
      </div>
      <div class="field wide">
        <label class="check">
          <input type="checkbox" name="webhook_on_new_report" value="1" checked={cfg.webhook_on_new_report === '1'} />
          <span>Announce new reports</span>
        </label>
      </div>
      <div class="field">
        <label class="label" for="webhook_vote_threshold">Announce at this many votes</label>
        <input class="input num" id="webhook_vote_threshold" name="webhook_vote_threshold" inputmode="numeric" value={cfg.webhook_vote_threshold} />
        <p class="field-hint">0 turns demand alerts off.</p>
      </div>
      <div class="wide actions">
        <button class="btn btn-primary" type="submit">Save announcements</button>
      </div>
    </form>
    <form method="POST" class="test">
      <input type="hidden" name="intent" value="webhook-test" />
      <button class="btn" type="submit" disabled={!webhookSet}>Send a test message</button>
    </form>
  </section>

  <section class="panel">
    <h2>DM notifications</h2>
    <p class="panel-sub">
      Send a DM to reporters when their report's status changes. Requires a bot token that shares a guild with the user.
    </p>
    <form method="POST" class="rows-2">
      <input type="hidden" name="intent" value="dm" />
      <div class="field wide">
        <label class="check">
          <input type="checkbox" name="discord_dm_enabled" value="1" checked={dmEnabled} />
          <span>Enable DM notifications</span>
        </label>
      </div>
      <div class="field wide">
        <label class="label" for="discord_bot_token">Bot token</label>
        <input
          class="input"
          id="discord_bot_token"
          name="discord_bot_token"
          type="password"
          placeholder={botTokenSet ? 'saved. Paste a new one to replace.' : 'Paste the bot token'}
          autocomplete="off"
        />
        <p class="field-hint">The bot must share a guild with the user to send DMs.</p>
      </div>
      <div class="wide actions">
        <button class="btn btn-primary" type="submit">Save DM settings</button>
      </div>
    </form>
  </section>

  <section class="panel">
    <h2>Contributor Discord Server & Forums</h2>
    <p class="panel-sub">
      Automatically creates threads in your Contributor Discord Forum channels when bugs, suggestions, or extension issues are filed. Syncs comments, edits, deletions, and forum tags bidirectionally.
    </p>
    <form method="POST" class="rows-2">
      <input type="hidden" name="intent" value="contributor-forums" />
      <div class="field wide">
        <label class="check">
          <input type="checkbox" name="discord_forum_sync_enabled" value="1" checked={cfg.discord_forum_sync_enabled === '1'} />
          <span>Enable Contributor Forum synchronization</span>
        </label>
      </div>
      <div class="field">
        <label class="label" for="contributor_guild_id">Contributor Server (Guild) ID</label>
        <input class="input" id="contributor_guild_id" name="contributor_guild_id" value={cfg.contributor_guild_id} placeholder="1545003117018357850" />
      </div>
      <div class="field">
        <label class="label" for="discord_sync_secret">Inbound Sync Secret</label>
        <input class="input" id="discord_sync_secret" name="discord_sync_secret" type="password" value={cfg.discord_sync_secret} placeholder="Optional shared token for inbound webhook" />
      </div>
      <div class="field">
        <label class="label" for="discord_forum_bugs_id">Bugs Forum Channel ID</label>
        <input class="input" id="discord_forum_bugs_id" name="discord_forum_bugs_id" value={cfg.discord_forum_bugs_id} placeholder="1545003724961751096" />
      </div>
      <div class="field">
        <label class="label" for="discord_forum_suggestions_id">Suggestions Forum Channel ID</label>
        <input class="input" id="discord_forum_suggestions_id" name="discord_forum_suggestions_id" value={cfg.discord_forum_suggestions_id} placeholder="1545003626823417906" />
      </div>
      <div class="field wide">
        <label class="label" for="discord_forum_extensions_id">Extension Issues Forum Channel ID</label>
        <input class="input" id="discord_forum_extensions_id" name="discord_forum_extensions_id" value={cfg.discord_forum_extensions_id} placeholder="1545003859380805702" />
      </div>
      <div class="wide actions">
        <button class="btn btn-primary" type="submit">Save Forum Settings</button>
      </div>
    </form>
    <form method="POST" class="test" style="margin-top: 16px;">
      <input type="hidden" name="intent" value="setup-forum-tags" />
      <button class="btn" type="submit">⚡ Auto-Generate / Verify Forum Tags on Discord</button>
      <p class="field-hint" style="margin-top: 6px;">Creates Open, In Progress, Fixed, Duplicate, Won't Fix, and Platform/Source tags in all 3 channels automatically.</p>
    </form>
    <form method="POST" class="test" style="margin-top: 16px;">
      <input type="hidden" name="intent" value="sync-existing-reports" />
      <button class="btn" type="submit">📦 Sync All Existing Reports to Discord Forums</button>
      <p class="field-hint" style="margin-top: 6px;">Creates Discord threads for any existing bugs, suggestions, or extension issues that don't have one yet, and syncs their comments.</p>
    </form>
  </section>

  <section class="panel">
    <h2>Who can post</h2>
    <form method="POST" class="rows-2">
      <input type="hidden" name="intent" value="gate" />
      <div class="field">
        <label class="label" for="min_account_age_days">Minimum Discord account age (days)</label>
        <input class="input num" id="min_account_age_days" name="min_account_age_days" inputmode="numeric" value={cfg.min_account_age_days} />
        <p class="field-hint">
          Any Discord account can participate. This is the throwaway-account brake.
        </p>
      </div>
      <div class="wide">
        <button class="btn btn-primary" type="submit">Save</button>
      </div>
    </form>
  </section>

  <section class="panel">
    <h2>Blocked accounts</h2>
    <p class="panel-sub">
      A block is checked on every post and every vote. It leaves what they already filed in place.
    </p>
    {
      blocked.length === 0 ? (
        <p class="empty-line">Nobody is blocked.</p>
      ) : (
        <ul class="staff">
          {blocked.map((b) => (
            <li>
              <div class="staff-who">
                <span class="staff-name">{b.username}</span>
                <span class="staff-id num">{b.discordId}</span>
              </div>
              <div class="staff-meta">
                <span class="tag">Blocked</span>
              </div>
              <form method="POST" class="staff-actions">
                <input type="hidden" name="intent" value="block" />
                <input type="hidden" name="discord_id" value={b.discordId} />
                <button class="btn btn-ghost" type="submit" name="blocked" value="0">Unblock</button>
              </form>
            </li>
          ))}
        </ul>
      )
    }
    <form method="POST" class="add">
      <input type="hidden" name="intent" value="block" />
      <input type="hidden" name="blocked" value="1" />
      <div class="field">
        <label class="label" for="block_discord_id">Block by Discord user id</label>
        <input class="input" id="block_discord_id" name="discord_id" inputmode="numeric" placeholder="e.g. 216154654256398347" autocomplete="off" />
        <p class="field-hint">Developer Mode in Discord → right-click a name → Copy User ID.</p>
      </div>
      <div class="add-actions">
        <button class="btn danger" type="submit">Block</button>
      </div>
    </form>
  </section>

  <section class="panel">
    <h2>Report labels</h2>
    <p class="panel-lede">Tags used by moderators on reports (e.g. regression, upstream, needs-repro).</p>
    {
      allLabels.length === 0 ? (
        <p class="empty-line">No labels created yet.</p>
      ) : (
        <ul class="staff-list">
          {allLabels.map((l) => (
            <li class="staff-row">
              <div class="staff-name">
                <span class="label-chip" style={`background: ${l.color}22; border-color: ${l.color}; color: ${l.color};`}>
                  {l.name}
                </span>
                <span class="staff-tag num">{l.color}</span>
              </div>
              <form method="POST" class="staff-actions">
                <input type="hidden" name="intent" value="label_delete" />
                <input type="hidden" name="label_id" value={l.id} />
                <button class="btn btn-ghost" type="submit">Delete</button>
              </form>
            </li>
          ))}
        </ul>
      )
    }
    <form method="POST" class="add">
      <input type="hidden" name="intent" value="label_create" />
      <div class="field-row">
        <div class="field">
          <label class="label" for="label_name">New label name</label>
          <input class="input" id="label_name" name="name" placeholder="e.g. regression" maxlength="32" required />
        </div>
        <div class="field">
          <label class="label" for="label_color">Color (hex)</label>
