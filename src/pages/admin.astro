---
import Base from '../layouts/Base.astro';
import { desc, eq, isNotNull, or } from 'drizzle-orm';
import { db } from '../lib/db/client';
import { audit, labels, STAFF_LEVELS, users, type StaffLevel } from '../lib/db/schema';
import { avatarUrl, snowflakeCreatedAt } from '../lib/auth';
import { LEVEL_LABELS, combine, atLeast } from '../lib/levels';
import { idList, readConfig, writeSettings } from '../lib/settings';
import { isOwner, isResponse, levelOf, logAction, requireStaff, setManualLevel } from '../lib/staff';
import { testWebhook } from '../lib/webhook';
import { ensureForumTags, syncExistingReports } from '../lib/discord-forums';
import { relativeAge } from '../lib/format';

export const prerender = false;

/**
 * Staff Dashboard.
 *
 * Accessible to Staff (mod, admin, owner).
 * Permissions:
 * - Owner: Full authority (can add/remove admins & mods, manage Discord roles, and edit sensitive integration secrets/tokens).
 * - Admin: Moderation authority (can add/remove mods, manage account-age gate, blocked users, report labels, CSV export). Cannot touch admins or environment secrets.
 * - Moderator: View-only dashboard access (can review audit logs and staff directory; directed to /triage for report actions).
 */
const gate = await requireStaff(Astro, 'mod');
if (isResponse(gate)) return gate;
const { user, level } = gate;

const isOwnerUser = level === 'owner';
const isAdminUser = atLeast(level, 'admin');
const isModUser = level === 'mod';

// Role-based allowed tabs
const allowedTabs: string[] = isOwnerUser
  ? ['staff', 'moderation', 'audit', 'settings']
  : isAdminUser
    ? ['staff', 'moderation', 'audit']
    : ['audit', 'staff'];

let error: string | null = null;
let done: string | null = null;
let postedTab: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  postedTab = String(form.get('tab') ?? '');
  const origin = Astro.url.origin;

  if (isModUser) {
    error = 'Moderators have view-only access to the dashboard. Please use the triage queue for report management.';
  } else if (intent === 'roles') {
    if (!isOwnerUser) {
      error = 'Only the owner can configure Discord staff role mappings.';
    } else {
      const mod = idList(String(form.get('mod_role_ids') ?? '')).join(',');
      const admin = idList(String(form.get('admin_role_ids') ?? '')).join(',');
      await writeSettings({ mod_role_ids: mod, admin_role_ids: admin }, user.id);
      await logAction(user, 'settings.roles', null, `mod=[${mod}] admin=[${admin}]`);
      done = 'Discord role mapping saved. It applies to each person the next time they sign in.';
    }
  } else if (intent === 'gate') {
    const days = Math.max(0, Math.min(3650, Number(form.get('min_account_age_days') ?? 30)));
    await writeSettings({ min_account_age_days: String(days) }, user.id);
    await logAction(user, 'settings.gate', null, `min_account_age_days=${days}`);
    done = `Accounts must now be ${days} days old to post or vote.`;
  } else if (intent === 'webhook') {
    if (!isOwnerUser) {
      error = 'Only the owner can view or modify announcement webhook settings.';
    } else {
      const raw = String(form.get('webhook_url') ?? '').trim();
      const onFixed = form.get('webhook_on_fixed') === '1' ? '1' : '0';
      const onNewReport = form.get('webhook_on_new_report') === '1' ? '1' : '0';
      const threshold = Math.max(0, Math.min(9999, Number(form.get('webhook_vote_threshold') ?? 0)));
      const patch: Record<string, string> = {
        webhook_on_fixed: onFixed,
        webhook_on_new_report: onNewReport,
        webhook_vote_threshold: String(threshold),
      };
      if (raw === '__clear__') {
        patch.webhook_url = '';
      } else if (raw) {
        if (!/^https:\/\/(discord\.com|discordapp\.com)\/api\/webhooks\//.test(raw)) {
          error = 'That is not a Discord webhook URL. Copy it from Channel → Edit Channel → Integrations → Webhooks.';
        } else {
          patch.webhook_url = raw;
        }
      }
      if (!error) {
        await writeSettings(patch, user.id);
        await logAction(user, 'settings.webhook', null,
          `${patch.webhook_url === '' ? 'cleared' : raw ? 'replaced' : 'unchanged'}, on_fixed=${onFixed}, on_new_report=${onNewReport}, threshold=${threshold}`);
        done = 'Announcement settings saved.';
      }
    }
  } else if (intent === 'webhook-test') {
    if (!isOwnerUser) {
      error = 'Only the owner can trigger webhook test messages.';
    } else {
      const cfg = await readConfig();
      if (!cfg.webhook_url) {
        error = 'Save a webhook URL first.';
      } else {
        const res = await testWebhook(cfg.webhook_url, origin, user.username);
        done = res.ok ? 'Test message sent. Check the channel.' : null;
        error = res.ok ? null : `Discord rejected it (${res.status}). ${res.body.slice(0, 200)}`;
      }
    }
  } else if (intent === 'dm') {
    if (!isOwnerUser) {
      error = 'Only the owner can modify Discord DM notification settings and bot tokens.';
    } else {
      const dmEnabled = form.get('discord_dm_enabled') === '1' ? '1' : '0';
      const botToken = String(form.get('discord_bot_token') ?? '').trim();
      const patch: Record<string, string> = { discord_dm_enabled: dmEnabled };
      if (botToken && botToken !== '••••••••') {
        patch.discord_bot_token = botToken;
      }
      await writeSettings(patch, user.id);
      await logAction(user, 'settings.dm', null, `enabled=${dmEnabled}, token=${botToken ? 'changed' : 'unchanged'}`);
      done = 'DM notification settings saved.';
    }
  } else if (intent === 'telegram') {
    if (!isOwnerUser) {
      error = 'Only the owner can modify Telegram credentials and settings.';
    } else {
      const tgDmEnabled = form.get('telegram_dm_enabled') === '1' ? '1' : '0';
      const tgToken = String(form.get('telegram_bot_token') ?? '').trim();
      const tgUsername = String(form.get('telegram_bot_username') ?? '').trim().replace(/^@/, '');
      const patch: Record<string, string> = {
        telegram_dm_enabled: tgDmEnabled,
        telegram_bot_username: tgUsername,
      };
      if (tgToken && tgToken !== '••••••••') {
        patch.telegram_bot_token = tgToken;
      }
      await writeSettings(patch, user.id);
      await logAction(user, 'settings.telegram', null, `username=${tgUsername}, token=${tgToken ? 'changed' : 'unchanged'}`);
      done = 'Telegram settings saved.';
    }
  } else if (intent === 'contributor-forums') {
    if (!isOwnerUser) {
      error = 'Only the owner can modify contributor forum synchronization settings.';
    } else {
      const syncEnabled = form.get('discord_forum_sync_enabled') === '1' ? '1' : '0';
      const guildId = String(form.get('contributor_guild_id') ?? '').trim();
      const bugsId = String(form.get('discord_forum_bugs_id') ?? '').trim();
      const suggestionsId = String(form.get('discord_forum_suggestions_id') ?? '').trim();
      const extensionsId = String(form.get('discord_forum_extensions_id') ?? '').trim();
      const syncSecret = String(form.get('discord_sync_secret') ?? '').trim();

      const patch: Record<string, string> = {
        discord_forum_sync_enabled: syncEnabled,
        contributor_guild_id: guildId,
        discord_forum_bugs_id: bugsId,
        discord_forum_suggestions_id: suggestionsId,
        discord_forum_extensions_id: extensionsId,
        discord_sync_secret: syncSecret,
      };
      await writeSettings(patch, user.id);
      await logAction(user, 'settings.forums', null, `enabled=${syncEnabled}, guild=${guildId}`);
      done = 'Contributor forum settings saved.';
    }
  } else if (intent === 'setup-forum-tags') {
    if (!isOwnerUser) {
      error = 'Only the owner can trigger forum tag generation.';
    } else {
      const cfg = await readConfig();
      if (!cfg.discord_bot_token) {
        error = 'Please enter and save your Bot Token in the Settings & Secrets tab first.';
      } else {
        let count = 0;
        if (cfg.discord_forum_bugs_id) {
          await ensureForumTags(cfg.discord_forum_bugs_id, cfg.discord_bot_token, 'bug');
          count++;
        }
        if (cfg.discord_forum_suggestions_id) {
          await ensureForumTags(cfg.discord_forum_suggestions_id, cfg.discord_bot_token, 'suggestion');
          count++;
        }
        if (cfg.discord_forum_extensions_id) {
          await ensureForumTags(cfg.discord_forum_extensions_id, cfg.discord_bot_token, 'extension');
          count++;
        }
        done = `Successfully verified and auto-created forum tags across ${count} channel(s)!`;
      }
    }
  } else if (intent === 'sync-existing-reports') {
    if (!isOwnerUser) {
      error = 'Only the owner can run forum synchronization.';
    } else {
      const res = await syncExistingReports(origin, 50);
      done = `Sync completed: ${res.success} new report thread(s) created, ${res.commentsSynced} comment(s) posted to Discord!`;
    }
  } else if (intent === 'block') {
    const target = String(form.get('discord_id') ?? '').trim();
    const blocked = form.get('blocked') === '1';
    if (!/^\d{17,20}$/.test(target)) {
      error = 'That is not a Discord user id. Enable Developer Mode in Discord, then right-click a name → Copy User ID.';
    } else if (isOwner(target)) {
      error = 'The owner cannot be blocked from here.';
    } else if (target === user.id) {
      error = "You can't block yourself.";
    } else {
      await db()
        .insert(users)
        .values({
          discordId: target,
          username: 'not signed in yet',
          accountCreatedAt: Math.floor(snowflakeCreatedAt(target)),
          banned: blocked,
        })
        .onConflictDoUpdate({ target: users.discordId, set: { banned: blocked } });
      await logAction(user, blocked ? 'user.block' : 'user.unblock', target, null);
      done = blocked
        ? `${target} can no longer post or vote. Their existing reports and votes are untouched.`
        : `${target} can post and vote again.`;
    }
  } else if (intent === 'staff-set') {
    const target = String(form.get('discord_id') ?? '').trim();
    const wanted = String(form.get('level') ?? '');
    const newLevel = (STAFF_LEVELS as readonly string[]).includes(wanted)
      ? (wanted as StaffLevel)
      : null;
    const targetCurrentLevel = await levelOf(target);

    if (!/^\d{17,20}$/.test(target)) {
      error = 'That is not a Discord user id. Enable Developer Mode in Discord, then right-click a name → Copy User ID.';
    } else if (target === user.id && !isOwnerUser) {
      error = "You can't change your own level. Ask the owner, or edit OWNER_DISCORD_ID.";
    } else if (isOwner(target)) {
      error = 'The owner cannot be demoted or modified from here.';
    } else if (!isOwnerUser && (newLevel === 'admin' || targetCurrentLevel === 'admin' || targetCurrentLevel === 'owner')) {
      error = 'Only the owner can add, promote, or remove administrators. Admins may only add or remove moderators.';
    } else {
      await db()
        .insert(users)
        .values({
          discordId: target,
          username: 'not signed in yet',
          accountCreatedAt: Math.floor(snowflakeCreatedAt(target)),
          manualLevel: newLevel,
        })
        .onConflictDoNothing();
      await setManualLevel(target, newLevel);
      await logAction(user, newLevel ? 'staff.grant' : 'staff.revoke', target, newLevel ?? 'none');
      done = newLevel
        ? `Granted ${LEVEL_LABELS[newLevel]} to ${target}.`
        : `Removed the manual grant from ${target}.`;
    }
  } else if (intent === 'label_create') {
    const name = String(form.get('name') ?? '').trim().toLowerCase().replace(/[^a-z0-9_-]/g, '-').slice(0, 32);
    const color = String(form.get('color') ?? '#6b7280').trim().slice(0, 16);
    if (!name) {
      error = 'Label name is required.';
    } else {
      await db().insert(labels).values({ name, color }).onConflictDoNothing();
      await logAction(user, 'label.create', name, color);
      done = `Label "${name}" created.`;
    }
  } else if (intent === 'label_delete') {
    const labelId = Number(form.get('label_id'));
    if (Number.isSafeInteger(labelId) && labelId > 0) {
      const [deleted] = await db().delete(labels).where(eq(labels.id, labelId)).returning();
      if (deleted) {
        await logAction(user, 'label.delete', deleted.name);
        done = `Label "${deleted.name}" deleted.`;
      }
    }
  }
}

// Determine active tab
const urlTab = Astro.url.searchParams.get('tab');
const requestedTab = postedTab || urlTab;
let activeTab = requestedTab && allowedTabs.includes(requestedTab) ? requestedTab : allowedTabs[0];

const [cfg, rawStaff, blocked, log, allLabels] = await Promise.all([
  readConfig(),
  db()
    .select({
      discordId: users.discordId,
      username: users.username,
      avatarHash: users.avatarHash,
      discordLevel: users.discordLevel,
      manualLevel: users.manualLevel,
      lastLogin: users.lastLogin,
    })
    .from(users)
    .where(or(isNotNull(users.discordLevel), isNotNull(users.manualLevel))),
  db()
    .select({ discordId: users.discordId, username: users.username })
    .from(users)
    .where(eq(users.banned, true)),
  db().select().from(audit).orderBy(desc(audit.createdAt)).limit(30),
  db().select().from(labels).orderBy(labels.name),
]);

// Sort staff: Owner first, then Admins, then Mods
const staff = [...rawStaff].sort((a, b) => {
  const effA = isOwner(a.discordId) ? 'owner' : combine(a.discordLevel, a.manualLevel);
  const effB = isOwner(b.discordId) ? 'owner' : combine(b.discordLevel, b.manualLevel);
  const rank: Record<string, number> = { owner: 3, admin: 2, mod: 1, user: 0 };
  return (rank[effB] ?? 0) - (rank[effA] ?? 0);
});

// Secrets metadata (Only used if user is Owner)
const webhookSet = !!cfg.webhook_url;
const webhookTail = webhookSet ? cfg.webhook_url.slice(-6) : '';
const dmEnabled = cfg.discord_dm_enabled === '1';
const botTokenSet = !!cfg.discord_bot_token;
const tgDmEnabled = cfg.telegram_dm_enabled === '1';
const tgTokenSet = !!cfg.telegram_bot_token;
const forumSyncEnabled = cfg.discord_forum_sync_enabled === '1';
---

<Base title="Staff Dashboard">
  <header class="head">
    <div class="head-content">
      <div>
        <div class="title-row">
          <h1>Staff Dashboard</h1>
          <span class={`role-badge role-${level}`}>
            {LEVEL_LABELS[level]}
          </span>
        </div>
        <p class="sub">
          Signed in as <b>{user.username}</b>.
          {level === 'owner' && ' You have full root authority over staff, moderation, and system secrets.'}
          {level === 'admin' && ' You have administrator access for managing moderators, moderation policies, and reports.'}
          {level === 'mod' && ' You have moderator access. You can view the audit log and staff roster.'}
        </p>
      </div>

      <div class="head-quick-actions">
        <a href="/triage" class="btn btn-ghost triage-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 11 12 14 22 4"></polyline>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
          </svg>
          <span>Triage Queue</span>
        </a>
      </div>
    </div>

    <!-- Tab Navigation -->
    <nav class="tabs-nav" aria-label="Dashboard sections">
      {allowedTabs.includes('staff') && (
        <a
          href={`/admin?tab=staff`}
          class:list={['tab-btn', { active: activeTab === 'staff' }]}
          data-tab-trigger="staff"
          role="tab"
          aria-selected={activeTab === 'staff'}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
          </svg>
          <span>Staff &amp; Team</span>
          <span class="tab-badge">{staff.length}</span>
        </a>
      )}

      {allowedTabs.includes('moderation') && (
        <a
          href={`/admin?tab=moderation`}
          class:list={['tab-btn', { active: activeTab === 'moderation' }]}
          data-tab-trigger="moderation"
          role="tab"
          aria-selected={activeTab === 'moderation'}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          </svg>
          <span>Moderation</span>
          {blocked.length > 0 && <span class="tab-badge warn">{blocked.length}</span>}
        </a>
      )}

      {allowedTabs.includes('audit') && (
        <a
          href={`/admin?tab=audit`}
          class:list={['tab-btn', { active: activeTab === 'audit' }]}
          data-tab-trigger="audit"
          role="tab"
          aria-selected={activeTab === 'audit'}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
          </svg>
          <span>Audit Log</span>
        </a>
      )}

      {allowedTabs.includes('settings') && (
        <a
          href={`/admin?tab=settings`}
          class:list={['tab-btn', 'tab-owner-only', { active: activeTab === 'settings' }]}
          data-tab-trigger="settings"
          role="tab"
          aria-selected={activeTab === 'settings'}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
          <span>Settings &amp; Secrets</span>
          <span class="owner-pill">Owner</span>
        </a>
      )}
    </nav>
  </header>

  {done && <p class="flash" role="status">{done}</p>}
  {error && <p class="error" role="alert">{error}</p>}

  {isModUser && (
    <div class="info-callout">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="16" x2="12" y2="12" />
        <line x1="12" y1="8" x2="12.01" y2="8" />
      </svg>
      <div>
        <b>Moderator View:</b> You have access to review the staff directory and audit log. To triage reports, change statuses, or manage duplicate submissions, visit the <a href="/triage"><b>Triage Queue</b></a>.
      </div>
    </div>
  )}

  <!-- TAB 1: STAFF & TEAM -->
  <div class:list={['tab-pane', { active: activeTab === 'staff' }]} data-tab-pane="staff" hidden={activeTab !== 'staff'}>
    <section class="panel">
      <!-- Section Header with Add Button -->
      <div class="panel-header-with-action">
        <div>
          <h2>Staff Members</h2>
          <p class="panel-sub">
            {isOwnerUser
              ? 'As Owner, you can appoint or remove Administrators and Moderators.'
              : isAdminUser
                ? 'As Admin, you can appoint and manage Moderators. Only the Owner can assign Administrators.'
                : 'Directory of active staff members and their permissions.'}
          </p>
        </div>

        {!isModUser && (
          <button type="button" class="btn btn-primary btn-sm" id="toggle-add-staff-btn" aria-expanded="false" aria-controls="add-staff-drawer">
            <svg class="toggle-icon-plus" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="5" x2="12" y2="19" />
              <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            <span>Add Staff Member</span>
          </button>
        )}
      </div>

      <!-- Expandable Add Staff Member Drawer (Above Staff List) -->
      {!isModUser && (
        <div id="add-staff-drawer" class="add-staff-drawer" hidden>
          <div class="add-box">
            <div class="add-box-header">
              <h3>Appoint Staff Member</h3>
              <button type="button" class="btn btn-ghost btn-sm" id="close-add-staff-btn" aria-label="Close drawer">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18" />
                  <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
                <span>Cancel</span>
              </button>
            </div>
            <form method="POST" class="add">
              <input type="hidden" name="intent" value="staff-set" />
              <input type="hidden" name="tab" value="staff" />
              <div class="field">
                <label class="label" for="discord_id">Discord User ID</label>
                <input
                  class="input"
                  id="discord_id"
                  name="discord_id"
                  inputmode="numeric"
                  placeholder="e.g. 216154654256398347"
                  autocomplete="off"
                  required
                />
                <p class="field-hint">Enable Developer Mode in Discord → right-click user → Copy User ID.</p>
              </div>
              <div class="add-actions">
                <button class="btn btn-primary" type="submit" name="level" value="mod">
                  Add as Moderator
                </button>
                {isOwnerUser ? (
                  <button class="btn btn-accent" type="submit" name="level" value="admin">
                    Add as Administrator
                  </button>
                ) : (
                  <span class="admin-notice-hint">
                    ℹ️ Only the Owner can appoint Administrators.
                  </span>
                )}
              </div>
            </form>
          </div>
        </div>
      )}

      <!-- Staff Search & Role Filter Toolbar -->
      <div class="staff-toolbar">
        <div class="staff-search-box">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input
            type="search"
            class="staff-search-input"
            id="staff-search"
            placeholder="Search staff by name or Discord ID..."
            autocomplete="off"
          />
        </div>

        <div class="staff-filter-chips" role="group" aria-label="Filter staff by role">
          <button type="button" class="chip active" data-staff-filter="all">
            All ({staff.length})
          </button>
          <button type="button" class="chip" data-staff-filter="owner">
            Owners ({staff.filter(s => isOwner(s.discordId)).length})
          </button>
          <button type="button" class="chip" data-staff-filter="admin">
            Admins ({staff.filter(s => !isOwner(s.discordId) && combine(s.discordLevel, s.manualLevel) === 'admin').length})
          </button>
          <button type="button" class="chip" data-staff-filter="mod">
            Mods ({staff.filter(s => !isOwner(s.discordId) && combine(s.discordLevel, s.manualLevel) === 'mod').length})
          </button>
        </div>
      </div>

      <!-- Staff Cards Grid -->
      {
        staff.length === 0 ? (
          <p class="empty-line">No staff configured yet.</p>
        ) : (
          <ul class="staff-grid" id="staff-card-grid">
            {staff.map((s) => {
              const eff = isOwner(s.discordId) ? 'owner' : combine(s.discordLevel, s.manualLevel);
              const isTargetOwner = isOwner(s.discordId);
              const isTargetAdmin = eff === 'admin';
              const isTargetMod = eff === 'mod';
              const avatar = avatarUrl({ id: s.discordId, avatarHash: s.avatarHash }, 64);
              const initial = (s.username || '?')[0].toUpperCase();

              return (
                <li
                  class="staff-card"
                  data-staff-role={eff}
                  data-staff-search={`${s.username} ${s.discordId}`.toLowerCase()}
                >
                  <div class="staff-card-header">
                    <div class="staff-identity">
                      <div class="staff-avatar-wrap">
                        {avatar ? (
                          <img class="staff-avatar" src={avatar} alt={s.username} width="38" height="38" loading="lazy" />
                        ) : (
                          <div class="staff-avatar-fallback">{initial}</div>
                        )}
                      </div>
                      <div class="staff-who">
                        <span class="staff-name">{s.username}</span>
                        <button
                          type="button"
                          class="staff-id-copy-btn"
                          data-copy-id={s.discordId}
                          title="Click to copy Discord ID"
                        >
                          <span class="staff-id num">{s.discordId}</span>
                          <svg class="copy-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                          </svg>
                        </button>
                      </div>
                    </div>
                    <span class={`role-badge role-${eff}`}>{LEVEL_LABELS[eff]}</span>
                  </div>

                  <div class="staff-meta">
                    <span class="from">
                      {s.discordLevel && s.manualLevel
                        ? 'Discord role & manual grant'
                        : s.discordLevel
                          ? 'From Discord role'
                          : 'Manual grant'}
                    </span>
                    {s.lastLogin && (
                      <span class="last-seen">Active {relativeAge(s.lastLogin)} ago</span>
                    )}
                  </div>

                  {!isModUser && !isTargetOwner && (
                    <form
                      method="POST"
                      class="staff-actions"
                      onsubmit={s.manualLevel ? "return confirm('Are you sure you want to remove staff privileges from this user?');" : undefined}
                    >
                      <input type="hidden" name="intent" value="staff-set" />
                      <input type="hidden" name="tab" value="staff" />
                      <input type="hidden" name="discord_id" value={s.discordId} />

                      {/* OWNER ACTIONS: Can promote to admin, mod, or remove any grant */}
                      {isOwnerUser && (
                        <>
                          {!isTargetAdmin && (
                            <button class="btn btn-ghost btn-sm" type="submit" name="level" value="admin">
                              Make admin
                            </button>
                          )}
                          {!isTargetMod && (
                            <button class="btn btn-ghost btn-sm" type="submit" name="level" value="mod">
                              Make moderator
                            </button>
                          )}
                          {s.manualLevel && (
                            <button class="btn btn-ghost btn-sm danger" type="submit" name="level" value="">
                              Remove grant
                            </button>
                          )}
                        </>
                      )}

                      {/* ADMIN ACTIONS: Can ONLY manage moderators. CANNOT touch admins */}
                      {!isOwnerUser && isAdminUser && (
                        <>
                          {!isTargetAdmin && !isTargetMod && (
                            <button class="btn btn-ghost btn-sm" type="submit" name="level" value="mod">
                              Make moderator
                            </button>
                          )}
                          {isTargetMod && s.manualLevel === 'mod' && (
                            <button class="btn btn-ghost btn-sm danger" type="submit" name="level" value="">
                              Remove moderator
                            </button>
                          )}
                          {isTargetAdmin && (
                            <span class="locked-badge" title="Only the Owner can modify Administrators">
                              Admin (Protected)
                            </span>
                          )}
                        </>
                      )}
                    </form>
                  )}
                </li>
              );
            })}
          </ul>
        )
      }
    </section>

    <!-- Role Mapping Panel -->
    <section class="panel">
      <h2>Discord Staff Role IDs</h2>
      <p class="panel-sub">
        Comma-separated Discord role IDs that automatically grant Moderator or Administrator status upon sign-in.
      </p>

      {isOwnerUser ? (
        <form method="POST" class="rows-2">
          <input type="hidden" name="intent" value="roles" />
          <input type="hidden" name="tab" value="staff" />
          <div class="field">
            <label class="label" for="mod_role_ids">Moderator Role IDs</label>
            <input class="input num" id="mod_role_ids" name="mod_role_ids" value={cfg.mod_role_ids} autocomplete="off" placeholder="e.g. 10293847561,192837465" />
          </div>
          <div class="field">
            <label class="label" for="admin_role_ids">Administrator Role IDs</label>
            <input class="input num" id="admin_role_ids" name="admin_role_ids" value={cfg.admin_role_ids} autocomplete="off" placeholder="e.g. 9876543210" />
          </div>
          <div class="wide">
            <button class="btn btn-primary" type="submit">Save Role Mapping</button>
          </div>
        </form>
      ) : (
        <div class="read-only-card">
          <div class="read-only-row">
            <span class="label-text">Moderator Roles:</span>
            <code>{cfg.mod_role_ids || 'None configured'}</code>
          </div>
          <div class="read-only-row">
            <span class="label-text">Admin Roles:</span>
            <code>{cfg.admin_role_ids || 'None configured'}</code>
          </div>
          <p class="field-hint" style="margin-block-start: var(--space-2);">
            🔒 Discord staff role mapping can only be configured by the Owner.
          </p>
        </div>
      )}
    </section>
  </div>

  <!-- TAB 2: MODERATION (Admin & Owner) -->
  {isAdminUser && (
    <div class:list={['tab-pane', { active: activeTab === 'moderation' }]} data-tab-pane="moderation" hidden={activeTab !== 'moderation'}>
      <section class="panel">
        <h2>Account-Age Security Gate</h2>
        <p class="panel-sub">
          Prevent throwaway spam accounts from creating reports or voting on existing issues.
        </p>
        <form method="POST" class="rows-2">
          <input type="hidden" name="intent" value="gate" />
          <input type="hidden" name="tab" value="moderation" />
          <div class="field">
            <label class="label" for="min_account_age_days">Minimum Discord Account Age (days)</label>
            <input class="input num" id="min_account_age_days" name="min_account_age_days" inputmode="numeric" value={cfg.min_account_age_days} />
            <p class="field-hint">Accounts younger than this threshold will be blocked from posting or voting.</p>
          </div>
          <div class="wide">
            <button class="btn btn-primary" type="submit">Save Gate</button>
