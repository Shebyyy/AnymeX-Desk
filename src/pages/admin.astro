            />
            <p class="field-hint">The bot must share a Discord server (guild) with the target user to deliver DMs.</p>
          </div>
          <div class="wide actions">
            <button class="btn btn-primary" type="submit">Save DM Settings</button>
          </div>
        </form>
      </section>

      <!-- Telegram Integration -->
      <section class="panel">
        <h2>Telegram Integration &amp; Alerts</h2>
        <p class="panel-sub">
          Enables Telegram Login Widget authentication and sends instant status alerts directly to reporters on Telegram.
        </p>
        <form method="POST" class="rows-2">
          <input type="hidden" name="intent" value="telegram" />
          <input type="hidden" name="tab" value="settings" />
          <div class="field wide">
            <label class="check">
              <input type="checkbox" name="telegram_dm_enabled" value="1" checked={tgDmEnabled} />
              <span>Enable Telegram DM Notifications</span>
            </label>
          </div>
          <div class="field">
            <label class="label" for="telegram_bot_username">Telegram Bot Username (without @)</label>
            <input
              class="input"
              id="telegram_bot_username"
              name="telegram_bot_username"
              value={cfg.telegram_bot_username}
              placeholder="e.g. AnymeXDeskBot"
            />
            <p class="field-hint">Used for the official Telegram login widget on the website.</p>
          </div>
          <div class="field">
            <label class="label" for="telegram_bot_token">Telegram Bot Token</label>
            <input
              class="input"
              id="telegram_bot_token"
              name="telegram_bot_token"
              type="password"
              placeholder={tgTokenSet ? '••••••••  (Saved. Paste new token to replace)' : 'Token from @BotFather'}
              autocomplete="off"
            />
            <p class="field-hint">Issued by @BotFather on Telegram.</p>
          </div>
          <div class="wide actions">
            <button class="btn btn-primary" type="submit">Save Telegram Settings</button>
          </div>
        </form>
      </section>

      <!-- Contributor Discord Server & Forums -->
      <section class="panel">
        <h2>Contributor Discord Server &amp; Forum Sync</h2>
        <p class="panel-sub">
          Automatically bridges reports and suggestions with Discord Forum threads. Bidirectionally syncs comments, edits, closures, and status tags.
        </p>
        <form method="POST" class="rows-2">
          <input type="hidden" name="intent" value="contributor-forums" />
          <input type="hidden" name="tab" value="settings" />
          <div class="field wide">
            <label class="check">
              <input type="checkbox" name="discord_forum_sync_enabled" value="1" checked={forumSyncEnabled} />
              <span>Enable Contributor Forum Synchronization</span>
            </label>
          </div>
          <div class="field">
            <label class="label" for="contributor_guild_id">Contributor Server (Guild) ID</label>
            <input class="input num" id="contributor_guild_id" name="contributor_guild_id" value={cfg.contributor_guild_id} placeholder="1545003117018357850" />
          </div>
          <div class="field">
            <label class="label" for="discord_sync_secret">Inbound Sync Secret</label>
            <input class="input" id="discord_sync_secret" name="discord_sync_secret" type="password" value={cfg.discord_sync_secret} placeholder="Shared secret token for inbound Discord webhook" />
          </div>
          <div class="field">
            <label class="label" for="discord_forum_bugs_id">Bugs Forum Channel ID</label>
            <input class="input num" id="discord_forum_bugs_id" name="discord_forum_bugs_id" value={cfg.discord_forum_bugs_id} placeholder="1545003724961751096" />
          </div>
          <div class="field">
            <label class="label" for="discord_forum_suggestions_id">Suggestions Forum Channel ID</label>
            <input class="input num" id="discord_forum_suggestions_id" name="discord_forum_suggestions_id" value={cfg.discord_forum_suggestions_id} placeholder="1545003626823417906" />
          </div>
          <div class="field wide">
            <label class="label" for="discord_forum_extensions_id">Extension Issues Forum Channel ID</label>
            <input class="input num" id="discord_forum_extensions_id" name="discord_forum_extensions_id" value={cfg.discord_forum_extensions_id} placeholder="1545003859380805702" />
          </div>
          <div class="wide actions">
            <button class="btn btn-primary" type="submit">Save Forum Settings</button>
          </div>
        </form>

        <div class="forum-tools">
          <form method="POST">
            <input type="hidden" name="intent" value="setup-forum-tags" />
            <input type="hidden" name="tab" value="settings" />
            <button class="btn btn-action-with-icon" type="submit">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
              </svg>
              <span>Auto-Generate / Verify Forum Tags on Discord</span>
            </button>
            <p class="field-hint" style="margin-top: 6px;">Creates Open, In Progress, Fixed, Duplicate, and Platform tags across all 3 forum channels.</p>
          </form>

          <form method="POST">
            <input type="hidden" name="intent" value="sync-existing-reports" />
            <input type="hidden" name="tab" value="settings" />
            <button class="btn btn-action-with-icon" type="submit">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
              </svg>
              <span>Sync All Existing Reports to Discord Forums</span>
            </button>
            <p class="field-hint" style="margin-top: 6px;">Creates forum threads for any existing reports that lack one and syncs all comments.</p>
          </form>
        </div>
      </section>
    </div>
  )}
  </>)}
</Base>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Tab Navigation
    const tabs = document.querySelectorAll('[data-tab-trigger]');
    const panes = document.querySelectorAll('[data-tab-pane]');

    function activateTab(targetId) {
      let found = false;
      panes.forEach(pane => {
        if (pane.dataset.tabPane === targetId) {
          pane.classList.add('active');
          pane.hidden = false;
          found = true;
        } else {
          pane.classList.remove('active');
          pane.hidden = true;
        }
      });

      if (!found && panes.length > 0) {
        panes[0].classList.add('active');
        panes[0].hidden = false;
        targetId = panes[0].dataset.tabPane;
      }

      tabs.forEach(tab => {
        const isMatch = tab.dataset.tabTrigger === targetId;
        tab.classList.toggle('active', isMatch);
        tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      document.querySelectorAll('input[type="hidden"][name="tab"]').forEach(input => {
        input.value = targetId;
      });

      try {
        const url = new URL(window.location.href);
        url.searchParams.set('tab', targetId);
        window.history.replaceState({}, '', url.toString());
      } catch (e) {}
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        const tabId = tab.dataset.tabTrigger;
        if (tabId) activateTab(tabId);
      });
    });

    // 2. Add Staff Drawer Toggle
    const toggleAddStaffBtn = document.getElementById('toggle-add-staff-btn');
    const closeAddStaffBtn = document.getElementById('close-add-staff-btn');
    const addStaffDrawer = document.getElementById('add-staff-drawer');
    const discordIdInput = document.getElementById('discord_id');

    function toggleAddStaff(show) {
      if (!addStaffDrawer || !toggleAddStaffBtn) return;
      const isShowing = show !== undefined ? show : addStaffDrawer.hidden;
      addStaffDrawer.hidden = !isShowing;
      toggleAddStaffBtn.classList.toggle('is-open', isShowing);
      toggleAddStaffBtn.setAttribute('aria-expanded', isShowing ? 'true' : 'false');
      if (isShowing && discordIdInput) {
        discordIdInput.focus();
      }
    }

    if (toggleAddStaffBtn) {
      toggleAddStaffBtn.addEventListener('click', () => toggleAddStaff());
    }
    if (closeAddStaffBtn) {
      closeAddStaffBtn.addEventListener('click', () => toggleAddStaff(false));
    }

    // 2b. Add Staff Drawer DB Search Autocomplete
    const addStaffSearch = document.getElementById('add-staff-search');
    const addStaffSuggestions = document.getElementById('add-staff-suggestions');
    const addStaffInput = document.getElementById('discord_id');
    const addStaffItems = document.querySelectorAll('.add-staff-item');

    if (addStaffSearch && addStaffSuggestions && addStaffInput) {
      function filterStaffSuggestions() {
        const q = (addStaffSearch.value || '').trim().toLowerCase();
        let matched = 0;
        addStaffItems.forEach(item => {
          const s = item.getAttribute('data-search') || '';
          const match = !q || s.includes(q);
          item.hidden = !match;
          item.style.display = match ? 'flex' : 'none';
          if (match) matched++;
        });
        if (addStaffSuggestions) {
          addStaffSuggestions.hidden = matched === 0;
        }
      }

      addStaffSearch.addEventListener('focus', () => {
        if (addStaffSuggestions) addStaffSuggestions.hidden = false;
        filterStaffSuggestions();
      });

      addStaffSearch.addEventListener('input', () => {
        if (addStaffSuggestions) addStaffSuggestions.hidden = false;
        filterStaffSuggestions();
      });

      addStaffItems.forEach(item => {
        item.addEventListener('click', () => {
          const id = item.getAttribute('data-user-id');
          const name = item.getAttribute('data-username');
          if (id) {
            addStaffInput.value = id;
            if (addStaffSearch) addStaffSearch.value = `${name} (${id})`;
            if (addStaffSuggestions) addStaffSuggestions.hidden = true;
          }
        });
      });

      document.addEventListener('click', (e) => {
        if (
          addStaffSuggestions &&
          !addStaffSuggestions.contains(e.target) &&
          e.target !== addStaffSearch
        ) {
          addStaffSuggestions.hidden = true;
        }
      });
    }

    // 3. Click to Copy Discord ID
    document.querySelectorAll('[data-copy-id]').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const id = btn.getAttribute('data-copy-id');
        if (!id) return;
        try {
          await navigator.clipboard.writeText(id);
          const originalTitle = btn.getAttribute('title') || '';
          btn.setAttribute('title', 'Copied to clipboard!');
          const label = btn.querySelector('.staff-id');
          if (label) {
            const oldText = label.textContent;
            label.textContent = 'Copied!';
            setTimeout(() => {
              label.textContent = oldText;
              btn.setAttribute('title', originalTitle);
            }, 1200);
          }
        } catch (err) {}
      });
    });

    // 4. Staff Search & Role Filter
    const searchInput = document.getElementById('staff-search');
    const filterChips = document.querySelectorAll('[data-staff-filter]');
    const staffCards = document.querySelectorAll('#staff-card-grid .staff-card');
    const emptySearchMsg = document.getElementById('staff-empty-search');
    let currentRoleFilter = 'all';

    function applyStaffFilters() {
      const query = (searchInput && searchInput.value ? searchInput.value : '').trim().toLowerCase();
      let visibleCount = 0;

      staffCards.forEach(card => {
        const cardRole = card.getAttribute('data-staff-role');
        const cardSearch = card.getAttribute('data-staff-search') || '';

        const matchesRole = currentRoleFilter === 'all' || cardRole === currentRoleFilter;
        const matchesQuery = !query || cardSearch.includes(query);
        const isVisible = matchesRole && matchesQuery;

        card.hidden = !isVisible;
        card.style.display = isVisible ? '' : 'none';
        if (isVisible) visibleCount++;
      });

      if (emptySearchMsg) {
        emptySearchMsg.hidden = visibleCount > 0;
        emptySearchMsg.style.display = visibleCount > 0 ? 'none' : 'block';
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', applyStaffFilters);
    }

    filterChips.forEach(chip => {
      chip.addEventListener('click', () => {
        filterChips.forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        currentRoleFilter = chip.getAttribute('data-staff-filter') || 'all';
        applyStaffFilters();
      });
    });

    // 5. Block User Drawer & DB Search Autocomplete
    const toggleBlockBtn = document.getElementById('toggle-block-user-btn');
    const closeBlockBtn = document.getElementById('close-block-user-btn');
    const blockDrawer = document.getElementById('block-user-drawer');
    const blockUserSearch = document.getElementById('block-user-search');
    const blockUserSuggestions = document.getElementById('block-user-suggestions');
    const blockDiscordIdInput = document.getElementById('block_discord_id');
    const userSuggestItems = document.querySelectorAll('#block-user-suggestions .user-autocomplete-item');

    function toggleBlockDrawer(show) {
      if (!blockDrawer || !toggleBlockBtn) return;
      const isShowing = show !== undefined ? show : blockDrawer.hidden;
      blockDrawer.hidden = !isShowing;
      toggleBlockBtn.classList.toggle('is-open', isShowing);
      toggleBlockBtn.setAttribute('aria-expanded', isShowing ? 'true' : 'false');
      if (isShowing && blockUserSearch) {
        blockUserSearch.focus();
      }
    }

    if (toggleBlockBtn) toggleBlockBtn.addEventListener('click', () => toggleBlockDrawer());
    if (closeBlockBtn) closeBlockBtn.addEventListener('click', () => toggleBlockDrawer(false));

    if (blockUserSearch && blockUserSuggestions && blockDiscordIdInput) {
      function filterUserSuggestions() {
        const q = (blockUserSearch.value || '').trim().toLowerCase();
        let matched = 0;
        userSuggestItems.forEach(item => {
          const s = item.getAttribute('data-search') || '';
          const match = !q || s.includes(q);
          item.hidden = !match;
          item.style.display = match ? 'flex' : 'none';
          if (match) matched++;
        });
        if (blockUserSuggestions) {
          blockUserSuggestions.hidden = matched === 0;
        }
      }

      blockUserSearch.addEventListener('focus', () => {
        if (blockUserSuggestions) blockUserSuggestions.hidden = false;
        filterUserSuggestions();
      });

      blockUserSearch.addEventListener('input', () => {
        if (blockUserSuggestions) blockUserSuggestions.hidden = false;
        filterUserSuggestions();
      });

      userSuggestItems.forEach(item => {
        item.addEventListener('click', () => {
          const id = item.getAttribute('data-user-id');
          const name = item.getAttribute('data-username');
          if (id) {
            blockDiscordIdInput.value = id;
            if (blockUserSearch) blockUserSearch.value = `${name} (${id})`;
            if (blockUserSuggestions) blockUserSuggestions.hidden = true;
          }
        });
      });

      document.addEventListener('click', (e) => {
        if (
          blockUserSuggestions &&
          !blockUserSuggestions.contains(e.target) &&
          e.target !== blockUserSearch
        ) {
          blockUserSuggestions.hidden = true;
        }
      });
    }

    // 6. Add Label Drawer & Live Preview
    const toggleLabelBtn = document.getElementById('toggle-add-label-btn');
    const closeLabelBtn = document.getElementById('close-add-label-btn');
    const labelDrawer = document.getElementById('add-label-drawer');
    const labelNameInput = document.getElementById('label_name');
    const labelColorInput = document.getElementById('label_color');
    const labelLivePreview = document.getElementById('label-live-preview');

    function toggleLabelDrawer(show) {
      if (!labelDrawer || !toggleLabelBtn) return;
      const isShowing = show !== undefined ? show : labelDrawer.hidden;
      labelDrawer.hidden = !isShowing;
      toggleLabelBtn.classList.toggle('is-open', isShowing);
      toggleLabelBtn.setAttribute('aria-expanded', isShowing ? 'true' : 'false');
      if (isShowing && labelNameInput) {
        labelNameInput.focus();
      }
    }

    if (toggleLabelBtn) toggleLabelBtn.addEventListener('click', () => toggleLabelDrawer());
    if (closeLabelBtn) closeLabelBtn.addEventListener('click', () => toggleLabelDrawer(false));

    function updateLabelPreview() {
      if (!labelLivePreview) return;
      const name = (labelNameInput && labelNameInput.value ? labelNameInput.value : '').trim() || 'preview';
      const color = (labelColorInput && labelColorInput.value ? labelColorInput.value : '') || '#6366f1';
      labelLivePreview.textContent = name;
      labelLivePreview.style.background = `${color}22`;
      labelLivePreview.style.borderColor = color;
      labelLivePreview.style.color = color;
    }

    if (labelNameInput) labelNameInput.addEventListener('input', updateLabelPreview);
    if (labelColorInput) labelColorInput.addEventListener('input', updateLabelPreview);

    // 7. View as Role Dropdown
    const viewAsBtn = document.getElementById('view-as-toggle-btn');
    const viewAsMenu = document.getElementById('view-as-menu');

    if (viewAsBtn && viewAsMenu) {
      viewAsBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = viewAsMenu.hidden;
        viewAsMenu.hidden = !open;
        viewAsBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });

      document.addEventListener('click', (e) => {
        if (!viewAsMenu.contains(e.target) && !viewAsBtn.contains(e.target)) {
          viewAsMenu.hidden = true;
          viewAsBtn.setAttribute('aria-expanded', 'false');
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !viewAsMenu.hidden) {
          viewAsMenu.hidden = true;
          viewAsBtn.setAttribute('aria-expanded', 'false');
          viewAsBtn.focus();
        }
      });
    }

    // 8. Users Directory Live Search & Filter
    const usersSearchInput = document.getElementById('users-dir-search');
    const userFilterChips = document.querySelectorAll('[data-user-filter]');
    const userRows = document.querySelectorAll('.user-dir-row');
    let currentUserFilter = 'all';

    function applyUserFilters() {
      const q = (usersSearchInput ? usersSearchInput.value : '').trim().toLowerCase();

      userRows.forEach(row => {
        const text = (row.getAttribute('data-search') || '').toLowerCase();
        const platform = row.getAttribute('data-platform') || '';
        const role = row.getAttribute('data-role') || '';
        const isBanned = row.getAttribute('data-banned') === 'true';

        let matchesFilter = true;
        if (currentUserFilter === 'dual') matchesFilter = platform === 'dual';
        else if (currentUserFilter === 'discord') matchesFilter = platform === 'discord' || platform === 'dual';
        else if (currentUserFilter === 'telegram') matchesFilter = platform === 'telegram' || platform === 'dual';
        else if (currentUserFilter === 'staff') matchesFilter = role === 'owner' || role === 'admin' || role === 'mod';
        else if (currentUserFilter === 'banned') matchesFilter = isBanned;

        const matchesSearch = !q || text.includes(q);
        const visible = matchesFilter && matchesSearch;

        row.hidden = !visible;
        row.style.display = visible ? '' : 'none';
      });
    }

    if (usersSearchInput) {
      usersSearchInput.addEventListener('input', applyUserFilters);
    }

    userFilterChips.forEach(chip => {
      chip.addEventListener('click', () => {
        userFilterChips.forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        currentUserFilter = chip.getAttribute('data-user-filter') || 'all';
        applyUserFilters();
      });
    });
  });
</script>

