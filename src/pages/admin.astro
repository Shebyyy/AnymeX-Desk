---
import Base from '../layouts/Base.astro';
import { env } from 'cloudflare:workers';
import { desc, eq, isNotNull, or, sql } from 'drizzle-orm';
import { db } from '../lib/db/client';
import { audit, labels, STAFF_LEVELS, users, type StaffLevel } from '../lib/db/schema';
import { avatarUrl, snowflakeCreatedAt } from '../lib/auth';
import { LEVEL_LABELS, combine, atLeast, RANK } from '../lib/levels';
import { idList, readConfig, writeSettings } from '../lib/settings';
import { isOwner, isResponse, levelOf, logAction, requireStaff, setManualLevel } from '../lib/staff';
import { testWebhook } from '../lib/webhook';
import { ensureForumTags, syncExistingReports } from '../lib/discord-forums';
import { relativeAge } from '../lib/format';

export const prerender = false;

/**
 * Staff Dashboard.
 *
 * Accessible to Staff (mod, admin, owner).
 * Permissions:
 * - Owner: Full authority (can add/remove admins & mods, manage Discord roles, and edit sensitive integration secrets/tokens).
 * - Admin: Moderation authority (can add/remove mods, manage account-age gate, blocked users, report labels, CSV export). Cannot touch admins or environment secrets.
 * - Moderator: View-only dashboard access (can review audit logs and staff directory; directed to /triage for report actions).
 *
 * Supports View as Role simulation mode (with strict tiered rules: Owner tests all, Admin tests Admin & below, Mod tests Mod & below).
 */
const gate = await requireStaff(Astro, 'mod', true);
if (isResponse(gate)) return gate;
const { user, level, realLevel, isPreview } = gate;

const isOwnerUser = level === 'owner';
const isAdminUser = atLeast(level, 'admin');
const isModUser = level === 'mod';
const isSimulatingMember = level === 'user';

// Strict tiered allowed preview roles for this user
const ALL_ROLES = ['owner', 'admin', 'mod', 'user'] as const;
const allowedPreviewRoles = ALL_ROLES.filter((r) => RANK[r] <= RANK[realLevel]);

// Role-based allowed tabs
const allowedTabs: string[] = isOwnerUser
  ? ['staff', 'users', 'moderation', 'audit', 'settings']
  : isAdminUser
    ? ['staff', 'users', 'moderation', 'audit']
    : ['staff', 'users', 'audit'];

const ownerDiscordId = env.OWNER_DISCORD_ID ? String(env.OWNER_DISCORD_ID).trim() : null;

// Helper to resolve user across Discord ID, Telegram ID, @username, or internal ID
async function resolveTargetUser(raw: string) {
  const input = raw.trim();
  if (!input) return null;
  const cleanHandle = input.replace(/^@/, '').toLowerCase();

  // 1. Direct query against existing users
  const [existing] = await db()
    .select()
    .from(users)
    .where(
      or(
        eq(users.discordId, input),
        eq(users.telegramId, input),
        eq(users.discordId, `tg:${input}`),
        eq(sql`lower(${users.telegramUsername})`, cleanHandle),
        eq(sql`lower(${users.username})`, cleanHandle)
      )
    )
    .limit(1);

  if (existing) {
    return { type: 'existing' as const, user: existing };
  }

  // 2. Discord Snowflake (17-20 digits)
  if (/^\d{17,20}$/.test(input)) {
    return { type: 'discord_snowflake' as const, id: input };
  }

  // 3. Telegram Numeric ID (5-15 digits) or tg:<digits>
  const tgMatch = input.match(/^(?:tg:)?(\d{5,15})$/);
  if (tgMatch) {
    return { type: 'telegram_id' as const, id: tgMatch[1] };
  }

  return null;
}

let error: string | null = null;
let done: string | null = null;
let postedTab: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  postedTab = String(form.get('tab') ?? '');
  const origin = Astro.url.origin;

  if (isModUser) {
    error = 'Moderators have view-only access to the dashboard. Please use the triage queue for report management.';
  } else if (intent === 'roles') {
    if (!isOwnerUser) {
      error = 'Only the owner can configure Discord staff role mappings.';
    } else {
      const mod = idList(String(form.get('mod_role_ids') ?? '')).join(',');
      const admin = idList(String(form.get('admin_role_ids') ?? '')).join(',');
      await writeSettings({ mod_role_ids: mod, admin_role_ids: admin }, user.id);
      await logAction(user, 'settings.roles', null, `mod=[${mod}] admin=[${admin}]`);
      done = 'Discord role mapping saved. It applies to each person the next time they sign in.';
    }
  } else if (intent === 'gate') {
    const days = Math.max(0, Math.min(3650, Number(form.get('min_account_age_days') ?? 30)));
    await writeSettings({ min_account_age_days: String(days) }, user.id);
    await logAction(user, 'settings.gate', null, `min_account_age_days=${days}`);
    done = `Accounts must now be ${days} days old to post or vote.`;
  } else if (intent === 'webhook') {
    if (!isOwnerUser) {
      error = 'Only the owner can view or modify announcement webhook settings.';
    } else {
      const raw = String(form.get('webhook_url') ?? '').trim();
      const onFixed = form.get('webhook_on_fixed') === '1' ? '1' : '0';
      const onNewReport = form.get('webhook_on_new_report') === '1' ? '1' : '0';
      const threshold = Math.max(0, Math.min(9999, Number(form.get('webhook_vote_threshold') ?? 0)));
      const patch: Record<string, string> = {
        webhook_on_fixed: onFixed,
        webhook_on_new_report: onNewReport,
        webhook_vote_threshold: String(threshold),
      };
      if (raw === '__clear__') {
        patch.webhook_url = '';
      } else if (raw) {
        if (!/^https:\/\/(discord\.com|discordapp\.com)\/api\/webhooks\//.test(raw)) {
          error = 'That is not a Discord webhook URL. Copy it from Channel → Edit Channel → Integrations → Webhooks.';
        } else {
          patch.webhook_url = raw;
        }
      }
      if (!error) {
        await writeSettings(patch, user.id);
        await logAction(user, 'settings.webhook', null,
          `${patch.webhook_url === '' ? 'cleared' : raw ? 'replaced' : 'unchanged'}, on_fixed=${onFixed}, on_new_report=${onNewReport}, threshold=${threshold}`);
        done = 'Announcement settings saved.';
      }
    }
  } else if (intent === 'webhook-test') {
    if (!isOwnerUser) {
      error = 'Only the owner can trigger webhook test messages.';
    } else {
      const cfg = await readConfig();
      if (!cfg.webhook_url) {
        error = 'Save a webhook URL first.';
      } else {
        const res = await testWebhook(cfg.webhook_url, origin, user.username);
        done = res.ok ? 'Test message sent. Check the channel.' : null;
        error = res.ok ? null : `Discord rejected it (${res.status}). ${res.body.slice(0, 200)}`;
      }
    }
  } else if (intent === 'dm') {
    if (!isOwnerUser) {
      error = 'Only the owner can modify Discord DM notification settings and bot tokens.';
    } else {
      const dmEnabled = form.get('discord_dm_enabled') === '1' ? '1' : '0';
      const botToken = String(form.get('discord_bot_token') ?? '').trim();
      const patch: Record<string, string> = { discord_dm_enabled: dmEnabled };
      if (botToken && botToken !== '••••••••') {
        patch.discord_bot_token = botToken;
      }
      await writeSettings(patch, user.id);
      await logAction(user, 'settings.dm', null, `enabled=${dmEnabled}, token=${botToken ? 'changed' : 'unchanged'}`);
      done = 'DM notification settings saved.';
    }
  } else if (intent === 'telegram') {
    if (!isOwnerUser) {
      error = 'Only the owner can modify Telegram credentials and settings.';
    } else {
      const tgDmEnabled = form.get('telegram_dm_enabled') === '1' ? '1' : '0';
      const tgToken = String(form.get('telegram_bot_token') ?? '').trim();
      const tgUsername = String(form.get('telegram_bot_username') ?? '').trim().replace(/^@/, '');
      const patch: Record<string, string> = {
        telegram_dm_enabled: tgDmEnabled,
        telegram_bot_username: tgUsername,
      };
      if (tgToken && tgToken !== '••••••••') {
        patch.telegram_bot_token = tgToken;
      }
      await writeSettings(patch, user.id);
      await logAction(user, 'settings.telegram', null, `username=${tgUsername}, token=${tgToken ? 'changed' : 'unchanged'}`);
      done = 'Telegram settings saved.';
    }
  } else if (intent === 'contributor-forums') {
    if (!isOwnerUser) {
      error = 'Only the owner can modify contributor forum synchronization settings.';
    } else {
      const syncEnabled = form.get('discord_forum_sync_enabled') === '1' ? '1' : '0';
      const guildId = String(form.get('contributor_guild_id') ?? '').trim();
      const bugsId = String(form.get('discord_forum_bugs_id') ?? '').trim();
      const suggestionsId = String(form.get('discord_forum_suggestions_id') ?? '').trim();
      const extensionsId = String(form.get('discord_forum_extensions_id') ?? '').trim();
      const syncSecret = String(form.get('discord_sync_secret') ?? '').trim();

      const patch: Record<string, string> = {
        discord_forum_sync_enabled: syncEnabled,
        contributor_guild_id: guildId,
        discord_forum_bugs_id: bugsId,
        discord_forum_suggestions_id: suggestionsId,
        discord_forum_extensions_id: extensionsId,
        discord_sync_secret: syncSecret,
      };
      await writeSettings(patch, user.id);
      await logAction(user, 'settings.forums', null, `enabled=${syncEnabled}, guild=${guildId}`);
      done = 'Contributor forum settings saved.';
    }
  } else if (intent === 'setup-forum-tags') {
    if (!isOwnerUser) {
      error = 'Only the owner can trigger forum tag generation.';
    } else {
      const cfg = await readConfig();
      if (!cfg.discord_bot_token) {
        error = 'Please enter and save your Bot Token in the Settings & Secrets tab first.';
      } else {
        let count = 0;
        if (cfg.discord_forum_bugs_id) {
          await ensureForumTags(cfg.discord_forum_bugs_id, cfg.discord_bot_token, 'bug');
          count++;
        }
        if (cfg.discord_forum_suggestions_id) {
          await ensureForumTags(cfg.discord_forum_suggestions_id, cfg.discord_bot_token, 'suggestion');
          count++;
        }
        if (cfg.discord_forum_extensions_id) {
          await ensureForumTags(cfg.discord_forum_extensions_id, cfg.discord_bot_token, 'extension');
          count++;
        }
        done = `Successfully verified and auto-created forum tags across ${count} channel(s)!`;
      }
    }
  } else if (intent === 'sync-existing-reports') {
    if (!isOwnerUser) {
      error = 'Only the owner can run forum synchronization.';
    } else {
      const res = await syncExistingReports(origin, 50);
      done = `Sync completed: ${res.success} new report thread(s) created, ${res.commentsSynced} comment(s) posted to Discord!`;
    }
  } else if (intent === 'block') {
    const targetInput = String(form.get('discord_id') ?? form.get('target') ?? '').trim();
    const blocked = form.get('blocked') === '1';
    const resolved = await resolveTargetUser(targetInput);

    if (!resolved) {
      error = `Could not find an account matching "${targetInput}". To pre-block an unregistered user before their first sign-in, please provide their 17-20 digit Discord User ID or numeric Telegram ID.`;
    } else if (resolved.type === 'existing') {
      const u = resolved.user;
      const isTargetOwner = isOwner(u.discordId) || (ownerDiscordId && (u.discordId === ownerDiscordId || u.telegramId === ownerDiscordId));
      if (isTargetOwner) {
        error = 'The owner cannot be blocked.';
      } else if (u.discordId === user.id || (u.telegramId && u.telegramId === user.telegramId)) {
        error = "You can't block yourself.";
      } else {
        await db()
          .update(users)
          .set({ banned: blocked })
          .where(eq(users.discordId, u.discordId));

        const tgLabel = u.telegramUsername ? `@${u.telegramUsername}` : u.telegramId ? `TG:${u.telegramId}` : null;
        const dcLabel = !u.discordId.startsWith('tg:') && u.discordLinked !== false ? `DC:${u.discordId}` : null;
        const linkedInfo = [dcLabel, tgLabel].filter(Boolean).join(' | ');

        await logAction(
          user,
          blocked ? 'user.block' : 'user.unblock',
          u.discordId,
          `${u.username}${linkedInfo ? ` (${linkedInfo})` : ''}`
        );
        done = blocked
          ? `${u.username} has been blocked. They can no longer post or vote across Discord or Telegram.`
          : `${u.username} can post and vote again.`;
      }
    } else if (resolved.type === 'discord_snowflake') {
      if (isOwner(resolved.id) || (ownerDiscordId && resolved.id === ownerDiscordId)) {
        error = 'The owner cannot be blocked.';
      } else if (resolved.id === user.id) {
        error = "You can't block yourself.";
      } else {
        await db()
          .insert(users)
          .values({
            discordId: resolved.id,
            username: 'not signed in yet',
            accountCreatedAt: Math.floor(snowflakeCreatedAt(resolved.id)),
            banned: blocked,
          })
          .onConflictDoUpdate({ target: users.discordId, set: { banned: blocked } });
        await logAction(user, blocked ? 'user.block' : 'user.unblock', resolved.id, 'Pre-registered Discord snowflake');
        done = blocked
          ? `Discord snowflake ${resolved.id} is blocked (pre-registered).`
          : `Discord snowflake ${resolved.id} unblocked.`;
      }
    } else if (resolved.type === 'telegram_id') {
      const internalId = `tg:${resolved.id}`;
      if (ownerDiscordId && (internalId === ownerDiscordId || resolved.id === ownerDiscordId)) {
        error = 'The owner cannot be blocked.';
      } else if (user.telegramId === resolved.id || user.id === internalId) {
        error = "You can't block yourself.";
      } else {
        await db()
          .insert(users)
          .values({
            discordId: internalId,
            username: `Telegram User ${resolved.id.slice(-4)}`,
            accountCreatedAt: Math.floor(Date.now() / 1000),
            telegramId: resolved.id,
            banned: blocked,
          })
          .onConflictDoUpdate({ target: users.discordId, set: { banned: blocked } });
        await logAction(user, blocked ? 'user.block' : 'user.unblock', internalId, `Pre-registered Telegram ID ${resolved.id}`);
        done = blocked
          ? `Telegram user ${resolved.id} is blocked (pre-registered). When they sign in, they will be blocked.`
          : `Telegram user ${resolved.id} unblocked.`;
      }
    }
  } else if (intent === 'staff-set') {
    const targetInput = String(form.get('discord_id') ?? form.get('target') ?? '').trim();
    const wanted = String(form.get('level') ?? '');
    const newLevel = (STAFF_LEVELS as readonly string[]).includes(wanted)
      ? (wanted as StaffLevel)
      : null;
    const resolved = await resolveTargetUser(targetInput);

    if (!resolved) {
      error = `Could not find an account matching "${targetInput}". Provide a valid Discord snowflake (17-20 digits), Telegram User ID, or registered username.`;
    } else if (resolved.type === 'existing') {
      const u = resolved.user;
      const targetCurrentLevel = await levelOf(u.discordId);
      const isTargetOwner = isOwner(u.discordId) || (ownerDiscordId && (u.discordId === ownerDiscordId || u.telegramId === ownerDiscordId));

      if ((u.discordId === user.id || (u.telegramId && u.telegramId === user.telegramId)) && !isOwnerUser) {
        error = "You can't change your own level. Ask the owner, or edit OWNER_DISCORD_ID.";
      } else if (isTargetOwner) {
        error = 'The owner cannot be demoted or modified from here.';
      } else if (!isOwnerUser && (newLevel === 'admin' || targetCurrentLevel === 'admin' || targetCurrentLevel === 'owner')) {
        error = 'Only the owner can add, promote, or remove administrators. Admins may only add or remove moderators.';
      } else {
        await setManualLevel(u.discordId, newLevel);
        const nameLabel = u.telegramUsername ? `${u.username} (@${u.telegramUsername})` : u.username;
        await logAction(user, newLevel ? 'staff.grant' : 'staff.revoke', u.discordId, newLevel ?? 'none');
        done = newLevel
          ? `Granted ${LEVEL_LABELS[newLevel]} to ${nameLabel}.`
          : `Removed the manual grant from ${nameLabel}.`;
      }
    } else if (resolved.type === 'discord_snowflake') {
      const targetCurrentLevel = await levelOf(resolved.id);
      if (resolved.id === user.id && !isOwnerUser) {
        error = "You can't change your own level.";
      } else if (isOwner(resolved.id)) {
        error = 'The owner cannot be modified.';
      } else if (!isOwnerUser && (newLevel === 'admin' || targetCurrentLevel === 'admin' || targetCurrentLevel === 'owner')) {
        error = 'Only the owner can add, promote, or remove administrators.';
      } else {
        await db()
          .insert(users)
          .values({
            discordId: resolved.id,
            username: 'not signed in yet',
            accountCreatedAt: Math.floor(snowflakeCreatedAt(resolved.id)),
            manualLevel: newLevel,
          })
          .onConflictDoNothing();
        await setManualLevel(resolved.id, newLevel);
        await logAction(user, newLevel ? 'staff.grant' : 'staff.revoke', resolved.id, newLevel ?? 'none');
        done = newLevel
          ? `Granted ${LEVEL_LABELS[newLevel]} to Discord user ${resolved.id}.`
          : `Removed the manual grant from Discord user ${resolved.id}.`;
      }
    } else if (resolved.type === 'telegram_id') {
      const internalId = `tg:${resolved.id}`;
      const targetCurrentLevel = await levelOf(internalId);
      if (!isOwnerUser && (newLevel === 'admin' || targetCurrentLevel === 'admin' || targetCurrentLevel === 'owner')) {
        error = 'Only the owner can add, promote, or remove administrators.';
      } else {
        await db()
          .insert(users)
          .values({
            discordId: internalId,
            username: `Telegram User ${resolved.id.slice(-4)}`,
            accountCreatedAt: Math.floor(Date.now() / 1000),
            telegramId: resolved.id,
            manualLevel: newLevel,
          })
          .onConflictDoNothing();
        await setManualLevel(internalId, newLevel);
        await logAction(user, newLevel ? 'staff.grant' : 'staff.revoke', internalId, newLevel ?? 'none');
        done = newLevel
          ? `Granted ${LEVEL_LABELS[newLevel]} to Telegram user ${resolved.id}.`
          : `Removed the manual grant from Telegram user ${resolved.id}.`;
      }
    }
  } else if (intent === 'label_create') {
    const name = String(form.get('name') ?? '').trim().toLowerCase().replace(/[^a-z0-9_-]/g, '-').slice(0, 32);
    const color = String(form.get('color') ?? '#6b7280').trim().slice(0, 16);
    if (!name) {
      error = 'Label name is required.';
    } else {
      await db().insert(labels).values({ name, color }).onConflictDoNothing();
      await logAction(user, 'label.create', name, color);
      done = `Label "${name}" created.`;
    }
  } else if (intent === 'label_delete') {
    const labelId = Number(form.get('label_id'));
    if (Number.isSafeInteger(labelId) && labelId > 0) {
      const [deleted] = await db().delete(labels).where(eq(labels.id, labelId)).returning();
      if (deleted) {
        await logAction(user, 'label.delete', deleted.name);
        done = `Label "${deleted.name}" deleted.`;
      }
    }
  }
}

// Determine active tab
const urlTab = Astro.url.searchParams.get('tab');
const requestedTab = postedTab || urlTab;
let activeTab = requestedTab && allowedTabs.includes(requestedTab) ? requestedTab : allowedTabs[0];

const staffFilter = ownerDiscordId
  ? or(isNotNull(users.discordLevel), isNotNull(users.manualLevel), eq(users.discordId, ownerDiscordId))
  : or(isNotNull(users.discordLevel), isNotNull(users.manualLevel));

const [cfg, rawStaff, blocked, log, allLabels, allUsersList] = await Promise.all([
  readConfig(),
  db()
    .select({
      discordId: users.discordId,
      username: users.username,
      avatarHash: users.avatarHash,
      discordLevel: users.discordLevel,
      manualLevel: users.manualLevel,
      lastLogin: users.lastLogin,
      telegramId: users.telegramId,
      telegramUsername: users.telegramUsername,
      telegramPhotoUrl: users.telegramPhotoUrl,
    })
    .from(users)
    .where(staffFilter),
  db()
    .select({
      discordId: users.discordId,
      username: users.username,
      telegramId: users.telegramId,
      telegramUsername: users.telegramUsername,
      telegramPhotoUrl: users.telegramPhotoUrl,
      avatarHash: users.avatarHash,
    })
    .from(users)
    .where(eq(users.banned, true)),
  db().select().from(audit).orderBy(desc(audit.createdAt)).limit(50),
  db().select().from(labels).orderBy(labels.name),
  db()
    .select({
      discordId: users.discordId,
      username: users.username,
      avatarHash: users.avatarHash,
      discordLevel: users.discordLevel,
      manualLevel: users.manualLevel,
      discordLinked: users.discordLinked,
      telegramId: users.telegramId,
      telegramUsername: users.telegramUsername,
      telegramPhotoUrl: users.telegramPhotoUrl,
      banned: users.banned,
      firstSeen: users.firstSeen,
      lastLogin: users.lastLogin,
      accountCreatedAt: users.accountCreatedAt,
    })
    .from(users)
    .orderBy(desc(users.lastLogin))
    .limit(300),
]);

const recentUsers = allUsersList;

const fmtDate = (timestamp: number | null) => {
  if (!timestamp) return 'Never';
  const d = new Date(timestamp * 1000);
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
};

const dualLinkedUsersCount = allUsersList.filter(
  (u) => !u.discordId.startsWith('tg:') && u.discordLinked !== false && !!u.telegramId
).length;

const discordOnlyUsersCount = allUsersList.filter(
  (u) => !u.discordId.startsWith('tg:') && u.discordLinked !== false && !u.telegramId
).length;

const telegramOnlyUsersCount = allUsersList.filter(
  (u) => !!u.telegramId && (u.discordId.startsWith('tg:') || u.discordLinked === false)
).length;

const bannedUsersCount = allUsersList.filter((u) => u.banned).length;

const staffUsersCount = allUsersList.filter(
  (u) =>
    isOwner(u.discordId) ||
    (ownerDiscordId && (u.discordId === ownerDiscordId || u.telegramId === ownerDiscordId)) ||
    u.discordLevel ||
    u.manualLevel
).length;

let staffList = [...rawStaff];
if (ownerDiscordId && !staffList.some((s) => s.discordId === ownerDiscordId)) {
  staffList.push({
    discordId: ownerDiscordId,
    username: user.id === ownerDiscordId ? user.username : 'Owner',
    avatarHash: user.id === ownerDiscordId ? user.avatarHash : null,
    discordLevel: null,
    manualLevel: 'owner' as any,
    lastLogin: user.id === ownerDiscordId ? Math.floor(Date.now() / 1000) : null,
  });
}

// Sort staff: Owner first, then Admins, then Mods
const staff = staffList.sort((a, b) => {
  const effA = isOwner(a.discordId) ? 'owner' : combine(a.discordLevel, a.manualLevel);
  const effB = isOwner(b.discordId) ? 'owner' : combine(b.discordLevel, b.manualLevel);
  const rank: Record<string, number> = { owner: 3, admin: 2, mod: 1, user: 0 };
  return (rank[effB] ?? 0) - (rank[effA] ?? 0);
});

// Secrets metadata (Only used if user is Owner)
const webhookSet = !!cfg.webhook_url;
const webhookTail = webhookSet ? cfg.webhook_url.slice(-6) : '';
const dmEnabled = cfg.discord_dm_enabled === '1';
const botTokenSet = !!cfg.discord_bot_token;
const tgDmEnabled = cfg.telegram_dm_enabled === '1';
const tgTokenSet = !!cfg.telegram_bot_token;
const forumSyncEnabled = cfg.discord_forum_sync_enabled === '1';
---

<Base title="Staff Dashboard">
  <header class="head">
    <div class="head-content">
      <div>
        <div class="title-row">
          <h1>Staff Dashboard</h1>
          <span class={`role-badge role-${level}`}>
            {LEVEL_LABELS[level]}
          </span>
        </div>
        <p class="sub">
          Signed in as <b>{user.username}</b>.
          {level === 'owner' && ' You have full root authority over staff, moderation, and system secrets.'}
          {level === 'admin' && ' You have administrator access for managing moderators, moderation policies, and reports.'}
          {level === 'mod' && ' You have moderator access. You can view the audit log and staff roster.'}
        </p>
      </div>

      <div class="head-quick-actions">
        <!-- View as Role Switcher -->
        <div class="view-as-wrap">
          <button type="button" class="btn btn-ghost view-as-btn" id="view-as-toggle-btn" aria-expanded="false" aria-haspopup="true">
