          </div>
          <div class="field wide">
            <label class="label" for="discord_forum_extensions_id">Extension Issues Forum Channel ID</label>
            <input class="input num" id="discord_forum_extensions_id" name="discord_forum_extensions_id" value={cfg.discord_forum_extensions_id} placeholder="1545003859380805702" />
