---
import Base from '../layouts/Base.astro';
import ChatRoom from '../components/ChatRoom.svelte';
import { currentUser } from '../lib/auth';
import { levelOf, atLeast } from '../lib/staff';

export const prerender = false;

const user = await currentUser(Astro);
const isStaff = user ? atLeast(await levelOf(user.id), 'mod') : false;

const currentUserProp = user
  ? {
      id: user.id,
      username: user.username,
      avatarHash: user.avatarHash,
      isStaff,
    }
  : null;
const rawChannel = Astro.url.searchParams.get('channel') || Astro.url.searchParams.get('c') || '';
---

<Base
  title="Support & Community Lounge · AnymeX Desk"
  description="Live discussion, support, and community talk for AnymeX Desk"
  fullWidth={true}
  noFooter={true}
>
  <ChatRoom client:load currentUser={currentUserProp} initialChannel={rawChannel} />
</Base>