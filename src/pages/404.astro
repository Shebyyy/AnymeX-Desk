---
import Base from '../layouts/Base.astro';

export const prerender = false;

Astro.response.status = 404;
---

<Base title="Page not found" narrow>
  <h1>That link doesn't go anywhere</h1>
  <p>
    This report may have been deleted or merged into another one. Nothing has
    broken on your end.
  </p>

  <p class="actions">
    <a class="btn btn-primary btn-lg" href="/">Bugs</a>
    <a class="btn btn-lg" href="/?kind=suggestion">Suggestions</a>
    <a class="btn btn-lg" href="/new">File a report</a>
  </p>
</Base>

<style>
  h1 { font-size: var(--text-xl); margin-block-end: var(--space-3); }
  p { color: var(--text-secondary); }

  .actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-block-start: var(--space-6);
  }
</style>
