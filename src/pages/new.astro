---
import Base from '../layouts/Base.astro';
import {
  KINDS,
  KIND_LABELS,
  BUG_CATEGORIES,
  SUGGESTION_CATEGORIES,
  EXTENSION_SOURCES,
  CATEGORY_LABELS,
  PLATFORMS,
  PLATFORM_LABELS,
  normalizeTitle,
  reports,
  OPEN_STATUSES,
} from '../lib/db/schema';
import { canWriteNow, currentUser } from '../lib/auth';
import { ensureVote } from '../lib/vote';
import { FILING_COOLDOWN_MESSAGE, overFilingLimit, findDuplicate } from '../lib/writes';
import { announceFiled } from '../lib/webhook';
import { logAction } from '../lib/staff';
import { db } from '../lib/db/client';
import { sql } from 'drizzle-orm';

export const prerender = false;

const user = await currentUser(Astro);

let error: string | null = null;
let resumed = false;
let dedupHit: { id: number; title: string; votes: number } | null = null;

type Draft = {
  kind: string;
  category: string;
  platform: string;
  appVersion: string;
  title: string;
  body: string;
  stepsToReproduce: string;
  testedNativeApp: boolean;
  extensionNames: string;
  extensionRepo: string;
};

let posted: Draft | null = null;

/* ---------------------------------------------------------------------------
   POST. Filing a bug report or feature suggestion for AnymeX.
   ------------------------------------------------------------------------ */
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const kind = String(form.get('kind') ?? 'bug').trim();
  const category = String(form.get('category') ?? '').trim();
  const platform = String(form.get('platform') ?? '').trim();
  const appVersion = String(form.get('appVersion') ?? '').trim().slice(0, 32);
  const title = String(form.get('title') ?? '').trim().slice(0, 200);
  const body = String(form.get('body') ?? '').trim().slice(0, 5000);
  const stepsToReproduce = String(form.get('stepsToReproduce') ?? '').trim().slice(0, 5000);
  const testedNativeApp = form.get('testedNativeApp') === 'on';
  const extensionNames = String(form.get('extensionNames') ?? '').trim().slice(0, 4000);
  const extensionRepo = String(form.get('extensionRepo') ?? '').trim().slice(0, 2000);

  const isAjax = Astro.request.headers.get('accept') === 'application/json';

  const submitted: Draft = {
    kind,
    category,
    platform,
    appVersion,
    title,
    body,
    stepsToReproduce,
    testedNativeApp,
    extensionNames,
    extensionRepo,
  };

  if (!user) {
    if (isAjax) return json({ error: 'sign-in' }, 401);
    Astro.session?.set('pending_report', submitted);
    return Astro.redirect('/auth/discord?next=/new', 302);
  }
  if (!(await canWriteNow(user))) {
    if (isAjax) return json({ error: 'banned' }, 403);
    return Astro.redirect('/cant-post', 302);
  }

  posted = submitted;

  const validKinds = KINDS as readonly string[];
  const validCats =
    kind === 'suggestion'
      ? (SUGGESTION_CATEGORIES as readonly string[])
      : kind === 'extension'
        ? (EXTENSION_SOURCES as readonly string[])
        : (BUG_CATEGORIES as readonly string[]);
  const validPlatforms = PLATFORMS as readonly string[];

  if (!validKinds.includes(kind)) {
    error = 'Pick a type: bug, suggestion, or extension issue.';
  } else if (!validCats.includes(category)) {
    error = kind === 'extension' ? 'Pick which source the extension is for.' : 'Pick a category.';
  } else if (!validPlatforms.includes(platform)) {
    error = 'Pick a platform.';
  } else if (!title || title.length < 5) {
    error = 'Give your report a title, at least 5 characters.';
  } else if (kind === 'extension' && !testedNativeApp) {
    error = 'Confirm you tested the extension in its native app and the issue only happens in AnymeX.';
  } else if (kind === 'extension' && !extensionNames) {
    error = 'Enter the exact name of the affected extension(s).';
  } else if (kind === 'extension' && !body) {
    error = 'Describe what is wrong with the extension.';
  } else if (await overFilingLimit(user.id)) {
    error = FILING_COOLDOWN_MESSAGE;
  } else {
    // Check dedup.
    const dup = await findDuplicate(kind, category, platform, normalizeTitle(title));
    if (dup) {
      await ensureVote(dup.id, user.id);
      const log = logAction(
        user,
        'report.join_duplicate',
        `report #${dup.id}`,
        normalizeTitle(title),
        `${Astro.url.origin}/report/${dup.id}`,
      );
      const cf1 = Astro.locals.cfContext;
      if (cf1) cf1.waitUntil(log);
      else await log;
      if (isAjax) return json({ id: dup.id, joined: true }, 200);
      return Astro.redirect(`/report/${dup.id}?joined=1`, 303);
    }

    const [created] = await db()
      .insert(reports)
      .values({
        kind,
        category,
        platform,
        appVersion: appVersion || null,
        title: normalizeTitle(title),
        body: body || null,
        stepsToReproduce: kind === 'bug' ? (stepsToReproduce || null) : null,
        testedNativeApp: kind === 'extension' ? testedNativeApp : null,
        extensionNames: kind === 'extension' ? (extensionNames || null) : null,
        extensionRepo: kind === 'extension' ? (extensionRepo || null) : null,
        reporterId: user.id,
      })
      .returning({
        id: reports.id,
        kind: reports.kind,
        title: reports.title,
        body: reports.body,
        category: reports.category,
        platform: reports.platform,
        appVersion: reports.appVersion,
        reporterId: reports.reporterId,
      });

    if (created) {
      await ensureVote(created.id, user.id);
      const after: Promise<unknown>[] = [
        announceFiled(created, Astro.url.origin),
        logAction(
          user,
          'report.file',
          `report #${created.id}`,
          `${created.kind}: ${created.title}`,
          `${Astro.url.origin}/report/${created.id}`,
        ),
      ];
      const cf = Astro.locals.cfContext;
      if (cf) for (const task of after) cf.waitUntil(task);
      else await Promise.all(after);

      // Return JSON for AJAX submissions so the client can upload files next.
      if (Astro.request.headers.get('accept') === 'application/json') {
        return new Response(JSON.stringify({ id: created.id }), {
          status: 200,
          headers: { 'content-type': 'application/json' },
        });
      }
      return Astro.redirect(`/report/${created.id}?filed=1`, 303);
    }
  }

  // For AJAX requests with validation errors, return JSON instead of re-rendering.
  if (isAjax && error) {
    return new Response(JSON.stringify({ error }), {
      status: 400,
      headers: { 'content-type': 'application/json' },
    });
  }
}

/* --- GET ---------------------------------------------------------------- */
const draft = (await Astro.session?.get('pending_report')) as Draft | undefined;
if (draft) {
  Astro.session?.delete('pending_report');
  resumed = true;
}

const queryKind = Astro.url.searchParams.get('kind') ?? '';
const kindLocked = queryKind === 'bug' || queryKind === 'suggestion' || queryKind === 'extension';

const shown = {
  kind: posted?.kind || draft?.kind || queryKind || 'bug',
  category: posted?.category || draft?.category || '',
  platform: posted?.platform || draft?.platform || '',
  appVersion: posted?.appVersion || draft?.appVersion || '',
  title: posted?.title || draft?.title || '',
  body: posted?.body || draft?.body || '',
  stepsToReproduce: posted?.stepsToReproduce || draft?.stepsToReproduce || '',
  testedNativeApp: posted?.testedNativeApp || draft?.testedNativeApp || false,
  extensionNames: posted?.extensionNames || draft?.extensionNames || '',
  extensionRepo: posted?.extensionRepo || draft?.extensionRepo || '',
};

const activeKind = (kindLocked ? queryKind : shown.kind) as 'bug' | 'suggestion' | 'extension';
const categories =
  activeKind === 'suggestion'
    ? SUGGESTION_CATEGORIES
    : activeKind === 'extension'
      ? EXTENSION_SOURCES
      : BUG_CATEGORIES;

const TITLES: Record<'bug' | 'suggestion' | 'extension', string> = {
  bug: 'File a Bug Report',
  suggestion: 'File a Suggestion',
  extension: 'Report an Extension Issue',
};
const LEDES: Record<'bug' | 'suggestion' | 'extension', string> = {
  bug: 'Describe a problem you found in AnymeX.',
  suggestion: 'Suggest a feature or improvement for AnymeX.',
  extension: 'Report an extension that works correctly in its own app but not in AnymeX.',
};
const SUBMIT_LABELS: Record<'bug' | 'suggestion' | 'extension', string> = {
  bug: 'Submit bug report',
  suggestion: 'Submit suggestion',
  extension: 'Submit extension issue report',
};
const CATEGORY_STEP_LABELS: Record<'bug' | 'suggestion' | 'extension', string> = {
  bug: 'Category',
  suggestion: 'Category',
  extension: 'Extension source',
};
---

<Base title={TITLES[activeKind]} narrow>
  <h1>{TITLES[activeKind]}</h1>
  <p class="lede">{LEDES[activeKind]}</p>

  {
    activeKind === 'extension' && (
      <p class="note extension-warning" role="note">
        Only report an extension issue if the extension works correctly in its dedicated
        app but does <strong>not</strong> work in AnymeX. Please verify the source is
        working outside AnymeX before submitting — reports found to be an issue with the
        extension itself, not AnymeX, may get you blacklisted from reporting.
      </p>
    )
  }

  {
    !user && (
      <p class="note">
        You'll be asked to sign in with Discord when you submit. Your draft is kept.
      </p>
    )
  }

  <form method="POST" class="flow">
    {
      resumed && !error && (
        <p class="note" role="status">
          Welcome back. Your draft is still here. Review it and tap Submit to send it.
        </p>
      )
    }

    {error && <p class="error" role="alert">{error}</p>}

    {/* Step 1: Kind (hidden when pre-selected from tab) */}
    {!kindLocked && (
    <section class="step">
      <h2 class="step-h"><span class="step-n">1</span> Type</h2>
      <div class="segmented">
        {KINDS.map((k) => (
          <label class:active={shown.kind === k}>
            <input class="sr-only" type="radio" name="kind" value={k} checked={shown.kind === k} required />
            <span>{KIND_LABELS[k]}</span>
          </label>
        ))}
      </div>
    </section>
    )}
    {kindLocked && <input type="hidden" name="kind" value={activeKind} />}

    {/* Step {kindLocked ? 1 : 2}: Category */}
    <section class="step">
      <h2 class="step-h"><span class="step-n">{kindLocked ? 1 : 2}</span> {CATEGORY_STEP_LABELS[activeKind]}</h2>
      <div class="segmented cats">
        {categories.map((c) => (
          <label class:active={shown.category === c}>
            <input class="sr-only" type="radio" name="category" value={c} checked={shown.category === c} required />
            <span>{CATEGORY_LABELS[c] ?? c}</span>
          </label>
        ))}
      </div>
    </section>

    {/* Step {kindLocked ? 2 : 3}: Platform */}
    <section class="step">
      <h2 class="step-h"><span class="step-n">{kindLocked ? 2 : 3}</span> Platform</h2>
      <div class="segmented plats">
        {PLATFORMS.map((p) => (
          <label class:active={shown.platform === p}>
            <input class="sr-only" type="radio" name="platform" value={p} checked={shown.platform === p} required />
            <span>{PLATFORM_LABELS[p]}</span>
          </label>
        ))}
      </div>
    </section>

    {/* Step {kindLocked ? 3 : 4}: Details */}
    <section class="step">
      <h2 class="step-h"><span class="step-n">{kindLocked ? 3 : 4}</span> Details</h2>

      {shown.kind === 'extension' && (
        <div class="field checkbox-field">
          <label class="checkbox-label">
            <input
              type="checkbox"
              name="testedNativeApp"
              checked={shown.testedNativeApp}
              required
            />
            <span>Yes, I tested it in the native app and the issue only occurs in AnymeX</span>
          </label>
          <p class="field-hint">If the issue is found to be with the extension itself, you may be blacklisted from reporting it.</p>
        </div>
      )}

      <div class="field">
        <label class="label" for="title">Title</label>
        <input
          class="input"
          id="title"
          name="title"
          type="text"
          maxlength="200"
          required
          minlength="5"
          value={shown.title}
          placeholder="Briefly describe the issue or suggestion"
        />
      </div>
      <div class="field">
        <label class="label" for="appVersion">App version</label>
        <input
          class="input"
          id="appVersion"
          name="appVersion"
          type="text"
          maxlength="32"
          inputmode="numeric"
          value={shown.appVersion}
          placeholder="e.g. 3.1.7+39"
        />
        <p class="field-hint">Found in AnymeX → Settings → About. Optional but very helpful.</p>
      </div>
      {shown.kind === 'extension' && (
        <div class="field">
          <label class="label" for="extensionNames">Extension name(s)</label>
          <textarea
            class="textarea"
            id="extensionNames"
            name="extensionNames"
            rows="2"
            maxlength="4000"
            required
            placeholder="Enter the exact name of the affected extension(s), one per line"
          >{shown.extensionNames}</textarea>
        </div>
      )}

      <div class="field">
        <label class="label" for="body">{shown.kind === 'extension' ? 'Issue description' : 'Description'}</label>
        <textarea
          class="textarea"
          id="body"
          name="body"
          rows="4"
          maxlength="5000"
          required={shown.kind === 'extension'}
          placeholder={shown.kind === 'extension'
            ? 'Describe what is wrong with the extension.'
            : 'What happened? What did you expect to happen?'}
        >{shown.body}</textarea>
      </div>

      {shown.kind === 'extension' && (
        <div class="field">
          <label class="label" for="extensionRepo">Extension repository</label>
          <input
            class="input"
            id="extensionRepo"
            name="extensionRepo"
            type="text"
            maxlength="2000"
            value={shown.extensionRepo}
            placeholder="Paste the extension repository URL"
          />
          <p class="field-hint">Optional.</p>
        </div>
      )}

      {shown.kind === 'bug' && (
        <div class="field">
          <label class="label" for="stepsToReproduce">Steps to reproduce</label>
          <textarea
            class="textarea"
            id="stepsToReproduce"
            name="stepsToReproduce"
            rows="3"
            maxlength="5000"
            placeholder="1. Open the app&#10;2. Go to...&#10;3. Tap on..."
          >{shown.stepsToReproduce}</textarea>
          <p class="field-hint">Optional, but the most useful thing you can include for a bug.</p>
        </div>
      )}
    </section>

    {/* Step {kindLocked ? 4 : 5}: Attachments */}
    <section class="step">
      <h2 class="step-h"><span class="step-n">{kindLocked ? 4 : 5}</span> Attachments</h2>
      <p class="field-hint">
        Images (JPG, PNG, WebP, GIF) up to 5 MB · Videos (MP4, WebM) up to 50 MB. You can also add more after submitting.
        {shown.kind === 'extension' && ' A screenshot from the native app alongside one from AnymeX helps a lot.'}
      </p>
      <div class="upload-area" id="upload-area">
        <label class="upload-dropzone" for="file-input">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="17 8 12 3 7 8" />
            <line x1="12" y1="3" x2="12" y2="15" />
          </svg>
          <span>Click to select files or drag &amp; drop</span>
        </label>
        <input id="file-input" type="file" name="files" accept="image/*,video/mp4,video/webm" multiple class="sr-only" />
        <div class="file-list" id="file-list"></div>
      </div>
    </section>

    <div class="submit-row">
      <button class="btn btn-primary btn-lg" type="submit" id="submit-btn" data-label={SUBMIT_LABELS[activeKind]}>
        {SUBMIT_LABELS[activeKind]}
      </button>
    </div>
  </form>

  <script>
    const form = document.querySelector('form')!;
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const fileList = document.getElementById('file-list');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const selectedFiles: File[] = [];

    // File selection handling
    fileInput?.addEventListener('change', () => {
      for (const f of Array.from(fileInput.files ?? [])) {
        if (selectedFiles.length >= 5) break;
        if (!selectedFiles.find(x => x.name === f.name && x.size === f.size)) {
          selectedFiles.push(f);
        }
      }
      fileInput.value = '';
      renderFiles();
    });

    // Drag and drop
    const dropzone = document.querySelector('.upload-dropzone');
    dropzone?.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.classList.add('drag-over'); });
    dropzone?.addEventListener('dragleave', () => { dropzone.classList.remove('drag-over'); });
    dropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('drag-over');
      for (const f of Array.from(e.dataTransfer.files)) {
        if (selectedFiles.length >= 5) break;
        if (!selectedFiles.find(x => x.name === f.name && x.size === f.size)) {
          selectedFiles.push(f);
        }
      }
      renderFiles();
    });

    function renderFiles() {
      if (!fileList) return;
      fileList.innerHTML = '';
      selectedFiles.forEach((f, i) => {
        const size = f.size > 1024 * 1024
          ? `${(f.size / (1024 * 1024)).toFixed(1)} MB`
          : `${(f.size / 1024).toFixed(0)} KB`;
        const div = document.createElement('div');
        div.className = 'file-item';
        div.innerHTML = `<span class="file-name">${f.name}</span><span class="file-size">${size}</span><button type="button" class="file-remove" data-index="${i}">&times;</button>`;
        div.querySelector('.file-remove')?.addEventListener('click', () => { selectedFiles.splice(i, 1); renderFiles(); });
        fileList.appendChild(div);
      });
    }

    // Form submission with file upload
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (selectedFiles.length > 0) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting…';
      }

      try {
        const fd = new FormData(form);
        // Remove file input from form data (we upload separately)
        fd.delete('files');

        const res = await fetch('/new', {
          method: 'POST',
          body: fd,
          headers: { 'accept': 'application/json' },
        });

        if (!res.ok) {
          // Try to get error from JSON, fall back to redirect (non-JSON error)
          const ct = res.headers.get('content-type');
          if (ct?.includes('application/json')) {
            const data = await res.json().catch(() => null);
            if (data?.error) { alert(data.error); return; }
          }
          // Non-JSON response (e.g. redirect to /cant-post) — follow it
          const loc = res.headers.get('location');
          if (loc) { window.location.href = loc; return; }
          alert('Something went wrong.');
          return;
        }

        const data = await res.json();
        if (!data?.id) { alert('Something went wrong.'); return; }

        // Dedup: joined an existing report
        if (data.joined) {
          window.location.href = `/report/${data.id}?joined=1`;
          return;
        }

        // Upload selected files
        if (selectedFiles.length > 0) {
          submitBtn.textContent = `Uploading ${selectedFiles.length} file${selectedFiles.length > 1 ? 's' : ''}…`;
          let uploaded = 0;
          for (const file of selectedFiles) {
            const uploadFd = new FormData();
            uploadFd.append('file', file);
            uploadFd.append('reportId', String(data.id));
            await fetch('/upload', { method: 'POST', body: uploadFd });
            uploaded++;
            submitBtn.textContent = `Uploading ${uploaded}/${selectedFiles.length}…`;
          }
        }

        window.location.href = `/report/${data.id}?filed=1`;
      } catch {
        alert('Network error — please try again.');
        submitBtn.disabled = false;
        submitBtn.textContent = submitBtn.dataset.label ?? 'Submit';
      }
    });
  </script>

  <p class="foot-note">
    Already reported by someone else? Submitting adds you to their report instead
    of making a duplicate.
  </p>
</Base>

<style>
  h1 { font-size: var(--text-xl); }
  .lede { color: var(--text-tertiary); margin-block: var(--space-1) var(--space-6); }
  .extension-warning { border-inline-start-color: var(--dead, #ed4245); }
  .checkbox-field { margin-block-end: var(--space-4); }
  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--text-primary);
  }
  .checkbox-label input { margin-block-start: 3px; }
  .note {
    margin-block-end: var(--space-6);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border-default);
    border-inline-start: 2px solid var(--signal);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  .error {
    padding: var(--space-3);
    border: 1px solid var(--dead);
    border-inline-start-width: 2px;
    border-radius: var(--radius-md);
    background: var(--dead-fill);
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .flow { display: flex; flex-direction: column; gap: var(--space-8); }
  .flow > .note, .flow > .error { margin-block-end: 0; }
  .flow :global(.step-h) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-md);
    margin-block-end: var(--space-3);
  }
  .flow :global(.step-n) {
    display: grid;
    place-items: center;
    inline-size: 20px;
    block-size: 20px;
    border-radius: var(--radius-full);
    background: var(--surface-active);
    font-family: var(--font-data);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .segmented {
    display: flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    flex-wrap: wrap;
  }
  .segmented label {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-tertiary);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-standard),
      background var(--dur-fast) var(--ease-standard);
  }
  .segmented label:hover { color: var(--text-secondary); background: var(--surface-hover); }
  .segmented label.active,
  .segmented label:has(input:checked) { color: var(--text-primary); background: var(--surface-active); }
  .cats, .plats {
    gap: 4px;
  }
  .cats label, .plats label {
    font-size: var(--text-sm);
    font-weight: var(--weight-normal);
    padding: var(--space-1) var(--space-2);
  }

  .submit-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
    align-items: start;
  }

  /* ── Upload area ── */
  .upload-area { display: flex; flex-direction: column; gap: var(--space-2); }
  .upload-dropzone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-4);
    border: 2px dashed var(--border-default);
    border-radius: var(--radius-md);
    cursor: pointer;
    text-align: center;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    transition: border-color 0.15s, background 0.15s;
  }
  .upload-dropzone:hover, .upload-dropzone.drag-over {
    border-color: var(--signal);
    background: var(--signal-fill);
  }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; }
  .file-list { display: flex; flex-direction: column; gap: var(--space-2); }
