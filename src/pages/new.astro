---
import Base from '../layouts/Base.astro';
import {
  KINDS,
  KIND_LABELS,
  BUG_CATEGORIES,
  SUGGESTION_CATEGORIES,
  EXTENSION_SOURCES,
  NON_IOS_EXTENSION_SOURCES,
  CATEGORY_LABELS,
  PLATFORMS,
  PLATFORM_LABELS,
  RELEASE_CHANNELS,
  type ReleaseChannel,
  normalizeTitle,
  reports,
  OPEN_STATUSES,
  subscriptions,
  notifications,
} from '../lib/db/schema';
import { parseExtensionEntries, type ExtensionEntry } from '../lib/extensions';
import { or, isNull, eq, and } from 'drizzle-orm';
import { canWriteNow, currentUser, writeBlockReason } from '../lib/auth';
import { ensureVote } from '../lib/vote';
import { FILING_COOLDOWN_MESSAGE, overFilingLimit, findDuplicate } from '../lib/writes';
import { announceFiled } from '../lib/webhook';
import { createForumThread, syncForumVote } from '../lib/discord-forums';
import { logAction } from '../lib/staff';
import { db } from '../lib/db/client';
import { sql } from 'drizzle-orm';
import { getCachedReleases } from '../lib/github-releases';
import { checkAppVersionAdvisory } from '../lib/version';
import { env } from 'cloudflare:workers';

export const prerender = false;

// JSON helper for the AJAX (accept: application/json) paths below. The original
// code called `json(...)` in three places without ever defining it, which
// crashed every dedup-join / sign-in-required / banned AJAX response with
// "json is not defined". Mirrors the helper in upload.ts and comments.ts.
function json(data: unknown, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: { 'content-type': 'application/json' },
  });
}

const user = await currentUser(Astro);

let error: string | null = null;
let resumed = false;
let dedupHit: { id: number; title: string; votes: number } | null = null;

type Draft = {
  kind: string;
  category: string;
  platform: string;
  appVersion: string;
  releaseChannel: string;
  pluginVersion: string;
  title: string;
  body: string;
  stepsToReproduce: string;
  testedNativeApp: boolean;
  extensionNames: string;
  extensionRepo: string;
};

let posted: Draft | null = null;

/* ---------------------------------------------------------------------------
   POST. Filing a bug report or feature suggestion for AnymeX.
   ------------------------------------------------------------------------ */
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const kind = String(form.get('kind') ?? 'bug').trim();
  const category = String(form.get('category') ?? '').trim();
  const platform = String(form.get('platform') ?? '').trim();
  const appVersion = String(form.get('appVersion') ?? '').trim().slice(0, 32);
  const releaseChannel = (String(form.get('releaseChannel') ?? 'stable').trim() === 'beta' ? 'beta' : 'stable') as ReleaseChannel;
  const pluginVersion = String(form.get('pluginVersion') ?? '').trim().slice(0, 32);
  const title = String(form.get('title') ?? '').trim().slice(0, 200);
  let body = String(form.get('body') ?? '').trim().slice(0, 5000);
  const stepsToReproduce = String(form.get('stepsToReproduce') ?? '').trim().slice(0, 5000);
  const testedNativeApp = form.get('testedNativeApp') === 'on';
  const extensionRepo = String(form.get('extensionRepo') ?? '').trim().slice(0, 2000);

  const rawFiles = form.getAll('files').filter((f): f is File => f instanceof File && f.size > 0);
  const declaredAttachments = form.get('attachmentCount') ? Number(form.get('attachmentCount')) : null;
  const attachmentCount = declaredAttachments !== null ? declaredAttachments : rawFiles.length;

  // Dynamic extension cards (name + version + issue description)
  const rawExtNames = form.getAll('extensionName').map((v) => String(v).trim());
  const rawExtVers = form.getAll('extensionVersion').map((v) => String(v).trim());
  const rawExtIssues = form.getAll('extensionIssue').map((v) => String(v).trim());

  let extensionValidationError: string | null = null;
  const parsedExtensions: ExtensionEntry[] = [];

  if (rawExtNames.length > 0 || rawExtVers.length > 0 || rawExtIssues.length > 0) {
    const maxLen = Math.max(rawExtNames.length, rawExtVers.length, rawExtIssues.length);
    for (let i = 0; i < maxLen; i++) {
      const name = rawExtNames[i] ?? '';
      const version = rawExtVers[i] ?? '';
      const issue = rawExtIssues[i] ?? '';
      if (!name && !version && !issue) continue;
      if (!name) {
        extensionValidationError = 'Extension name is required for all added extensions.';
        break;
      }
      if (!version) {
        extensionValidationError = `Extension version is required for "${name}".`;
        break;
      }
      if (!issue) {
        extensionValidationError = `Please describe what is wrong with "${name}".`;
        break;
      }
      parsedExtensions.push({
        name: name.slice(0, 150),
        version: version.slice(0, 50),
        issue: issue.slice(0, 3000),
      });
    }
  } else {
    const legacyNames = String(form.get('extensionNames') ?? '').trim();
    if (legacyNames) {
      parsedExtensions.push(...parseExtensionEntries(legacyNames));
    }
  }

  const extensionNames = parsedExtensions.length > 0 ? JSON.stringify(parsedExtensions) : '';

  // For extension reports, synthesize body from each extension's issue description
  if (kind === 'extension') {
    if (!body && parsedExtensions.length > 0) {
      body = parsedExtensions
        .map((e) => `### ${e.name} (v${e.version})\n${e.issue || ''}`)
        .join('\n\n');
    }
  }

  const isAjax = Astro.request.headers.get('accept') === 'application/json';

  const submitted: Draft = {
    kind,
    category,
    platform,
    appVersion,
    releaseChannel,
    pluginVersion,
    title,
    body,
    stepsToReproduce,
    testedNativeApp,
    extensionNames,
    extensionRepo,
  };

  if (!user) {
    if (isAjax) return json({ error: 'Please sign in to submit a report.' }, 401);
    Astro.session?.set('pending_report', submitted);
    return Astro.redirect('/auth/login?next=/new', 302);
  }
  const blockReason = await writeBlockReason(user);
  if (blockReason) {
    if (isAjax) {
      const errorMsg =
        blockReason === 'banned'
          ? 'Your account has been banned by a moderator.'
          : blockReason === 'age'
            ? 'Your account is too new to post reports or suggestions yet.'
            : 'You cannot post right now.';
      return json({ error: errorMsg }, 403);
    }
    return Astro.redirect('/cant-post', 302);
  }

  posted = submitted;

  const validKinds = KINDS as readonly string[];
  const validCats =
    kind === 'suggestion'
      ? (SUGGESTION_CATEGORIES as readonly string[])
      : kind === 'extension'
        ? (EXTENSION_SOURCES as readonly string[])
        : (BUG_CATEGORIES as readonly string[]);
  const validPlatforms = PLATFORMS as readonly string[];

  if (!validKinds.includes(kind)) {
    error = 'Pick a type: bug, suggestion, or extension issue.';
  } else if (!validCats.includes(category)) {
    error = kind === 'extension' ? 'Pick which source the extension is for.' : 'Pick a category.';
  } else if (!validPlatforms.includes(platform)) {
    error = 'Pick a platform.';
  } else if (kind === 'extension' && platform === 'ios' && (NON_IOS_EXTENSION_SOURCES as readonly string[]).includes(category)) {
    error = `${CATEGORY_LABELS[category] ?? category} extensions are not available on iOS.`;
  } else if (!title || title.length < 5) {
    error = 'Give your report a title, at least 5 characters.';
  } else if (kind === 'extension' && !testedNativeApp) {
    error = 'Confirm you tested the extension in its native app and the issue only happens in AnymeX.';
  } else if (kind === 'extension' && extensionValidationError) {
    error = extensionValidationError;
  } else if (kind === 'extension' && parsedExtensions.length === 0) {
    error = 'Add at least one affected extension with its version and problem description.';
  } else if (kind !== 'extension' && !body) {
    error = kind === 'suggestion' ? 'Describe your suggestion.' : 'Describe the bug.';
  } else if ((kind === 'bug' || kind === 'extension') && !appVersion) {
    error = 'App version is required.';
  } else if (kind === 'bug' && !stepsToReproduce) {
    error = 'Steps to reproduce are required for bug reports.';
  } else if (kind === 'extension' && platform !== 'ios' && !pluginVersion) {
    error = 'Extension Runtime Bridge (Plugin) version is required.';
  } else if (kind === 'extension' && !extensionRepo) {
    error = 'Extension repository URL is required.';
  } else if ((kind === 'bug' || kind === 'extension') && attachmentCount < 1) {
    error = kind === 'extension'
      ? 'At least one attachment is required (side-by-side comparison showing native app vs AnymeX).'
      : 'At least one attachment (screenshot, recording, or log file) is required.';
  } else if (await overFilingLimit(user.id)) {
    error = FILING_COOLDOWN_MESSAGE;
  } else {
    // Check if user is reporting on an outdated version that requires an update
    let isBlocked = false;
    if (kind !== 'suggestion' && appVersion) {
      const kv = env.SESSION as KVNamespace | undefined;
      const postReleases = await getCachedReleases(kv);
      const advisory = checkAppVersionAdvisory({
        channel: releaseChannel,
        version: appVersion,
        allStable: postReleases.stable,
        allBeta: postReleases.beta,
        latestStable: postReleases.latest.stable,
        latestBeta: postReleases.latest.beta,
      });
      if (advisory.blocked && advisory.message) {
        isBlocked = true;
        if (isAjax) return json({ error: 'outdated_version', message: advisory.message }, 400);
        error = advisory.message;
      }
    }

    if (!isBlocked) {
      // Check dedup. findDuplicate normalizes the title internally.
    const dup = await findDuplicate(kind, category, platform, title);
    if (dup) {
      if (!dup.locked) {
        await ensureVote(dup.id, user.id);
        const syncVote = syncForumVote(dup.id, Astro.url.origin, kv);
        const log = logAction(
          user,
          'report.join_duplicate',
          `report #${dup.id}`,
          normalizeTitle(title),
          `${Astro.url.origin}/report/${dup.id}`,
        );
        const cf1 = Astro.locals.cfContext;
        if (cf1) {
          cf1.waitUntil(log);
          cf1.waitUntil(syncVote);
        } else {
          await log;
          await syncVote;
        }
      }
      if (isAjax) return json({ id: dup.id, joined: !dup.locked, locked: dup.locked }, 200);
      return Astro.redirect(`/report/${dup.id}?joined=1${dup.locked ? '&locked=1' : ''}`, 303);
    }

    const [created] = await db()
      .insert(reports)
      .values({
        kind,
        category,
        platform,
        appVersion: appVersion || null,
        releaseChannel,
        pluginVersion: pluginVersion || null,
        // Keep the user's original casing/punctuation for display; the
        // normalized copy drives the dedup index (see reports_dedup).
        title: title,
        titleNormalized: normalizeTitle(title),
        body: body || null,
        stepsToReproduce: kind === 'bug' ? (stepsToReproduce || null) : null,
        testedNativeApp: kind === 'extension' ? testedNativeApp : null,
        extensionNames: kind === 'extension' ? (extensionNames || null) : null,
        extensionRepo: kind === 'extension' ? (extensionRepo || null) : null,
        reporterId: user.id,
      })
      .returning();

    if (created) {
      await ensureVote(created.id, user.id);

      // Fan out notifications to matching subscribers (excluding the reporter).
      async function notifySubscribers(): Promise<void> {
        const d = db();
        const subs = await d.select().from(subscriptions).where(
          and(
            or(isNull(subscriptions.kind),     eq(subscriptions.kind,     created.kind)),
            or(isNull(subscriptions.category), eq(subscriptions.category, created.category)),
            or(isNull(subscriptions.platform), eq(subscriptions.platform, created.platform)),
          )
        );
        const targets = subs
          .map((s) => s.userId)
          .filter((id, i, a) => id !== user.id && a.indexOf(id) === i); // dedup + exclude reporter
        if (targets.length === 0) return;
        await d.insert(notifications).values(
          targets.map((userId) => ({
            userId,
            reportId: created.id,
            kind: 'subscription_match' as const,
            detail: `New ${created.kind}: ${created.title}`,
          })),
        );
      }

      const after: Promise<unknown>[] = [
        announceFiled(created, Astro.url.origin),
        createForumThread(created, Astro.url.origin),
        logAction(
          user,
          'report.file',
          `report #${created.id}`,
          `${created.kind}: ${created.title}`,
          `${Astro.url.origin}/report/${created.id}`,
        ),
        notifySubscribers(),
      ];
      const cf = Astro.locals.cfContext;
      if (cf) for (const task of after) cf.waitUntil(task);
      else await Promise.all(after);

      // Return JSON for AJAX submissions so the client can upload files next.
      if (Astro.request.headers.get('accept') === 'application/json') {
        return new Response(JSON.stringify({ id: created.id }), {
          status: 200,
          headers: { 'content-type': 'application/json' },
        });
      }
      return Astro.redirect(`/report/${created.id}?filed=1`, 303);
    }
    }
  }

  // For AJAX requests with validation errors, return JSON instead of re-rendering.
  if (isAjax && error) {
    return new Response(JSON.stringify({ error }), {
      status: 400,
      headers: { 'content-type': 'application/json' },
    });
  }
}

/* --- GET ---------------------------------------------------------------- */
const draft = (await Astro.session?.get('pending_report')) as Draft | undefined;
if (draft) {
  Astro.session?.delete('pending_report');
  resumed = true;
}

const queryKind = Astro.url.searchParams.get('kind') ?? '';
const kindLocked = queryKind === 'bug' || queryKind === 'suggestion' || queryKind === 'extension';

const kv = env.SESSION as KVNamespace | undefined;
const releases = await getCachedReleases(kv);

// Support direct link pre-selection: ?channel=beta, ?channel=stable, ?channel=preview, or ?beta
const channelQuery = (
  Astro.url.searchParams.get('channel') ||
  Astro.url.searchParams.get('releaseChannel') ||
  Astro.url.searchParams.get('release') ||
  ''
).toLowerCase().trim();

const isBeta = channelQuery === 'beta' || channelQuery === 'preview' || Astro.url.searchParams.has('beta');
const defaultChannel: 'stable' | 'beta' = isBeta ? 'beta' : 'stable';

// Support optional prefill: ?version=... or ?version=latest
const versionQuery = (
  Astro.url.searchParams.get('version') ||
  Astro.url.searchParams.get('appVersion') ||
  ''
).trim().slice(0, 32);

const resolvedVersion = versionQuery === 'latest'
  ? (isBeta ? releases.latest.beta?.version : releases.latest.stable?.version) || ''
  : versionQuery;

const shown = {
  kind: posted?.kind || draft?.kind || queryKind || 'bug',
  category: posted?.category || draft?.category || (Astro.url.searchParams.get('category') || '').trim(),
  platform: posted?.platform || draft?.platform || (Astro.url.searchParams.get('platform') || '').trim(),
  appVersion: posted?.appVersion || draft?.appVersion || resolvedVersion || '',
  releaseChannel: posted?.releaseChannel || draft?.releaseChannel || defaultChannel,
  pluginVersion: posted?.pluginVersion || draft?.pluginVersion || (Astro.url.searchParams.get('pluginVersion') || '').trim().slice(0, 32),
  title: posted?.title || draft?.title || (Astro.url.searchParams.get('title') || '').trim().slice(0, 200),
  body: posted?.body || draft?.body || '',
  stepsToReproduce: posted?.stepsToReproduce || draft?.stepsToReproduce || '',
  testedNativeApp: posted?.testedNativeApp || draft?.testedNativeApp || false,
  extensionNames: posted?.extensionNames || draft?.extensionNames || '',
  extensionRepo: posted?.extensionRepo || draft?.extensionRepo || '',
};

let initialExtensionEntries = parseExtensionEntries(shown.extensionNames);
if (initialExtensionEntries.length === 0) {
  initialExtensionEntries = [{ name: '', version: '' }];
}

const activeKind = (kindLocked ? queryKind : shown.kind) as 'bug' | 'suggestion' | 'extension';
const categories =
  activeKind === 'suggestion'
    ? SUGGESTION_CATEGORIES
    : activeKind === 'extension'
      ? EXTENSION_SOURCES
      : BUG_CATEGORIES;

const TITLES: Record<'bug' | 'suggestion' | 'extension', string> = {
  bug: 'File a Bug Report',
  suggestion: 'File a Suggestion',
  extension: 'Report an Extension Issue',
};
const LEDES: Record<'bug' | 'suggestion' | 'extension', string> = {
  bug: 'Describe a problem you found in AnymeX.',
  suggestion: 'Suggest a feature or improvement for AnymeX.',
  extension: 'Report an extension that works correctly in its own app but not in AnymeX.',
};
const SUBMIT_LABELS: Record<'bug' | 'suggestion' | 'extension', string> = {
  bug: 'Submit bug report',
  suggestion: 'Submit suggestion',
  extension: 'Submit extension issue report',
};
const CATEGORY_STEP_LABELS: Record<'bug' | 'suggestion' | 'extension', string> = {
  bug: 'Category',
  suggestion: 'Category',
  extension: 'Extension source',
};
---

<Base title={TITLES[activeKind]} narrow>
  <h1>{TITLES[activeKind]}</h1>
  <p class="lede">{LEDES[activeKind]}</p>

  {
    activeKind === 'extension' && (
      <p class="note extension-warning" role="note">
        Only report an extension issue if the extension works correctly in its dedicated
        app but does <strong>not</strong> work in AnymeX. Please verify the source is
        working outside AnymeX before submitting — reports found to be an issue with the
        extension itself, not AnymeX, may get you blacklisted from reporting.
      </p>
    )
  }

  {
    !user && (
      <p class="note">
        You'll be asked to sign in with Discord when you submit. Your draft is kept.
      </p>
    )
  }

  <form method="POST" class="flow">
    {
      resumed && !error && (
        <p class="note" role="status">
          Welcome back. Your draft is still here. Review it and tap Submit to send it.
        </p>
      )
    }

    {error && <p class="error" role="alert">{error}</p>}

    {/* Step 1: Kind (hidden when pre-selected from tab) */}
    {!kindLocked && (
    <section class="step">
      <h2 class="step-h"><span class="step-n">1</span> Type</h2>
      <div class="segmented">
        {KINDS.map((k) => (
          <label class:active={shown.kind === k}>
            <input class="sr-only" type="radio" name="kind" value={k} checked={shown.kind === k} required />
            <span>{KIND_LABELS[k]}</span>
          </label>
        ))}
      </div>
    </section>
    )}
    {kindLocked && <input type="hidden" name="kind" value={activeKind} />}

    {/* Step {kindLocked ? 1 : 2}: Category & Platform */}
    <section class="step">
      <h2 class="step-h"><span class="step-n">{kindLocked ? 1 : 2}</span> {CATEGORY_STEP_LABELS[activeKind]} &amp; Platform</h2>
      <div class="field-row">
        <div class="field">
          <label class="label" for="category-select">
            {CATEGORY_STEP_LABELS[activeKind]} <span class="required-star">*</span>
          </label>
          <select id="category-select" name="category" class="select" required>
            <option value="" disabled selected={!shown.category}>Select {CATEGORY_STEP_LABELS[activeKind].toLowerCase()}...</option>
            {categories.map((c) => (
              <option value={c} selected={shown.category === c}>
                {CATEGORY_LABELS[c] ?? c}
              </option>
            ))}
          </select>
        </div>

        <div class="field">
          <label class="label" for="platform-select">
            Platform <span class="required-star">*</span>
          </label>
          <select id="platform-select" name="platform" class="select" required>
            <option value="" disabled selected={!shown.platform}>Select platform...</option>
            {PLATFORMS.map((p) => {
              const isIosHidden = activeKind === 'extension' && p === 'ios' && (NON_IOS_EXTENSION_SOURCES as readonly string[]).includes(shown.category);
              return (
                <option
                  value={p}
                  selected={shown.platform === p}
                  disabled={isIosHidden}
                  hidden={isIosHidden}
                  data-platform={p}
                >
                  {PLATFORM_LABELS[p]}
                </option>
              );
            })}
          </select>
        </div>
      </div>
    </section>

    {/* Step {kindLocked ? 2 : 3}: Details */}
    <section class="step">
      <h2 class="step-h"><span class="step-n">{kindLocked ? 2 : 3}</span> Details</h2>

      {shown.kind === 'extension' && (
        <div class="field checkbox-field">
          <label class="checkbox-label">
            <input
              type="checkbox"
              name="testedNativeApp"
              checked={shown.testedNativeApp}
              required
            />
            <span>Yes, I tested it in the native app and the issue only occurs in AnymeX</span>
          </label>
          <p class="field-hint">If the issue is found to be with the extension itself, you may be blacklisted from reporting it.</p>
        </div>
      )}

      <div class="field">
        <label class="label" for="title">Title</label>
        <input
          class="input"
          id="title"
          name="title"
          type="text"
          maxlength="200"
          required
          minlength="5"
          value={shown.title}
          placeholder={shown.kind === 'suggestion'
            ? 'What feature or improvement would you like to see?'
            : shown.kind === 'extension'
              ? 'e.g. Extension fails to load chapter list'
              : 'Briefly describe what went wrong'}
        />
        <div id="similar-reports" class="similar-box" style="display: none;">
          <p class="similar-heading">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            Similar open reports found — already reported?
          </p>
          <ul id="similar-list" class="similar-list"></ul>
        </div>
      </div>

      {activeKind !== 'suggestion' && (
        <>
          <div class="field">
            <label class="label">Release channel <span class="required-star">*</span></label>
            <div class="segmented channel-segmented" role="radiogroup">
              <label class:active={shown.releaseChannel !== 'beta'}>
                <input class="sr-only" type="radio" name="releaseChannel" value="stable" checked={shown.releaseChannel !== 'beta'} />
                <span>Stable</span>
              </label>
              <label class:active={shown.releaseChannel === 'beta'}>
                <input class="sr-only" type="radio" name="releaseChannel" value="beta" checked={shown.releaseChannel === 'beta'} />
                <span class="channel-beta-text">Beta (Preview)</span>
              </label>
            </div>
            <p class="field-hint">Select whether you encountered this issue on the official stable release or the preview beta.</p>
          </div>

          <div class="field">
            <label class="label" for="appVersion">App version <span class="required-star">*</span></label>
            <div class="custom-combobox" id="app-combobox">
              <div class="combobox-input-wrap">
                <input
                  class="input combobox-input"
                  id="appVersion"
                  name="appVersion"
                  type="text"
                  maxlength="32"
                  required
                  value={shown.appVersion}
                  placeholder={shown.releaseChannel === 'beta' ? 'e.g. 3.1.6+4-beta' : 'e.g. 3.1.7'}
                  autocomplete="off"
                  role="combobox"
                  aria-autocomplete="list"
                  aria-expanded="false"
                  aria-controls="app-version-dropdown"
                />
                <button
                  type="button"
                  class="combobox-toggle-btn"
                  id="app-version-toggle-btn"
                  aria-label="Toggle version list"
                  tabindex="-1"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
              </div>
              <div
                id="app-version-dropdown"
                class="combobox-dropdown"
                role="listbox"
                style="display: none;"
              ></div>
            </div>
            <p class="field-hint">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px; margin-right: 3px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              Check <strong>Settings → About</strong> in AnymeX to confirm your version.
            </p>
            <div id="version-advisory" class="advisory-box" style="display: none;"></div>
          </div>

          <div
            id="plugin-version-group"
            class="field"
            style={activeKind === 'extension' && shown.platform !== 'ios' ? '' : 'display: none;'}
          >
            <label class="label" for="pluginVersion">Extension Runtime Bridge (Plugin) version <span class="required-star">*</span></label>
            <div class="custom-combobox" id="plugin-combobox">
              <div class="combobox-input-wrap">
                <input
                  class="input combobox-input"
                  id="pluginVersion"
                  name="pluginVersion"
                  type="text"
                  maxlength="32"
                  value={shown.pluginVersion}
                  placeholder="e.g. 2.4.0"
                  autocomplete="off"
                  role="combobox"
                  aria-autocomplete="list"
                  aria-expanded="false"
                  aria-controls="plugin-version-dropdown"
                />
                <button
                  type="button"
                  class="combobox-toggle-btn"
                  id="plugin-version-toggle-btn"
                  aria-label="Toggle plugin version list"
                  tabindex="-1"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
              </div>
              <div
                id="plugin-version-dropdown"
                class="combobox-dropdown"
                role="listbox"
                style="display: none;"
              ></div>
            </div>
            <p class="field-hint">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px; margin-right: 3px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              Check <strong>Settings → Extensions → Settings icon (gear) on top right</strong> for plugin version.
            </p>
            <div id="plugin-advisory" class="advisory-box" style="display: none;"></div>
          </div>
          <div
            id="ios-plugin-note"
            class="ios-plugin-note"
            style={activeKind === 'extension' && shown.platform === 'ios' ? '' : 'display: none;'}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align: -2px; margin-right: 4px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            iOS does not use the extension runtime bridge plugin.
          </div>
        </>
      )}

      {shown.kind === 'extension' && (
        <div class="field extension-fields-group">
          <div class="ext-header">
            <label class="label" style="margin-bottom: 0;">
              Affected Extension(s) <span class="required-star">*</span>
            </label>
            <p class="field-hint">Specify each affected extension, its version, and the problem that occurs.</p>
          </div>

          <div id="extension-list" class="extension-list">
            {initialExtensionEntries.map((ext, idx) => (
              <div class="extension-card" data-index={idx}>
                <div class="ext-card-header">
                  <span class="ext-card-num">Extension #{idx + 1}</span>
                  <button
                    type="button"
                    class="ext-remove-btn"
                    title="Remove extension"
                    aria-label="Remove extension"
                    disabled={initialExtensionEntries.length <= 1}
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="18" y1="6" x2="6" y2="18"></line>
                      <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                  </button>
                </div>

                <div class="ext-card-top-row">
                  <div class="ext-col ext-col-name">
                    <label class="ext-sublabel" for={`ext-name-${idx}`}>
                      Extension Name <span class="required-star">*</span>
                    </label>
                    <input
                      class="input ext-name-input"
                      id={`ext-name-${idx}`}
                      name="extensionName"
                      type="text"
                      maxlength="150"
                      placeholder="e.g. Gogoanime"
                      value={ext.name}
                      required
                    />
                  </div>
                  <div class="ext-col ext-col-version">
                    <label class="ext-sublabel" for={`ext-ver-${idx}`}>
                      Version <span class="required-star">*</span>
                    </label>
                    <input
                      class="input ext-ver-input"
                      id={`ext-ver-${idx}`}
                      name="extensionVersion"
                      type="text"
                      maxlength="50"
                      placeholder="e.g. 1.4.2"
                      value={ext.version}
                      required
                    />
                  </div>
                </div>

                <div class="ext-card-issue-row">
                  <label class="ext-sublabel" for={`ext-issue-${idx}`}>
                    What is wrong with this extension? <span class="required-star">*</span>
                  </label>
                  <textarea
                    class="textarea ext-issue-input"
                    id={`ext-issue-${idx}`}
                    name="extensionIssue"
                    rows="2"
                    maxlength="3000"
                    placeholder="Describe what happens specifically with this extension (e.g. video player returns 403 error, search is empty, etc.)."
                    required
                  >{ext.issue ?? ''}</textarea>
                </div>
              </div>
            ))}
          </div>

          <button type="button" id="add-extension-btn" class="btn-add-ext" style={initialExtensionEntries.length >= 10 ? 'display: none;' : ''}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Add another extension</span>
          </button>
        </div>
      )}

      {shown.kind !== 'extension' && (
        <div class="field">
          <label class="label" for="body">
            {shown.kind === 'suggestion' ? 'Suggestion details' : 'Description'}
          </label>
          <textarea
            class="textarea"
            id="body"
            name="body"
            rows="4"
            maxlength="5000"
            required={shown.kind !== 'extension'}
            placeholder={shown.kind === 'suggestion'
              ? 'Describe your idea, how it should work, and why it would be helpful.'
              : 'What happened? What did you expect to happen?'}
          >{shown.body}</textarea>
          <p class="field-hint">Supports Discord Markdown: <code>**bold**</code>, <code>*italic*</code>, <code>__underline__</code>, <code>~~strike~~</code>, <code>`code`</code>, <code>&gt; quote</code>, <code>||spoiler||</code>, <code>-# subtext</code></p>
        </div>
      )}

      {shown.kind === 'extension' && (
        <div class="field">
          <label class="label" for="extensionRepo">
            Extension repository <span class="required-star">*</span>
          </label>
          <input
            class="input"
            id="extensionRepo"
            name="extensionRepo"
            type="text"
            maxlength="2000"
            required
            value={shown.extensionRepo}
            placeholder="Paste the extension repository URL"
          />
          <p class="field-hint">Link to the extension source repository.</p>
        </div>
      )}

      {shown.kind === 'bug' && (
        <details class="diagnostics-drawer">
          <summary class="diagnostics-summary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
            Paste Crash Log / Diagnostics (Auto-detects App Version & Device)
          </summary>
          <div class="diagnostics-body">
            <textarea
              id="diagnostics-input"
              class="textarea log-input"
              rows="3"
              placeholder="Paste crash log, stack trace, or device info here..."
            ></textarea>
            <div class="diagnostics-actions">
              <button type="button" id="parse-log-btn" class="btn btn-sm">Auto-extract details</button>
              <span id="log-status" class="log-status"></span>
            </div>
          </div>
        </details>
      )}

      {shown.kind === 'bug' && (
        <div class="field">
          <label class="label" for="stepsToReproduce">
            Steps to reproduce <span class="required-star">*</span>
          </label>
          <textarea
            class="textarea"
            id="stepsToReproduce"
            name="stepsToReproduce"
            rows="3"
            maxlength="5000"
            required
            placeholder="1. Open the app&#10;2. Go to...&#10;3. Tap on..."
          >{shown.stepsToReproduce}</textarea>
          <p class="field-hint">Describe step-by-step how to reproduce the bug.</p>
        </div>
      )}
    </section>

    {/* Step {kindLocked ? 3 : 4}: Attachments */}
    <section class="step">
      <h2 class="step-h"><span class="step-n">{kindLocked ? 3 : 4}</span> Attachments {(activeKind === 'bug' || activeKind === 'extension') && <span class="required-star">*</span>}</h2>
      <p class="field-hint">
        {activeKind === 'extension'
          ? 'At least 1 attachment is required (side-by-side screenshots/videos showing the extension working in its native app vs failing in AnymeX).'
          : activeKind === 'bug'
            ? 'At least 1 attachment is required (screenshot, recording, or log file demonstrating the bug).'
            : 'Attachments are optional for suggestions.'}
        {' '}Any file type is accepted — images (JPG, PNG, WebP, GIF, HEIC, AVIF) up to 5 MB, videos (MP4, WebM) up to 50 MB, other files up to 50 MB. Up to 10 attachments per report.
      </p>
      <div class="upload-area" id="upload-area">
        <label class="upload-dropzone" for="file-input">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="17 8 12 3 7 8" />
            <line x1="12" y1="3" x2="12" y2="15" />
          </svg>
          <span>Click to select files or drag &amp; drop</span>
        </label>
        <input id="file-input" type="file" name="files" multiple class="sr-only" />
        <div class="file-list" id="file-list"></div>
      </div>
    </section>

    <div class="submit-row">
      <button class="btn btn-primary btn-lg" type="submit" id="submit-btn" data-label={SUBMIT_LABELS[activeKind]}>
        {SUBMIT_LABELS[activeKind]}
      </button>
    </div>
  </form>

  <script id="releases-json" type="application/json" set:html={JSON.stringify(releases)}></script>

  <script>
    import { checkAppVersionAdvisory, checkPluginVersionAdvisory } from '../lib/version';
    import type { ReleasesPayload } from '../lib/github-releases';

    // Select the report form specifically. The header renders a search form
    // and a logout form BEFORE the report form in the DOM, so
    // document.querySelector('form') returns the search form — and attaching
    // the submit handler to that meant the report form submitted natively,
    // created the report, redirected, and never called /upload. That was the
    // "report created but attachment not uploaded" bug.
    const form = (document.getElementById('submit-btn') as HTMLButtonElement)?.closest('form')!;
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const fileList = document.getElementById('file-list');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const selectedFiles: File[] = [];

    // ── GitHub Releases & Version Advisories ───────────────────────────
    const releasesJsonEl = document.getElementById('releases-json');
    let releasesData: ReleasesPayload | null = null;
    if (releasesJsonEl?.textContent) {
      try {
        releasesData = JSON.parse(releasesJsonEl.textContent);
      } catch {}
    }

    const appVerInput = document.getElementById('appVersion') as HTMLInputElement | null;
    const appToggleBtn = document.getElementById('app-version-toggle-btn') as HTMLButtonElement | null;
    const appDropdown = document.getElementById('app-version-dropdown') as HTMLDivElement | null;
    const versionAdvisory = document.getElementById('version-advisory') as HTMLDivElement | null;

    const pluginVerInput = document.getElementById('pluginVersion') as HTMLInputElement | null;
    const pluginToggleBtn = document.getElementById('plugin-version-toggle-btn') as HTMLButtonElement | null;
    const pluginDropdown = document.getElementById('plugin-version-dropdown') as HTMLDivElement | null;
    const pluginAdvisory = document.getElementById('plugin-advisory') as HTMLDivElement | null;
    const pluginGroup = document.getElementById('plugin-version-group');
    const iosPluginNote = document.getElementById('ios-plugin-note');

    function getSelectedChannel(): 'stable' | 'beta' {
      const checked = document.querySelector('input[name="releaseChannel"]:checked') as HTMLInputElement | null;
      return checked?.value === 'beta' ? 'beta' : 'stable';
    }

    interface ComboboxItem {
      version: string;
      name: string;
      isLatest: boolean;
      publishedAt?: string;
      badgeLabel?: string;
    }

    function setupCombobox({
      inputEl,
      toggleBtn,
      dropdownEl,
      getItems,
      onSelect,
    }: {
      inputEl: HTMLInputElement | null;
      toggleBtn: HTMLButtonElement | null;
      dropdownEl: HTMLDivElement | null;
      getItems: () => ComboboxItem[];
      onSelect: (val: string) => void;
    }) {
      if (!inputEl || !toggleBtn || !dropdownEl) return null;

      let isOpen = false;
      let highlightedIndex = -1;

      function renderList(filterText = '') {
        if (!dropdownEl || !inputEl) return;
        const items = getItems();
        const cleanFilter = filterText.trim().toLowerCase();
        const filtered = cleanFilter
          ? items.filter((it) => it.version.toLowerCase().includes(cleanFilter) || it.name.toLowerCase().includes(cleanFilter))
          : items;

        if (filtered.length === 0) {
          dropdownEl.innerHTML = `<div class="combobox-empty">No matching versions found</div>`;
          return;
        }

        const currentVal = inputEl.value.trim();
        dropdownEl.innerHTML = filtered.map((it, idx) => {
          const isSelected = it.version === currentVal;
          return `
            <div class="combobox-item ${isSelected ? 'selected' : ''}" data-version="${it.version}" role="option" aria-selected="${isSelected}" data-index="${idx}">
              <div class="combobox-item-main">
                <span class="combobox-item-ver">${it.version}</span>
                ${it.badgeLabel ? `<span class="combobox-item-badge ${it.isLatest ? 'latest' : ''}">${it.badgeLabel}</span>` : ''}
              </div>
              ${isSelected ? `<svg class="combobox-item-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>` : ''}
            </div>
          `;
        }).join('');

        dropdownEl.querySelectorAll<HTMLDivElement>('.combobox-item').forEach((itemEl) => {
          itemEl.addEventListener('click', (e) => {
            e.stopPropagation();
            const ver = itemEl.dataset.version;
            if (ver && inputEl) {
              inputEl.value = ver;
              close();
              onSelect(ver);
              inputEl.focus();
            }
          });
        });
      }

      function open(showAll = false) {
        if (!dropdownEl || !inputEl || !toggleBtn) return;
        isOpen = true;
        toggleBtn.classList.add('open');
        inputEl.setAttribute('aria-expanded', 'true');
        dropdownEl.style.display = 'block';
        renderList(showAll ? '' : inputEl.value);

        const selectedEl = dropdownEl.querySelector('.combobox-item.selected') as HTMLDivElement | null;
        if (selectedEl) {
          selectedEl.scrollIntoView({ block: 'nearest' });
        }
      }

      function close() {
        if (!dropdownEl || !inputEl || !toggleBtn) return;
        isOpen = false;
        toggleBtn.classList.remove('open');
        inputEl.setAttribute('aria-expanded', 'false');
        dropdownEl.style.display = 'none';
        highlightedIndex = -1;
      }

      function toggle() {
        if (isOpen) {
          close();
        } else {
          open(true);
        }
      }

      toggleBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        toggle();
        if (isOpen) inputEl.focus();
      });

      inputEl.addEventListener('click', (e) => {
        e.stopPropagation();
        if (!isOpen) {
          open(true);
        }
      });

      inputEl.addEventListener('input', () => {
        if (!isOpen) {
          isOpen = true;
          toggleBtn.classList.add('open');
          inputEl.setAttribute('aria-expanded', 'true');
          dropdownEl.style.display = 'block';
        }
        renderList(inputEl.value);
      });

      inputEl.addEventListener('keydown', (e) => {
        if (!isOpen) {
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            open(true);
          }
          return;
        }

        const items = dropdownEl.querySelectorAll<HTMLDivElement>('.combobox-item');
        if (items.length === 0) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          highlightedIndex = (highlightedIndex + 1) % items.length;
          updateHighlight(items);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          highlightedIndex = (highlightedIndex - 1 + items.length) % items.length;
          updateHighlight(items);
        } else if (e.key === 'Enter') {
          if (highlightedIndex >= 0 && highlightedIndex < items.length) {
            e.preventDefault();
            const ver = items[highlightedIndex].dataset.version;
            if (ver) {
              inputEl.value = ver;
              close();
              onSelect(ver);
            }
          }
        } else if (e.key === 'Escape') {
          close();
        }
      });

      function updateHighlight(items: NodeListOf<HTMLDivElement>) {
        items.forEach((it, idx) => {
          if (idx === highlightedIndex) {
            it.classList.add('highlighted');
            it.scrollIntoView({ block: 'nearest' });
          } else {
            it.classList.remove('highlighted');
          }
        });
      }

      return { open, close, toggle, renderList, isOpen: () => isOpen };
    }

    let isVersionBlocked = false;

    function updateAppVersionAdvisory() {
      if (!appVerInput || !versionAdvisory || !releasesData) return;
      const currentKind = getSelectedKind();
      if (currentKind === 'suggestion') {
        isVersionBlocked = false;
        versionAdvisory.style.display = 'none';
        versionAdvisory.innerHTML = '';
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.title = '';
        }
        return;
      }

      const val = appVerInput.value.trim();
      const channel = getSelectedChannel();

      if (!val) {
        isVersionBlocked = false;
        versionAdvisory.style.display = 'none';
        versionAdvisory.innerHTML = '';
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.title = '';
        }
        return;
      }

      const advisory = checkAppVersionAdvisory({
        channel,
        version: val,
        allStable: releasesData.stable,
        allBeta: releasesData.beta,
        latestStable: releasesData.latest.stable,
        latestBeta: releasesData.latest.beta,
      });

      isVersionBlocked = advisory.blocked;

      if (advisory.message) {
        let icon = '';
        if (advisory.type === 'blocked') {
          icon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;margin-top:1px;"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>`;
        } else if (advisory.type === 'warning') {
          icon = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;margin-top:1px;"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`;
        } else {
          icon = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;margin-top:1px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>`;
        }

        versionAdvisory.className = `advisory-box ${advisory.type}`;
        versionAdvisory.innerHTML = `${icon}<span>${advisory.message}</span>`;
        versionAdvisory.style.display = 'flex';

        if (submitBtn) {
          if (advisory.blocked) {
            submitBtn.disabled = true;
            submitBtn.title = 'Please update your app to the latest release before submitting a bug report.';
          } else {
            submitBtn.disabled = false;
            submitBtn.title = '';
          }
        }
      } else {
        versionAdvisory.style.display = 'none';
        versionAdvisory.innerHTML = '';
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.title = '';
        }
      }
    }

    function updatePluginVersionAdvisory() {
      if (!pluginVerInput || !pluginAdvisory || !releasesData) return;
      const val = pluginVerInput.value.trim();

      if (!val) {
        pluginAdvisory.style.display = 'none';
        pluginAdvisory.innerHTML = '';
        return;
      }

      const advisory = checkPluginVersionAdvisory(val, releasesData.latest.plugin);
      if (advisory.message) {
        const icon = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;margin-top:1px;"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`;
        pluginAdvisory.className = `advisory-box ${advisory.type}`;
        pluginAdvisory.innerHTML = `${icon}<span>${advisory.message}</span>`;
        pluginAdvisory.style.display = 'flex';
      } else {
        pluginAdvisory.style.display = 'none';
        pluginAdvisory.innerHTML = '';
      }
    }

    function getSelectedKind(): string {
      const checked = document.querySelector('input[name="kind"]:checked') as HTMLInputElement | null;
      if (checked) return checked.value;
      const hidden = document.querySelector('input[name="kind"]') as HTMLInputElement | null;
      if (hidden) return hidden.value;
      return 'bug';
    }

    const NON_IOS_SOURCES = ['mihon_aniyomi', 'cloudstream', 'kotatsu'];

    function updatePlatformVisibility() {
      const currentKind = getSelectedKind();
      const catSelect = document.querySelector('select[name="category"]') as HTMLSelectElement | null;
      const platSelect = document.querySelector('select[name="platform"]') as HTMLSelectElement | null;

      const currentCat = catSelect ? catSelect.value : ((document.querySelector('input[name="category"]:checked') as HTMLInputElement | null)?.value ?? '');
      const iosOption = platSelect ? (platSelect.querySelector('option[data-platform="ios"]') as HTMLOptionElement | null) : null;
      const iosLabel = document.querySelector('label[data-platform="ios"]') as HTMLLabelElement | null;
      const iosRadio = document.querySelector('input[name="platform"][value="ios"]') as HTMLInputElement | null;

      const hideIos = currentKind === 'extension' && NON_IOS_SOURCES.includes(currentCat);

      if (iosOption) {
        iosOption.disabled = hideIos;
        iosOption.hidden = hideIos;
        if (hideIos && platSelect && platSelect.value === 'ios') {
          platSelect.value = '';
        }
      }

      if (iosLabel) {
        iosLabel.style.display = hideIos ? 'none' : '';
      }

      if (hideIos && iosRadio?.checked) {
        iosRadio.checked = false;
        iosLabel?.classList.remove('active');
      }

      updatePluginVisibility();
    }

    function updatePluginVisibility() {
      const currentKind = getSelectedKind();
      const catSelect = document.querySelector('select[name="category"]') as HTMLSelectElement | null;
      const platSelect = document.querySelector('select[name="platform"]') as HTMLSelectElement | null;

      const currentCat = catSelect ? catSelect.value : ((document.querySelector('input[name="category"]:checked') as HTMLInputElement | null)?.value ?? '');
      const currentPlat = platSelect ? platSelect.value : ((document.querySelector('input[name="platform"]:checked') as HTMLInputElement | null)?.value ?? '');

      const isExtensionRelevant = currentKind === 'extension';
      const isIos = currentPlat === 'ios';

      if (pluginGroup) {
        pluginGroup.style.display = isExtensionRelevant && !isIos ? '' : 'none';
      }
      if (pluginVerInput) {
        pluginVerInput.required = isExtensionRelevant && !isIos;
      }
      if (iosPluginNote) {
        iosPluginNote.style.display = isExtensionRelevant && isIos ? '' : 'none';
      }
      if (isIos && pluginVerInput) {
        pluginVerInput.value = '';
        pluginCombobox?.close();
        updatePluginVersionAdvisory();
      }
    }

    // Initialize custom comboboxes
    const appCombobox = setupCombobox({
      inputEl: appVerInput,
      toggleBtn: appToggleBtn,
      dropdownEl: appDropdown,
      getItems: () => {
        if (!releasesData) return [];
        const channel = getSelectedChannel();
        const list = channel === 'beta' ? releasesData.beta : releasesData.stable;
        return list.map((item) => ({
          version: item.version,
          name: item.name,
          isLatest: item.isLatest,
          publishedAt: item.publishedAt,
          badgeLabel: item.isLatest ? `Latest ${channel === 'beta' ? 'Beta' : 'Stable'}` : undefined,
        }));
      },
      onSelect: () => {
        updateAppVersionAdvisory();
      },
    });

    const pluginCombobox = setupCombobox({
      inputEl: pluginVerInput,
      toggleBtn: pluginToggleBtn,
      dropdownEl: pluginDropdown,
      getItems: () => {
        if (!releasesData) return [];
        return releasesData.plugin.map((item) => ({
          version: item.version,
          name: item.name,
          isLatest: item.isLatest,
          publishedAt: item.publishedAt,
          badgeLabel: item.isLatest ? 'Latest' : undefined,
        }));
      },
      onSelect: () => {
        updatePluginVersionAdvisory();
      },
    });

    // Close comboboxes when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target?.closest('#app-combobox')) {
        appCombobox?.close();
      }
      if (!target?.closest('#plugin-combobox')) {
        pluginCombobox?.close();
      }
    });

    // Initialize initial advisory and visibility state
    updateAppVersionAdvisory();
    updatePluginVersionAdvisory();
    updatePlatformVisibility();

    // Channel change listener: empty version, reset placeholder, close combobox, update advisory
    const channelRadios = document.querySelectorAll<HTMLInputElement>('input[name="releaseChannel"]');
    channelRadios.forEach((r) => {
      r.addEventListener('change', () => {
        const channel = getSelectedChannel();
        if (appVerInput) {
          appVerInput.value = '';
          appVerInput.placeholder = channel === 'beta' ? 'e.g. 3.1.6+4-beta' : 'e.g. 3.1.7';
        }
        appCombobox?.close();
        updateAppVersionAdvisory();
      });
    });

    appVerInput?.addEventListener('input', () => {
      const val = appVerInput.value;
      if (/beta|preview/i.test(val)) {
        const betaRadio = document.querySelector('input[name="releaseChannel"][value="beta"]') as HTMLInputElement | null;
        if (betaRadio && !betaRadio.checked) {
          betaRadio.checked = true;
          if (appVerInput) {
            appVerInput.placeholder = 'e.g. 3.1.6+4-beta';
          }
        }
      }
      updateAppVersionAdvisory();
    });

    pluginVerInput?.addEventListener('input', updatePluginVersionAdvisory);

    // Platform and Category change listeners
    const platRadios = document.querySelectorAll<HTMLInputElement>('input[name="platform"]');
    platRadios.forEach((r) => r.addEventListener('change', updatePluginVisibility));

    const catRadios = document.querySelectorAll<HTMLInputElement>('input[name="category"]');
    catRadios.forEach((r) => r.addEventListener('change', updatePlatformVisibility));

    const catSelectEl = document.getElementById('category-select');
    catSelectEl?.addEventListener('change', updatePlatformVisibility);

    const platSelectEl = document.getElementById('platform-select');
    platSelectEl?.addEventListener('change', updatePluginVisibility);

    // Delegated listener on form to catch all platform / category changes reliably
    form?.addEventListener('change', (e) => {
      const target = e.target as HTMLElement | null;
      if (target && (target.matches('input[name="platform"], select[name="platform"]') || target.matches('input[name="category"], select[name="category"]') || target.matches('input[name="kind"]'))) {
        updatePlatformVisibility();
      }
    });

    // ── Dynamic Kind Switcher ──────────────────────────────────────────
    const kindRadios = document.querySelectorAll<HTMLInputElement>('input[name="kind"]');
    kindRadios.forEach((radio) => {
      radio.addEventListener('change', () => {
        if (radio.checked) {
          const url = new URL(window.location.href);
          url.searchParams.set('kind', radio.value);
          window.location.href = url.toString();
        }
      });
    });

    // ── Live Similar Reports Debounce ──────────────────────────────────
    const titleInput = document.getElementById('title') as HTMLInputElement | null;
    const similarBox = document.getElementById('similar-reports');
    const similarList = document.getElementById('similar-list');
    let similarTimer: number | undefined;

    titleInput?.addEventListener('input', () => {
      window.clearTimeout(similarTimer);
      const val = titleInput.value.trim();
      if (val.length < 4) {
        if (similarBox) similarBox.style.display = 'none';
        return;
      }
      similarTimer = window.setTimeout(async () => {
        try {
          const kindVal = getSelectedKind();
          const res = await fetch(`/api/v1/similar?q=${encodeURIComponent(val)}&kind=${encodeURIComponent(kindVal)}`);
          if (!res.ok) return;
          const data = await res.json();
          if (data.results?.length > 0 && similarList && similarBox) {
            similarList.innerHTML = data.results.map((r: any) => `
              <li class="similar-item">
                <a href="/report/${r.id}" target="_blank" class="similar-link">
                  <span class="similar-title">#${r.id} ${r.title}</span>
                  <span class="similar-meta">
                    <span class="tag">${r.categoryLabel ?? r.category}</span>
                    <span class="tag">${r.platformLabel ?? r.platform}</span>
                    <span class="similar-votes">${r.votes} votes</span>
                  </span>
                </a>
              </li>
            `).join('');
            similarBox.style.display = '';
          } else if (similarBox) {
            similarBox.style.display = 'none';
          }
        } catch {
          // ignore network glitch
        }
      }, 350);
    });

    // ── Crash Log / Diagnostics Parser ────────────────────────────────
    const logInput = document.getElementById('diagnostics-input') as HTMLTextAreaElement | null;
    const parseBtn = document.getElementById('parse-log-btn') as HTMLButtonElement | null;
    const logStatus = document.getElementById('log-status');
    const bodyInput = document.getElementById('body') as HTMLTextAreaElement | null;

    parseBtn?.addEventListener('click', () => {
      const raw = logInput?.value.trim() ?? '';
      if (!raw) return;

      const verMatch = raw.match(/(?:AnymeX|version|app[_\s-]?ver|build)[\s:=v]+([0-9]+\.[0-9]+(?:\.[0-9]+)?(?:[+-_a-zA-Z0-9]+)?)/i);
      if (verMatch && appVerInput) {
        appVerInput.value = verMatch[1].trim();
        if (/beta|preview/i.test(verMatch[1])) {
          const betaRadio = document.querySelector('input[name="releaseChannel"][value="beta"]') as HTMLInputElement | null;
          if (betaRadio) {
            betaRadio.checked = true;
            updateAppVersionDatalist();
          }
        }
        updateAppVersionAdvisory();
      }

      const androidMatch = raw.match(/Android[\s:]+([0-9]+(?:\.[0-9]+)?)/i);
      const platRadio = document.querySelector('input[name="platform"][value="android"]') as HTMLInputElement | null;
      if (androidMatch && platRadio) platRadio.checked = true;

      if (bodyInput && !bodyInput.value.includes('### Crash Diagnostics')) {
        bodyInput.value = (bodyInput.value ? bodyInput.value + '\n\n' : '') +
          '### Crash Diagnostics\n```\n' + raw.slice(0, 2000) + '\n```';
      }

      if (logStatus) {
        logStatus.textContent = '✓ Extracted details to form fields';
      }
    });

    // ── Dynamic Extension List (Name + Version Rows) ───────────────────
    const extList = document.getElementById('extension-list');
    const addExtBtn = document.getElementById('add-extension-btn');

    function updateRemoveButtonsState() {
      if (!extList) return;
      const cards = extList.querySelectorAll('.extension-card');
      cards.forEach((card, idx) => {
        const numLabel = card.querySelector('.ext-card-num');
        if (numLabel) numLabel.textContent = `Extension #${idx + 1}`;
      });
      const removeBtns = extList.querySelectorAll<HTMLButtonElement>('.ext-remove-btn');
      removeBtns.forEach((btn) => {
        btn.disabled = cards.length <= 1;
      });
      if (addExtBtn) {
        addExtBtn.style.display = cards.length >= 10 ? 'none' : 'inline-flex';
      }
    }

    function attachRemoveListener(btn: HTMLButtonElement) {
      btn.addEventListener('click', () => {
        const card = btn.closest('.extension-card');
        if (!card || !extList) return;
        const cards = extList.querySelectorAll('.extension-card');
        if (cards.length <= 1) return;
        card.remove();
        updateRemoveButtonsState();
      });
    }

    extList?.querySelectorAll<HTMLButtonElement>('.ext-remove-btn').forEach(attachRemoveListener);

    addExtBtn?.addEventListener('click', () => {
      if (!extList) return;
      const cards = extList.querySelectorAll('.extension-card');
      if (cards.length >= 10) return;

      const newIdx = Date.now();
      const card = document.createElement('div');
      card.className = 'extension-card card-enter';
      card.dataset.index = String(newIdx);
      card.innerHTML = `
        <div class="ext-card-header">
          <span class="ext-card-num">Extension #${cards.length + 1}</span>
          <button
            type="button"
            class="ext-remove-btn"
            title="Remove extension"
            aria-label="Remove extension"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="ext-card-top-row">
          <div class="ext-col ext-col-name">
            <label class="ext-sublabel" for="ext-name-${newIdx}">
              Extension Name <span class="required-star">*</span>
            </label>
            <input
              class="input ext-name-input"
              id="ext-name-${newIdx}"
              name="extensionName"
              type="text"
              maxlength="150"
              placeholder="e.g. Gogoanime"
              required
            />
          </div>
          <div class="ext-col ext-col-version">
            <label class="ext-sublabel" for="ext-ver-${newIdx}">
              Version <span class="required-star">*</span>
            </label>
            <input
              class="input ext-ver-input"
              id="ext-ver-${newIdx}"
              name="extensionVersion"
              type="text"
              maxlength="50"
              placeholder="e.g. 1.4.2"
              required
            />
          </div>
        </div>

        <div class="ext-card-issue-row">
          <label class="ext-sublabel" for="ext-issue-${newIdx}">
            What is wrong with this extension? <span class="required-star">*</span>
          </label>
          <textarea
            class="textarea ext-issue-input"
            id="ext-issue-${newIdx}"
            name="extensionIssue"
            rows="2"
            maxlength="3000"
            placeholder="Describe what happens specifically with this extension (e.g. video player returns 403 error, search is empty, etc.)."
            required
          ></textarea>
        </div>
      `;

      extList.appendChild(card);
      const removeBtn = card.querySelector<HTMLButtonElement>('.ext-remove-btn');
      if (removeBtn) attachRemoveListener(removeBtn);
      updateRemoveButtonsState();

      const nameInput = card.querySelector<HTMLInputElement>('.ext-name-input');
      nameInput?.focus();
    });

    // File selection handling
    fileInput?.addEventListener('change', () => {
      for (const f of Array.from(fileInput.files ?? [])) {
        if (selectedFiles.length >= 10) break;
        if (!selectedFiles.find(x => x.name === f.name && x.size === f.size)) {
          selectedFiles.push(f);
        }
      }
      fileInput.value = '';
      renderFiles();
    });

    // Drag and drop
    const dropzone = document.querySelector('.upload-dropzone');
    dropzone?.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.classList.add('drag-over'); });
    dropzone?.addEventListener('dragleave', () => { dropzone.classList.remove('drag-over'); });
    dropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('drag-over');
      for (const f of Array.from(e.dataTransfer.files)) {
        if (selectedFiles.length >= 10) break;
        if (!selectedFiles.find(x => x.name === f.name && x.size === f.size)) {
          selectedFiles.push(f);
        }
      }
      renderFiles();
    });

    function renderFiles() {
      if (!fileList) return;
      fileList.innerHTML = '';
      selectedFiles.forEach((f, i) => {
        const size = f.size > 1024 * 1024
          ? `${(f.size / (1024 * 1024)).toFixed(1)} MB`
          : `${(f.size / 1024).toFixed(0)} KB`;
        const div = document.createElement('div');
        div.className = 'file-item';
        div.innerHTML = `<span class="file-name">${f.name}</span><span class="file-size">${size}</span><button type="button" class="file-remove" data-index="${i}">&times;</button>`;
        div.querySelector('.file-remove')?.addEventListener('click', () => { selectedFiles.splice(i, 1); renderFiles(); });
        fileList.appendChild(div);
      });
    }

    // Form submission with file upload
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (isVersionBlocked) {
        alert('Cannot submit bug report: your reported app version is outdated. Please update your app or test on the latest release before filing a bug report.');
        return;
      }

      const activeKindValue = getSelectedKind();
      if ((activeKindValue === 'bug' || activeKindValue === 'extension') && selectedFiles.length === 0) {
        alert(activeKindValue === 'extension'
          ? 'At least one attachment is required (side-by-side comparison showing native app vs AnymeX).'
          : 'At least one attachment (screenshot, recording, or log file) is required.'
        );
        document.getElementById('upload-area')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting…';

      try {
        const fd = new FormData(form);
        // Remove file input from form data (we upload separately)
        fd.delete('files');
        fd.set('attachmentCount', String(selectedFiles.length));

        const res = await fetch('/new', {
          method: 'POST',
          body: fd,
          headers: { 'accept': 'application/json' },
        });

        if (!res.ok) {
          submitBtn.disabled = false;
          submitBtn.textContent = submitBtn.dataset.label ?? 'Submit';
          // Try to get error from JSON, fall back to redirect (non-JSON error)
          const ct = res.headers.get('content-type');
          if (ct?.includes('application/json')) {
            const data = await res.json().catch(() => null);
            if (data?.error) { alert(data.error); return; }
          }
          // Non-JSON response (e.g. redirect to /cant-post) — follow it
          const loc = res.headers.get('location');
          if (loc) { window.location.href = loc; return; }
          alert('Something went wrong.');
          return;
        }

        const data = await res.json();
        if (!data?.id) { alert('Something went wrong.'); return; }

        // Dedup: joined an existing report
        if (data.joined) {
          window.location.href = `/report/${data.id}?joined=1`;
          return;
        }

        // Upload selected files. We must check each /upload response — the
        // server rejects unsupported MIME types, oversized files, etc., and
        // swallowing those errors here is what made attachments silently fail
        // to appear on the report. Surface every failure so the user knows.
        const failed: { name: string; reason: string }[] = [];
        if (selectedFiles.length > 0) {
          submitBtn.textContent = `Uploading ${selectedFiles.length} file${selectedFiles.length > 1 ? 's' : ''}…`;
          let uploaded = 0;
          for (const file of selectedFiles) {
            const uploadFd = new FormData();
            uploadFd.append('file', file);
            uploadFd.append('reportId', String(data.id));
            try {
              const upRes = await fetch('/upload', { method: 'POST', body: uploadFd });
              if (!upRes.ok) {
                let reason = upRes.statusText || `error ${upRes.status}`;
                try {
                  const body = await upRes.json();
                  if (body?.error) reason = body.error;
                } catch { /* not JSON */ }
                // 401 means the session expired mid-flow — send to login.
                if (upRes.status === 401) {
                  window.location.href = `/auth/login?next=/report/${data.id}`;
                  return;
                }
                failed.push({ name: file.name, reason });
              }
            } catch (err) {
              failed.push({ name: file.name, reason: 'network error' });
            }
            uploaded++;
            submitBtn.textContent = `Uploading ${uploaded}/${selectedFiles.length}…`;
          }
        }

        if (failed.length > 0) {
          const allFailed = failed.length === selectedFiles.length;
          const msg = (allFailed ? 'No attachments were uploaded.\n\n' : `${failed.length} attachment(s) failed to upload.\n\n`)
            + failed.map((f) => `• ${f.name}: ${f.reason}`).join('\n')
            + '\n\nYour report was still created. Open it and attach the files in a follow-up comment, or retry from the report page — any file type is accepted.';
          // Re-enable the submit button so the user can recover, then send
          // them to the report (it already exists) so nothing is lost.
          submitBtn.disabled = false;
          submitBtn.textContent = submitBtn.dataset.label ?? 'Submit';
          alert(msg);
          window.location.href = `/report/${data.id}?filed=1`;
          return;
        }

        window.location.href = `/report/${data.id}?filed=1`;
      } catch {
        alert('Network error — please try again.');
        submitBtn.disabled = false;
        submitBtn.textContent = submitBtn.dataset.label ?? 'Submit';
      }
    });
  </script>

  <p class="foot-note">
    Already reported by someone else? Submitting adds you to their report instead
    of making a duplicate.
  </p>
</Base>

