<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Tab Switching
    const tabBtns = document.querySelectorAll('.profile-tab-btn');
    const tabPanes = document.querySelectorAll('.profile-tab-pane');

    function switchTab(tabId) {
      tabBtns.forEach(btn => {
        const isTarget = btn.getAttribute('data-tab-target') === tabId;
        btn.classList.toggle('active', isTarget);
        btn.setAttribute('aria-selected', isTarget ? 'true' : 'false');
      });

      tabPanes.forEach(pane => {
        const isTarget = pane.getAttribute('data-tab-pane') === tabId;
        pane.classList.toggle('active', isTarget);
        pane.hidden = !isTarget;
      });

      if (history.replaceState) {
        history.replaceState(null, '', `#${tabId}`);
      }
    }

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab-target');
        if (target) switchTab(target);
      });
    });

    // Check URL Hash on load
    const hash = window.location.hash.replace('#', '');
    if (hash && ['reports', 'badges', 'overview'].includes(hash)) {
      switchTab(hash);
    }

    // 2. Report Filtering & Search
    const searchInput = document.getElementById('user-reports-search');
    const kindChips = document.querySelectorAll('[data-kind-filter]');
    const reportCards = document.querySelectorAll('#user-reports-list .user-report-card');
    const emptySearch = document.getElementById('reports-empty-search');
    let currentKind = 'all';

    function applyReportFilters() {
      const q = (searchInput && searchInput.value ? searchInput.value : '').trim().toLowerCase();
      let visible = 0;

      reportCards.forEach(card => {
        const kind = card.getAttribute('data-kind');
        const text = card.getAttribute('data-search') || '';

        const matchKind = currentKind === 'all' || kind === currentKind;
        const matchSearch = !q || text.includes(q);
        const isVisible = matchKind && matchSearch;

        card.hidden = !isVisible;
        card.style.display = isVisible ? '' : 'none';
        if (isVisible) visible++;
      });

      if (emptySearch) {
        emptySearch.hidden = visible > 0;
        emptySearch.style.display = visible > 0 ? 'none' : 'block';
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', applyReportFilters);
    }

    kindChips.forEach(chip => {
      chip.addEventListener('click', () => {
        kindChips.forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        currentKind = chip.getAttribute('data-kind-filter') || 'all';
        applyReportFilters();
      });
    });
  });
</script>

