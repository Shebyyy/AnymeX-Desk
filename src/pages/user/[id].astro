---
import Base from '../../layouts/Base.astro';
import { db } from '../../lib/db/client';
import { reports, votes, users } from '../../lib/db/schema';
import { eq, sql } from 'drizzle-orm';
import { avatarUrl, currentUser } from '../../lib/auth';
import { relativeAge, kindLabel, categoryLabel, platformLabel, statusLabel } from '../../lib/format';
import { computeBadges, type UserStats, ALL_BADGES } from '../../lib/badges';
import { levelOf, LEVEL_LABELS } from '../../lib/staff';
import { atLeast } from '../../lib/levels';
import { getPresence } from '../../lib/presence';

export const prerender = false;

const targetId = String(Astro.params.id ?? '').trim();
if (!/^(tg:\d+|\d{17,20})$/.test(targetId)) return Astro.rewrite('/404');

const [userRow] = await db().select().from(users).where(eq(users.discordId, targetId));
if (!userRow) return Astro.rewrite('/404');

// User's filed reports
const userReports = await db()
  .select({
    id: reports.id,
    kind: reports.kind,
    category: reports.category,
    platform: reports.platform,
    title: reports.title,
    status: reports.status,
    votes: reports.votes,
    commentCount: reports.commentCount,
    createdAt: reports.createdAt,
  })
  .from(reports)
  .where(eq(reports.reporterId, targetId))
  .orderBy(sql`${reports.createdAt} DESC`);

// Total votes user has cast
const votesGivenRows = await db().all(sql`
  SELECT COUNT(*) AS c FROM votes WHERE discord_id = ${targetId}
`) as { c: number }[];
const votesGivenCount = votesGivenRows[0]?.c ?? 0;

// Calculate stats
const reportsCount = userReports.length;
const fixedCount = userReports.filter((r) => r.status === 'fixed').length;
const totalVotesReceived = userReports.reduce((sum, r) => sum + r.votes, 0);
const hasExtensionFix = userReports.some((r) => r.kind === 'extension' && r.status === 'fixed');
const hasTopSuggestion = userReports.some((r) => r.kind === 'suggestion' && r.votes >= 20);
const staffLevel = await levelOf(targetId);
const isStaff = staffLevel !== 'user';

// Sub-counts
const bugReportsCount = userReports.filter((r) => r.kind === 'bug').length;
const suggestionReportsCount = userReports.filter((r) => r.kind === 'suggestion').length;
const extensionReportsCount = userReports.filter((r) => r.kind === 'extension').length;
const fixRate = reportsCount > 0 ? Math.round((fixedCount / reportsCount) * 100) : 0;
const avgVotes = reportsCount > 0 ? (totalVotesReceived / reportsCount).toFixed(1) : '0';

const stats: UserStats = {
  reportsCount,
  fixedCount,
  totalVotesReceived,
  votesGivenCount,
  hasExtensionFix,
  hasTopSuggestion,
  isStaff,
};

const badges = computeBadges(stats);
const earnedBadgeIds = new Set(badges.map((b) => b.id));
const allBadgesList = Object.values(ALL_BADGES);

const isDiscordLinked = userRow.discordLinked !== false && !userRow.discordId.startsWith('tg:');
const isTelegramLinked = !!userRow.telegramId;
const avatar =
  userRow.telegramPhotoUrl ||
  avatarUrl({ id: userRow.discordId, avatarHash: userRow.avatarHash }, 128);

const initial = (userRow.username || '?')[0].toUpperCase();

const viewer = await currentUser(Astro);
const viewerLevel = viewer ? await levelOf(viewer.id) : 'user';
const nowSeconds = Math.floor(Date.now() / 1000);
const isSelf = !!(viewer && (viewer.id === targetId || (userRow.telegramId && viewer.telegramId === userRow.telegramId)));
const canViewPresence = isViewerStaff || isSelf;
const effectiveLastSeen = isSelf ? nowSeconds : (userRow.lastSeen || userRow.lastLogin);
const presence = canViewPresence ? getPresence(effectiveLastSeen, userRow.lastLogin, nowSeconds) : null;

if (isSelf && viewer) {
  const cf = Astro.locals.cfContext;
  const touchPromise = db()
    .update(users)
    .set({ lastSeen: nowSeconds })
    .where(eq(users.discordId, userRow.discordId));
  if (cf) cf.waitUntil(touchPromise);
  else touchPromise.catch(() => {});
}

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=120, stale-while-revalidate=300');
---

<Base title={`${userRow.username} · Contributor Profile`}>
  <!-- Contributor Profile Hero Header -->
  <header class="profile-hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-body">
      <div class="avatar-container">
        <div class="avatar-presence-wrap">
          {avatar ? (
            <img class="hero-avatar" src={avatar} alt={userRow.username} width="88" height="88" />
          ) : (
            <div class="hero-avatar hero-avatar-fallback">{initial}</div>
          )}
          {presence && (
            <span
              class:list={['presence-cutout-dot', `presence-${presence.status}`]}
              title={isViewerStaff ? `Staff Telemetry: ${presence.label}` : presence.label}
            ></span>
          )}
        </div>
        {isStaff && (
          <div class="avatar-staff-indicator" title={`Verified ${LEVEL_LABELS[staffLevel]}`}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" />
            </svg>
          </div>
        )}
      </div>

      <div class="hero-info">
        <div class="hero-title-row">
          <h1 class="hero-username">{userRow.username}</h1>
          {isStaff ? (
            <span class={`staff-pill staff-${staffLevel}`}>
              {LEVEL_LABELS[staffLevel]}
            </span>
          ) : (
            <span class="staff-pill staff-community">Contributor</span>
          )}
        </div>

        <div class="hero-meta-row">
          {isDiscordLinked && (
            <a
              href={`https://discord.com/users/${userRow.discordUserId || userRow.discordId}`}
              target="_blank"
              rel="noopener noreferrer"
              class="profile-link-chip discord-chip"
              title="Open Discord Profile"
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
              </svg>
              <span>@{userRow.username}</span>
            </a>
          )}
          {isTelegramLinked && (
            <a
              href={userRow.telegramUsername ? `https://t.me/${userRow.telegramUsername}` : undefined}
              target="_blank"
              rel="noopener noreferrer"
              class="profile-link-chip telegram-chip"
              title="Open Telegram Profile"
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
              </svg>
              <span>{userRow.telegramUsername ? `@${userRow.telegramUsername}` : 'Telegram'}</span>
            </a>
          )}
          {presence && (
            <span class="profile-link-chip presence-chip" title={isViewerStaff ? 'Telemetry visible to Staff only' : 'Your live presence'}>
              <span class:list={['presence-inline-dot', `dot-${presence.status}`]}></span>
              <span>{presence.label}</span>
              {isViewerStaff && !isSelf && (
                <span class="staff-tag-mini">Staff View</span>
              )}
            </span>
          )}
          <span class="hero-tenure">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            <span>Joined {relativeAge(userRow.firstSeen)} ago</span>
          </span>
        </div>
      </div>
    </div>
  </header>

  <!-- 4 High-Impact KPI Metric Cards -->
  <section class="kpi-grid" aria-label="Contribution metrics">
    <div class="kpi-card kpi-blue">
      <div class="kpi-header">
        <span class="kpi-label">Reports Filed</span>
        <span class="kpi-icon-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" y1="13" x2="8" y2="13" />
            <line x1="16" y1="17" x2="8" y2="17" />
          </svg>
        </span>
      </div>
      <div class="kpi-value num">{reportsCount}</div>
      <div class="kpi-sub">Total issues &amp; ideas</div>
    </div>

    <div class="kpi-card kpi-green">
      <div class="kpi-header">
        <span class="kpi-label">Bugs Resolved</span>
        <span class="kpi-icon-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </span>
      </div>
      <div class="kpi-value num">{fixedCount}</div>
      <div class="kpi-sub">{fixRate}% resolution rate</div>
    </div>

    <div class="kpi-card kpi-amber">
      <div class="kpi-header">
        <span class="kpi-label">Votes Received</span>
        <span class="kpi-icon-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
          </svg>
        </span>
      </div>
      <div class="kpi-value num">{totalVotesReceived}</div>
      <div class="kpi-sub">~{avgVotes} votes per report</div>
    </div>

    <div class="kpi-card kpi-purple">
      <div class="kpi-header">
        <span class="kpi-label">Votes Cast</span>
        <span class="kpi-icon-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 19V5" />
            <polyline points="5 12 12 5 19 12" />
          </svg>
        </span>
      </div>
      <div class="kpi-value num">{votesGivenCount}</div>
      <div class="kpi-sub">Community engagement</div>
    </div>
  </section>

  <!-- Interactive Profile Tabs Navigation -->
  <nav class="profile-tabs-nav" aria-label="Profile sections">
    <button type="button" class="profile-tab-btn active" data-tab-target="reports" role="tab" aria-selected="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
        <polyline points="14 2 14 8 20 8" />
      </svg>
      <span>Reports Filed</span>
      <span class="tab-count">{userReports.length}</span>
    </button>

    <button type="button" class="profile-tab-btn" data-tab-target="badges" role="tab" aria-selected="false">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="8" r="7" />
        <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88" />
      </svg>
      <span>Badges &amp; Achievements</span>
      <span class="tab-count">{badges.length}</span>
    </button>

    <button type="button" class="profile-tab-btn" data-tab-target="overview" role="tab" aria-selected="false">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="20" x2="18" y2="10" />
        <line x1="12" y1="20" x2="12" y2="4" />
        <line x1="6" y1="20" x2="6" y2="14" />
      </svg>
      <span>Overview &amp; Stats</span>
    </button>
  </nav>

  <!-- TAB 1: REPORTS FILED -->
  <div class="profile-tab-pane active" id="pane-reports" data-tab-pane="reports">
    <div class="tab-pane-content">
      <div class="reports-toolbar">
        <div class="reports-kind-filters" role="group" aria-label="Filter reports by kind">
          <button type="button" class="report-filter-chip active" data-kind-filter="all">
            All ({userReports.length})
          </button>
          <button type="button" class="report-filter-chip" data-kind-filter="bug">
            Bugs ({bugReportsCount})
          </button>
          <button type="button" class="report-filter-chip" data-kind-filter="suggestion">
            Suggestions ({suggestionReportsCount})
          </button>
          <button type="button" class="report-filter-chip" data-kind-filter="extension">
            Extensions ({extensionReportsCount})
          </button>
        </div>

        <div class="report-search-wrap">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input
            type="search"
            id="user-reports-search"
            class="report-search-input"
            placeholder="Search reports..."
            autocomplete="off"
          />
        </div>
      </div>

      {userReports.length === 0 ? (
        <div class="empty-state-card">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
          </svg>
          <h3>No reports filed yet</h3>
          <p>This contributor hasn't submitted any bug reports or suggestions so far.</p>
        </div>
      ) : (
        <>
          <p class="empty-line" id="reports-empty-search" hidden style="display: none; padding: var(--space-4); text-align: center;">
            No reports match the current filter or search criteria.
          </p>
          <ol class="user-report-list" id="user-reports-list">
            {userReports.map((r) => (
              <li
                class="user-report-card"
                data-kind={r.kind}
                data-search={`${r.title} ${r.category} ${r.platform} ${r.status}`.toLowerCase()}
              >
                <div class="user-report-main">
                  <div class="report-header-line">
                    <span class={`kind-tag kind-${r.kind}`}>{kindLabel(r.kind)}</span>
                    <a href={`/report/${r.id}`} class="user-report-title">
                      <span class="report-num">#{r.id}</span> {r.title}
                    </a>
                  </div>
                  <div class="user-report-tags">
                    <span class="tag-meta">{categoryLabel(r.category)}</span>
                    <span class="tag-meta">{platformLabel(r.platform)}</span>
                    <span class={`status-badge status-${r.status}`}>{statusLabel(r.status)}</span>
                    <span class="report-time">Filed {relativeAge(r.createdAt)} ago</span>
                    {r.commentCount > 0 && (
                      <span class="report-comment-count" title={`${r.commentCount} comments`}>
                        💬 {r.commentCount}
                      </span>
                    )}
                  </div>
                </div>
                <div class="user-report-vote-box" title={`${r.votes} upvotes`}>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 4l-8 8h6v8h4v-8h6z" />
                  </svg>
                  <span class="num">{r.votes}</span>
                </div>
              </li>
            ))}
          </ol>
        </>
      )}
    </div>
  </div>

  <!-- TAB 2: BADGES & ACHIEVEMENTS -->
  <div class="profile-tab-pane" id="pane-badges" data-tab-pane="badges" hidden>
    <div class="tab-pane-content">
      <div class="badges-showcase-header">
        <div>
          <h3>Contributor Achievements</h3>
          <p class="section-subtext">Badges are awarded automatically based on report activity, helpfulness, and community support.</p>
        </div>
        <div class="badges-progress-pill">
          <span>{badges.length} of {allBadgesList.length} Unlocked</span>
        </div>
      </div>

      <div class="badges-grid">
        {allBadgesList.map((b) => {
          const unlocked = earnedBadgeIds.has(b.id);
          return (
            <div class:list={['badge-card', { 'is-unlocked': unlocked, 'is-locked': !unlocked }]} style={`--badge-color: ${b.color};`}>
              <div class="badge-icon-box">
                {b.iconType === 'bug' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m8 2 1.88 1.88"/><path d="M14.12 3.88 16 2"/><path d="M9 7.13v-1a3.003 3.003 0 1 1 6 0v1"/><path d="M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6"/><path d="M12 20v-9"/><path d="M6.53 9C4.6 8.8 3 7.1 3 5"/><path d="M6 13H2"/><path d="M3 21c0-2.1 1.7-3.9 3.8-4"/><path d="M20.97 5c0 2.1-1.6 3.8-3.5 4"/><path d="M22 13h-4"/><path d="M17.2 17c2.1.1 3.8 1.9 3.8 4"/>
                  </svg>
                )}
                {b.iconType === 'idea' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>
                  </svg>
                )}
                {b.iconType === 'puzzle' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 2v6"/><path d="m19 13-4-4"/><path d="M10 2v6"/><path d="m5 13 4-4"/><path d="M7 16a6 6 0 0 0 12 0l-2-2H9l-2 2z"/><path d="M12 22v-4"/>
                  </svg>
                )}
                {b.iconType === 'flame' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
                  </svg>
                )}
                {b.iconType === 'shield' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>
                  </svg>
                )}
              </div>
              <div class="badge-info">
                <div class="badge-title-row">
                  <span class="badge-name">{b.name}</span>
                  {unlocked ? (
                    <span class="badge-status-pill unlocked">Unlocked</span>
                  ) : (
                    <span class="badge-status-pill locked">Locked</span>
                  )}
                </div>
                <p class="badge-desc">{b.description}</p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- TAB 3: OVERVIEW & STATS -->
  <div class="profile-tab-pane" id="pane-overview" data-tab-pane="overview" hidden>
    <div class="tab-pane-content">
      <div class="overview-grid">
        <!-- Distribution Panel -->
        <div class="overview-panel">
          <h3>Submission Breakdown</h3>
          <p class="section-subtext">Distribution of contributions across tracker categories.</p>
          <div class="distribution-bars">
            <div class="dist-row">
              <span class="dist-label">Bugs ({bugReportsCount})</span>
              <div class="dist-bar-track">
                <div
                  class="dist-bar-fill bug"
                  style={`width: ${reportsCount > 0 ? (bugReportsCount / reportsCount) * 100 : 0}%`}
                ></div>
              </div>
              <span class="dist-pct num">
                {reportsCount > 0 ? Math.round((bugReportsCount / reportsCount) * 100) : 0}%
              </span>
            </div>

