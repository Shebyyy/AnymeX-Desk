---
import Base from '../../layouts/Base.astro';
import { db } from '../../lib/db/client';
import { reports, votes, users } from '../../lib/db/schema';
import { eq, sql } from 'drizzle-orm';
import { avatarUrl } from '../../lib/auth';
import { relativeAge, kindLabel, categoryLabel, platformLabel, statusLabel } from '../../lib/format';
import { computeBadges, type UserStats } from '../../lib/badges';
import { levelOf } from '../../lib/staff';

export const prerender = false;

const targetId = String(Astro.params.id ?? '').trim();
if (!/^(tg:\d+|\d{17,20})$/.test(targetId)) return Astro.rewrite('/404');

const [userRow] = await db().select().from(users).where(eq(users.discordId, targetId));
if (!userRow) return Astro.rewrite('/404');

// User's filed reports
const userReports = await db()
  .select({
    id: reports.id,
    kind: reports.kind,
    category: reports.category,
    platform: reports.platform,
    title: reports.title,
    status: reports.status,
    votes: reports.votes,
    commentCount: reports.commentCount,
    createdAt: reports.createdAt,
  })
  .from(reports)
  .where(eq(reports.reporterId, targetId))
  .orderBy(sql`${reports.createdAt} DESC`);

// Total votes user has cast
const votesGivenRows = await db().all(sql`
  SELECT COUNT(*) AS c FROM votes WHERE discord_id = ${targetId}
`) as { c: number }[];
const votesGivenCount = votesGivenRows[0]?.c ?? 0;

// Calculate stats
const reportsCount = userReports.length;
const fixedCount = userReports.filter((r) => r.status === 'fixed').length;
const totalVotesReceived = userReports.reduce((sum, r) => sum + r.votes, 0);
const hasExtensionFix = userReports.some((r) => r.kind === 'extension' && r.status === 'fixed');
const hasTopSuggestion = userReports.some((r) => r.kind === 'suggestion' && r.votes >= 20);
const staffLevel = await levelOf(targetId);
const isStaff = staffLevel !== 'none';

const stats: UserStats = {
  reportsCount,
  fixedCount,
  totalVotesReceived,
  votesGivenCount,
  hasExtensionFix,
  hasTopSuggestion,
  isStaff,
};

const badges = computeBadges(stats);
const isDiscordLinked = userRow.discordLinked !== false && !userRow.discordId.startsWith('tg:');
const isTelegramLinked = !!userRow.telegramId;
const avatar =
  userRow.telegramPhotoUrl ||
  avatarUrl({ id: userRow.discordId, avatarHash: userRow.avatarHash }, 80);

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=120, stale-while-revalidate=300');
---

<Base title={`${userRow.username} · Contributor Profile`} narrow>
  <header class="profile-head">
    <div class="avatar-wrap">
      {avatar ? (
        <img class="avatar" src={avatar} alt="" width="80" height="80" />
      ) : (
        <div class="avatar avatar-blank" />
      )}
    </div>
    <div class="profile-meta">
      <div class="profile-name-row">
        <h1 class="username">{userRow.username}</h1>
        {isStaff && <span class="staff-tag">{staffLevel}</span>}
      </div>
      <div class="platform-chips">
        {isDiscordLinked && (
          <span class="chip chip-discord">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
            <span>Discord</span>
          </span>
        )}
        {isTelegramLinked && (
          <a
            href={userRow.telegramUsername ? `https://t.me/${userRow.telegramUsername}` : undefined}
            target="_blank"
            rel="noopener noreferrer"
            class="chip chip-telegram"
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
            </svg>
            <span>{userRow.telegramUsername ? `@${userRow.telegramUsername}` : 'Telegram'}</span>
          </a>
        )}
      </div>
      <p class="account-age">Member on AnymeX Desk · Joined {relativeAge(userRow.firstSeen)} ago</p>
    </div>
  </header>

  {/* ── Badges & Achievements ── */}
  <section class="block">
    <h2 class="section-title">Badges &amp; Achievements ({badges.length})</h2>
    {badges.length === 0 ? (
      <p class="empty-line">No badges earned yet. Filing reports and voting helps earn contributor achievements.</p>
    ) : (
      <div class="badges-grid">
        {badges.map((b) => (
          <div class="badge-card" style={`--badge-color: ${b.color};`}>
            <span class="badge-icon">{b.icon}</span>
            <div class="badge-info">
              <span class="badge-name">{b.name}</span>
              <span class="badge-desc">{b.description}</span>
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  {/* ── Activity Metrics ── */}
  <section class="block">
    <h2 class="section-title">Contribution Metrics</h2>
    <div class="stats-row">
      <div class="stat-pill">
        <span class="stat-n">{reportsCount}</span>
        <span class="stat-l">Reports Filed</span>
      </div>
      <div class="stat-pill">
        <span class="stat-n">{fixedCount}</span>
        <span class="stat-l">Bugs Resolved</span>
      </div>
      <div class="stat-pill">
        <span class="stat-n">{totalVotesReceived}</span>
        <span class="stat-l">Votes Received</span>
      </div>
      <div class="stat-pill">
        <span class="stat-n">{votesGivenCount}</span>
        <span class="stat-l">Votes Cast</span>
      </div>
    </div>
  </section>

  {/* ── Reports Filed by User ── */}
  <section class="block">
    <h2 class="section-title">Reports Filed ({userReports.length})</h2>
    {userReports.length === 0 ? (
      <p class="empty-line">No reports filed yet.</p>
    ) : (
      <ol class="report-list">
        {userReports.map((r) => (
          <li class="report-item">
            <div class="report-main">
              <a href={`/report/${r.id}`} class="report-title">
                #{r.id} {r.title}
              </a>
              <div class="report-meta">
                <span class="tag">{kindLabel(r.kind)}</span>
                <span class="tag">{categoryLabel(r.category)}</span>
                <span class="tag">{platformLabel(r.platform)}</span>
                <span class="report-status tag">{statusLabel(r.status)}</span>
                <span class="report-age">{relativeAge(r.createdAt)} ago</span>
              </div>
            </div>
            <div class="report-votes num">▲ {r.votes}</div>
          </li>
        ))}
      </ol>
    )}
  </section>
</Base>

<style>
  .profile-head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block-end: var(--space-5);
    border-block-end: 1px solid var(--border-subtle);
  }
  .avatar-wrap { flex-shrink: 0; }
  .avatar {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-full);
    border: 2px solid var(--border-default);
    display: block;
  }
  .avatar-blank { background: var(--surface-raised); }
  .profile-meta { display: flex; flex-direction: column; gap: 4px; }
  .profile-name-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .username { font-size: var(--text-xl); font-weight: var(--weight-bold); }
  .staff-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    background: rgba(88, 101, 242, 0.2);
    color: #5865F2;
    border: 1px solid rgba(88, 101, 242, 0.4);
  }
  .platform-chips {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-block: 2px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 9999px;
    text-decoration: none;
  }
  .chip-discord {
    background: rgba(88, 101, 242, 0.15);
    color: #8ea1e1;
    border: 1px solid rgba(88, 101, 242, 0.3);
  }
  .chip-telegram {
    background: rgba(36, 161, 222, 0.15);
    color: #55b7ea;
    border: 1px solid rgba(36, 161, 222, 0.3);
    transition: filter 0.15s ease;
  }
  .chip-telegram:hover {
    filter: brightness(1.2);
    text-decoration: underline;
  }
  .account-age { font-size: var(--text-xs); color: var(--text-tertiary); margin-block-start: 2px; }

  .block { margin-block-start: var(--space-6); }
  .section-title {
    font-size: var(--text-md);
    font-weight: var(--weight-semi);
    margin-block-end: var(--space-3);
  }

  /* ── Badges ── */
  .badges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-3);
  }
  .badge-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border-subtle);
    border-inline-start: 3px solid var(--badge-color);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
  }
  .badge-icon { font-size: 1.5rem; line-height: 1; }
  .badge-info { display: flex; flex-direction: column; gap: 2px; }
  .badge-name {
    font-size: var(--text-sm);
    font-weight: var(--weight-semi);
    color: var(--text-primary);
  }
  .badge-desc {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    line-height: var(--leading-snug);
  }

  /* ── Stats Row ── */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }
  .stat-pill {
    padding: var(--space-3);
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .stat-n {
    font-family: var(--font-data);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--signal-ink);
  }
  .stat-l {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* ── Reports list ── */
  .report-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .report-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }
  .report-main { display: flex; flex-direction: column; gap: var(--space-1); min-width: 0; }
  .report-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-primary);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .report-title:hover { color: var(--signal-ink); text-decoration: underline; }
  .report-meta { display: flex; align-items: baseline; gap: var(--space-2); flex-wrap: wrap; }
  .report-status { border-color: var(--border-strong); }
  .report-age { font-size: var(--text-xs); color: var(--text-muted); }
  .report-votes {
    font-size: var(--text-sm);
    font-weight: var(--weight-semi);
    color: var(--signal-ink);
    flex-shrink: 0;
  }
  .empty-line { color: var(--text-muted); font-size: var(--text-sm); }

  @media (max-width: 640px) {
    .stats-row { grid-template-columns: 1fr 1fr; }
  }
</style>
