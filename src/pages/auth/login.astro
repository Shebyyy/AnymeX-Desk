---
import Base from '../../layouts/Base.astro';
import { currentUser } from '../../lib/auth';
import { readSetting } from '../../lib/settings';
import { safeReturnTo } from '../../lib/redirect';

export const prerender = false;

const user = await currentUser(Astro);
const next = safeReturnTo(Astro.url.searchParams.get('next'), Astro.url.origin, '/');

// If already signed in, send them straight to their destination
if (user) {
  return Astro.redirect(next, 302);
}

const telegramBot = await readSetting('telegram_bot_username');
const hasTelegram = !!telegramBot;

const discordHref = `/auth/discord?next=${encodeURIComponent(next)}`;
const telegramHref = `/auth/telegram?next=${encodeURIComponent(next)}`;
---

<Base title="Sign in — AnymeX Desk">
  <div class="login-wrapper">
    <div class="login-card">
      <div class="login-badge">
        <img src="/favicon.gif" alt="AnymeX" class="login-logo" />
      </div>

      <h1>Sign in to AnymeX Desk</h1>
      <p class="login-sub">
        Choose a platform to sign in, file bug reports, suggest new features, upvote issues, and track progress.
      </p>

      <div class="login-options">
        <a href={discordHref} class="btn-auth btn-discord-auth">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
          </svg>
          <span>Continue with Discord</span>
        </a>

        {hasTelegram && (
          <a href={telegramHref} class="btn-auth btn-telegram-auth">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
            </svg>
            <span>Continue with Telegram</span>
          </a>
        )}
      </div>

      <div class="login-footer">
        <a href={next} class="back-link">← Cancel &amp; return</a>
      </div>
    </div>
  </div>
</Base>

<style>
  .login-wrapper {
    min-height: calc(100vh - 220px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }
  .login-card {
    background: var(--bg-surface, #18191c);
    border: 1px solid var(--border-default, #2e3035);
    border-radius: var(--radius-lg, 12px);
    padding: var(--space-8);
    max-width: 440px;
    width: 100%;
    text-align: center;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
  }
  .login-badge {
    margin-inline: auto;
    margin-block-end: var(--space-4);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--bg-surface-elevated, #24262b);
    border: 1px solid var(--border-subtle, #383a40);
  }
  .login-logo {
    width: 32px;
    height: 32px;
  }
  h1 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-block-end: var(--space-2);
    color: var(--text-primary, #fff);
  }
  .login-sub {
    font-size: 0.92rem;
    color: var(--text-secondary, #b9bbbe);
    margin-block-end: var(--space-6);
    line-height: 1.5;
  }
  .login-options {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-block-end: var(--space-6);
  }
  .btn-auth {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: 12px 20px;
    border-radius: var(--radius-md, 8px);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: filter 0.15s ease, transform 0.1s ease;
  }
  .btn-auth:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }
  .btn-auth:active {
    transform: translateY(0);
  }
  .btn-discord-auth {
    background: #5865F2;
    color: #ffffff;
  }
  .btn-telegram-auth {
    background: #24A1DE;
    color: #ffffff;
  }
  .login-footer {
    border-block-start: 1px solid var(--border-default, #2e3035);
    padding-block-start: var(--space-4);
  }
  .back-link {
    color: var(--text-secondary, #b9bbbe);
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 0.15s;
  }
  .back-link:hover {
    color: var(--text-primary, #fff);
  }
</style>
