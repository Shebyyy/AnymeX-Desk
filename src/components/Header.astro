---
import UserChip from './UserChip.astro';

const path = Astro.url.pathname;
const _params = new URLSearchParams(Astro.url.searchParams);
_params.delete('auth');
_params.delete('__fresh');
_params.delete('_cb');
const here = Astro.url.pathname + (_params.toString() ? `?${_params.toString()}` : '');
const signInHref = `/auth/login?next=${encodeURIComponent(here)}`;

const primaryTabs = [
  {
    href: '/',
    label: 'Bugs',
    match: (p: string) =>
      p === '/' &&
      new URL(Astro.url).searchParams.get('kind') !== 'suggestion' &&
      new URL(Astro.url).searchParams.get('kind') !== 'extension',
  },
  {
    href: '/?kind=suggestion',
    label: 'Suggestions',
    match: (p: string) =>
      p === '/' && new URL(Astro.url).searchParams.get('kind') === 'suggestion',
  },
  {
    href: '/?kind=extension',
    label: 'Extensions',
    match: (p: string) =>
      p === '/' && new URL(Astro.url).searchParams.get('kind') === 'extension',
  },
];

const secondaryTabs = [
  { href: '/roadmap', label: 'Roadmap', desc: 'Planned & upcoming features' },
  { href: '/changelog', label: 'Changelog', desc: 'Recent app releases & updates' },
  { href: '/stats', label: 'Stats', desc: 'Community activity & metrics' },
];

const isSecondaryActive = secondaryTabs.some((t) => t.href === path);
const maybeSignedIn = Astro.cookies.get('signed_in')?.value === '1';
---

<header class="bar" id="main-header">
  <div class="shell header-top-row">
    <!-- Brand Logo -->
    <a href="/" class="mark">
      <img src="/favicon.gif" alt="AnymeX" class="mark-logo" />
      <span class="mark-text">AnymeX <span>Desk</span></span>
    </a>

    <!-- Desktop Navigation Tabs -->
    <nav class="desktop-tabs" aria-label="Sections">
      {
        primaryTabs.map((t) => (
          <a href={t.href} class="tab" aria-current={t.match(path) ? 'page' : undefined}>
            {t.label}
          </a>
        ))
      }

      <!-- "More" Dropdown for secondary pages -->
      <div class="dropdown-wrap" data-dropdown>
        <button
          type="button"
          class:list={['tab', 'more-trigger', { active: isSecondaryActive }]}
          aria-haspopup="true"
          aria-expanded="false"
          data-dropdown-trigger
        >
          <span>More</span>
          <svg class="chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>

        <div class="dropdown-card" role="menu">
          {
            secondaryTabs.map((t) => (
              <a href={t.href} class="dropdown-item" role="menuitem" aria-current={t.href === path ? 'page' : undefined}>
                <div class="dropdown-item-title">{t.label}</div>
                <div class="dropdown-item-desc">{t.desc}</div>
              </a>
            ))
          }
        </div>
      </div>
    </nav>

    <!-- Desktop Search Box -->
    <form class="desktop-search" method="get" action="/search" role="search">
      <label class="sr-only" for="header-search">Search reports</label>
      <svg class="search-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" />
      </svg>
      <input
        id="header-search"
        class="search-input"
        type="search"
        name="q"
        placeholder="Search…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search reports"
      />
      <kbd class="search-kbd" title="Search shortcut">⌘K</kbd>
    </form>

    <!-- Action Controls -->
    <div class="header-actions">
      <!-- Mobile Search Icon Trigger -->
      <a href="/search" class="btn btn-ghost btn-icon mobile-search-btn" aria-label="Search" title="Search">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" />
        </svg>
      </a>

      <!-- Display Preferences / Theme -->
      <button
        class="btn btn-ghost btn-icon prefs-btn"
        type="button"
        data-open-prefs
        aria-label="Display & theme preferences"
        title="Display & theme preferences"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3" />
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
        </svg>
      </button>

      <!-- User Chip or Sign In -->
      {
        maybeSignedIn ? (
          <UserChip server:defer>
            <div class="user-chip-fallback" slot="fallback">
              <span class="fallback-dot" />
            </div>
          </UserChip>
        ) : (
          <a class="btn btn-primary signin-pill-btn" href={signInHref}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
              <polyline points="10 17 15 12 10 7" />
              <line x1="15" y1="12" x2="3" y2="12" />
            </svg>
            <span>Sign in</span>
          </a>
        )
      }

      <!-- Mobile Hamburger / Explore Dropdown -->
      <div class="dropdown-wrap mobile-menu-wrap" data-dropdown>
        <button
          type="button"
          class:list={['btn', 'btn-ghost', 'btn-icon', 'mobile-menu-btn', { active: isSecondaryActive }]}
          aria-haspopup="true"
          aria-expanded="false"
          data-dropdown-trigger
          aria-label="Toggle navigation menu"
          title="Explore menu"
        >
          <svg class="i-menu" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
          <svg class="i-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>

        <div class="dropdown-card mobile-menu-card" role="menu">
          <div class="mobile-menu-header">Explore</div>
          {
            secondaryTabs.map((t) => (
              <a href={t.href} class="dropdown-item" role="menuitem" aria-current={t.href === path ? 'page' : undefined}>
                <div class="dropdown-item-title">{t.label}</div>
                <div class="dropdown-item-desc">{t.desc}</div>
              </a>
            ))
          }
          <div class="mobile-menu-divider" />
          <a href="https://github.com/RyanYuuki/AnymeX" target="_blank" rel="noopener noreferrer" class="dropdown-item" role="menuitem">
            <div class="dropdown-item-title flex-between">
              <span>AnymeX GitHub</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" y1="14" x2="21" y2="3" />
              </svg>
            </div>
            <div class="dropdown-item-desc">Source code &amp; releases</div>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Board Switcher (Row 2 on small screens) -->
  <div class="mobile-subnav">
    <div class="shell mobile-subnav-inner">
      <div class="mobile-pills">
        {
          primaryTabs.map((t) => (
            <a href={t.href} class="mobile-pill" aria-current={t.match(path) ? 'page' : undefined}>
              {t.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    // Dropdown toggle logic for More, Mobile Menu, and UserChip
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!target) return;

      const trigger = target.closest('[data-dropdown-trigger]');
      const openDropdowns = document.querySelectorAll('[data-dropdown].is-open');

      if (trigger) {
        const wrap = trigger.closest('[data-dropdown]');
        const willOpen = !wrap?.classList.contains('is-open');

        // Close any other open dropdowns first
        openDropdowns.forEach((d) => {
          if (d !== wrap) d.classList.remove('is-open');
        });

        if (wrap) {
          wrap.classList.toggle('is-open', willOpen);
          trigger.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
        }
        return;
      }

      // Clicked outside: close all open dropdowns
      if (!target.closest('[data-dropdown]')) {
        openDropdowns.forEach((d) => {
          d.classList.remove('is-open');
          const t = d.querySelector('[data-dropdown-trigger]');
          if (t) t.setAttribute('aria-expanded', 'false');
        });
      }
    });

    // Keyboard shortcuts (Cmd+K / Ctrl+K & Escape)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('[data-dropdown].is-open').forEach((d) => {
          d.classList.remove('is-open');
        });
      }

      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        const searchInput = document.getElementById('header-search');
        if (searchInput) {
          e.preventDefault();
          searchInput.focus();
          searchInput.select();
        }
      }
    });
  })();
</script>

<style>
  .bar {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-sticky, 100);
    background: color-mix(in oklab, var(--surface-canvas, #141518) 85%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    border-block-end: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
  }

  .header-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3, 12px);
    height: 52px;
  }

  /* Brand Mark */
  .mark {
    display: flex;
    align-items: center;
    gap: var(--space-2, 8px);
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
    text-decoration: none;
    color: var(--text-primary, #fff);
    flex-shrink: 0;
  }
  .mark-logo {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: contain;
  }
  .mark-text span {
    color: var(--text-tertiary, #888);
    font-weight: 400;
  }

  /* Desktop Tabs */
  .desktop-tabs {
    display: none;
    align-items: center;
    gap: 4px;
    margin-inline-start: var(--space-3, 12px);
  }

  @media (min-width: 820px) {
    .desktop-tabs {
      display: flex;
    }
  }

  .tab {
    padding: 6px 12px;
    white-space: nowrap;
    border-radius: var(--radius-md, 8px);
    font-size: var(--text-sm, 13.5px);
    font-weight: 500;
    color: var(--text-secondary, #b5b7ba);
    text-decoration: none;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .tab:hover {
    color: var(--text-primary, #fff);
    background: var(--surface-hover, rgba(255, 255, 255, 0.08));
  }
  .tab[aria-current='page'] {
    color: var(--text-primary, #fff);
    background: var(--surface-active, rgba(255, 255, 255, 0.12));
    font-weight: 600;
  }

  /* Dropdown Wrap & More Trigger */
  .dropdown-wrap {
    position: relative;
  }
  .more-trigger {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .more-trigger .chevron {
    color: var(--text-tertiary, #888);
    transition: transform 0.2s ease;
  }
  .dropdown-wrap.is-open .more-trigger .chevron {
    transform: rotate(180deg);
  }
  .more-trigger.active {
    color: var(--text-primary, #fff);
    background: var(--surface-active, rgba(255, 255, 255, 0.12));
  }

  .dropdown-card {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    width: 220px;
    background: var(--surface-overlay, #1c1d21);
    border: 1px solid var(--border-default, rgba(255, 255, 255, 0.14));
    border-radius: var(--radius-lg, 12px);
    padding: 6px;
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.5);
    display: none;
    flex-direction: column;
    z-index: 1000;
    backdrop-filter: blur(20px);
    animation: dropFade 0.15s ease;
  }
  @keyframes dropFade {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .dropdown-wrap.is-open .dropdown-card {
    display: flex;
  }
  .dropdown-item {
    display: flex;
    flex-direction: column;
    padding: 8px 10px;
    border-radius: var(--radius-md, 6px);
    text-decoration: none;
    transition: background 0.12s ease;
  }
  .dropdown-item:hover {
    background: var(--surface-hover, rgba(255, 255, 255, 0.08));
  }
  .dropdown-item[aria-current='page'] {
    background: var(--surface-active, rgba(255, 255, 255, 0.12));
  }
  .dropdown-item-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary, #fff);
  }
  .dropdown-item-desc {
    font-size: 11px;
    color: var(--text-tertiary, #888);
    margin-top: 1px;
  }

  /* Desktop Search Box */
  .desktop-search {
    display: none;
    position: relative;
    align-items: center;
    margin-inline-start: auto;
    margin-inline-end: var(--space-2, 8px);
  }
  @media (min-width: 960px) {
    .desktop-search {
      display: flex;
    }
  }
  .search-icon {
    position: absolute;
    left: 10px;
    color: var(--text-tertiary, #888);
    pointer-events: none;
  }
  .search-input {
    height: 32px;
    width: 140px;
    padding: 0 38px 0 30px;
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.1));
    border-radius: var(--radius-full, 9999px);
    background: var(--surface-inset, rgba(0, 0, 0, 0.25));
    color: var(--text-primary, #fff);
    font-size: var(--text-sm, 13px);
    transition: width 0.2s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .search-input::placeholder {
    color: var(--text-muted, #777);
  }
  .search-input:focus {
    width: 200px;
    border-color: var(--border-strong, #5865F2);
    background: var(--surface-raised, #1f2024);
    outline: none;
  }
  .search-kbd {
    position: absolute;
    right: 8px;
    font-family: inherit;
    font-size: 10.5px;
    font-weight: 600;
    color: var(--text-muted, #777);
    padding: 2px 5px;
    border-radius: 4px;
    background: var(--surface-active, rgba(255, 255, 255, 0.08));
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
    pointer-events: none;
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2, 8px);
    margin-inline-start: auto;
  }
  @media (min-width: 960px) {
    .header-actions {
      margin-inline-start: 0;
    }
  }

  .mobile-search-btn {
    display: inline-flex;
  }
  @media (min-width: 960px) {
    .mobile-search-btn {
      display: none;
    }
  }

  .signin-pill-btn {
    padding: 5px 12px;
    font-size: 13px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-radius: var(--radius-full, 9999px);
  }

  .user-chip-fallback {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--surface-raised, rgba(255, 255, 255, 0.06));
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .fallback-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border-strong, #666);
  }

  /* Mobile Menu Dropdown (Floating Card) */
  .mobile-menu-wrap {
    position: relative;
    display: inline-flex;
  }
  @media (min-width: 820px) {
    .mobile-menu-wrap {
      display: none;
    }
  }

  .mobile-menu-btn {
    display: inline-flex;
  }
  .mobile-menu-btn.active {
    background: var(--surface-active, rgba(255, 255, 255, 0.1));
    color: var(--text-primary, #fff);
  }
  .mobile-menu-wrap .i-close {
    display: none;
  }
  .mobile-menu-wrap.is-open .i-menu {
    display: none;
  }
  .mobile-menu-wrap.is-open .i-close {
    display: inline-block;
  }

  .mobile-menu-wrap .dropdown-card {
    right: 0;
    left: auto;
    width: 220px;
    max-width: calc(100vw - 24px);
  }

  .mobile-menu-header {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-tertiary, #777);
    padding: 6px 10px 4px;
  }

  .mobile-menu-divider {
    height: 1px;
    background: var(--border-subtle, rgba(255, 255, 255, 0.08));
    margin: 4px 6px;
  }

  .flex-between {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Mobile Subnav (Row 2 on small screens) */
  .mobile-subnav {
    display: block;
    border-block-start: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.05));
    background: color-mix(in oklab, var(--surface-canvas, #141518) 95%, transparent);
  }
  @media (min-width: 820px) {
    .mobile-subnav {
      display: none;
    }
  }
  .mobile-subnav-inner {
    padding-block: 6px;
  }
  .mobile-pills {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    background: var(--surface-inset, rgba(0, 0, 0, 0.25));
    padding: 3px;
    border-radius: var(--radius-lg, 10px);
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.06));
  }
  .mobile-pill {
    text-align: center;
    padding: 6px 4px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-secondary, #aaa);
    text-decoration: none;
    border-radius: var(--radius-md, 7px);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.12s, background 0.12s;
  }
  .mobile-pill:hover {
    color: var(--text-primary, #fff);
  }
  .mobile-pill[aria-current='page'] {
    background: var(--surface-active, rgba(255, 255, 255, 0.14));
    color: var(--text-primary, #fff);
    font-weight: 600;
  }
</style>
