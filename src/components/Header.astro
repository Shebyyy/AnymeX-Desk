---
import UserChip from './UserChip.astro';

const path = Astro.url.pathname;
const _params = new URLSearchParams(Astro.url.searchParams);
_params.delete('auth');
_params.delete('__fresh');
_params.delete('_cb');
const here = Astro.url.pathname + (_params.toString() ? `?${_params.toString()}` : '');
const signInHref = `/auth/login?next=${encodeURIComponent(here)}`;
const tabs = [
  { href: '/', label: 'Bugs', match: (p: string) => p === '/' && new URL(Astro.url).searchParams.get('kind') !== 'suggestion' && new URL(Astro.url).searchParams.get('kind') !== 'extension' },
  { href: '/?kind=suggestion', label: 'Suggestions', match: (p: string) => p === '/' && new URL(Astro.url).searchParams.get('kind') === 'suggestion' },
  { href: '/?kind=extension', label: 'Extension Issues', match: (p: string) => p === '/' && new URL(Astro.url).searchParams.get('kind') === 'extension' },
  { href: '/roadmap', label: 'Roadmap', match: (p: string) => p === '/roadmap' },
  { href: '/changelog', label: 'Changelog', match: (p: string) => p === '/changelog' },
  { href: '/stats', label: 'Stats', match: (p: string) => p === '/stats' },
];

const maybeSignedIn = Astro.cookies.get('signed_in')?.value === '1';

const DISCORD_MARK =
  'M19.3 5.3A16.6 16.6 0 0 0 15.2 4l-.3.6a12.4 12.4 0 0 1 3.7 1.2 12.9 12.9 0 0 0-11-.5l.3-.7A16.5 16.5 0 0 0 4.7 5.3C2.2 9 1.5 12.6 1.9 16.2a16.4 16.4 0 0 0 5 2.5l.6-1a10.7 10.7 0 0 1-1.8-.9l.4-.3a11.7 11.7 0 0 0 10 0l.4.3a10.8 10.8 0 0 1-1.8.9l.6 1a16.3 16.3 0 0 0 5-2.5c.5-4.2-.6-7.8-2.9-10.9ZM8.7 14c-1 0-1.7-.9-1.7-2s.8-2 1.7-2 1.8.9 1.7 2c0 1.1-.8 2-1.7 2Zm6.6 0c-1 0-1.7-.9-1.7-2s.8-2 1.7-2 1.8.9 1.7 2c0 1.1-.8 2-1.7 2Z';
---

<header class="bar">
  <div class="shell inner">
    <a href="/" class="mark">
      <img src="/favicon.gif" alt="AnymeX" class="mark-logo" />
      <span class="mark-text">AnymeX <span>Desk</span></span>
    </a>

    <nav class="tabs" aria-label="Sections">
      {
        tabs.map((t) => (
          <a href={t.href} class="tab" aria-current={t.match(path) ? 'page' : undefined}>
            {t.label}
          </a>
        ))
      }
    </nav>

    <form class="search-box" method="get" action="/search" role="search">
      <label class="sr-only" for="header-search">Search reports</label>
      <svg class="search-box-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <input
        id="header-search"
        class="search-box-input"
        type="search"
        name="q"
        placeholder="Search…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search reports"
      />
    </form>

    <div class="controls">
      <button
        class="btn btn-ghost btn-icon prefs-btn"
        type="button"
        data-open-prefs
        aria-label="Display & theme preferences"
        title="Display & theme preferences"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3" />
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
        </svg>
      </button>

      {
        maybeSignedIn ? (
          <UserChip server:defer>
            <a class="me-hint" slot="fallback" href="/me" aria-label="Your reports">
              <span class="avatar-blank" aria-hidden="true"></span>
              <span class="me-hint-text">Your reports</span>
            </a>
          </UserChip>
        ) : (
          <a class="btn btn-primary signin-link" href={signInHref}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
              <polyline points="10 17 15 12 10 7" />
              <line x1="15" y1="12" x2="3" y2="12" />
            </svg>
            <span class="guest-text">Sign in</span>
            <span class="authed-text">Your reports</span>
          </a>
        )
      }
    </div>
  </div>
</header>

<style>
  .signin-link .authed-text { display: none; }
  :global(:root[data-signed-in]) .signin-link svg,
  :global(:root[data-signed-in]) .signin-link .guest-text { display: none; }
  :global(:root[data-signed-in]) .signin-link .authed-text { display: inline; }
  @layer utilities {
    :global(:root[data-signed-in]) .signin-link {
      background: var(--surface-raised);
      border-color: var(--border-default);
      color: var(--text-secondary);
    }
    :global(:root[data-signed-in]) .signin-link:hover {
      filter: none;
      background: var(--surface-hover);
      border-color: var(--border-strong);
      color: var(--text-primary);
    }
  }

  .me-hint {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-inline: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  .avatar-blank {
    inline-size: 22px;
    block-size: 22px;
    border-radius: var(--radius-full);
    background: var(--surface-active);
  }
  @media (max-width: 700px) {
    .me-hint-text { display: none; }
    .me-hint { padding-inline: var(--space-1); }
  }

  .bar {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-sticky);
    background: color-mix(in oklab, var(--surface-canvas) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    border-block-end: 1px solid var(--border-subtle);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    min-block-size: 52px;
    padding-block: var(--space-2);
  }
  .controls {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-inline-start: auto;
  }
  .mark { order: 0; }
  .controls { order: 1; }
  .tabs { order: 2; flex-basis: 100%; }
  @media (min-width: 620px) {
    .inner { flex-wrap: nowrap; padding-block: 0; block-size: 52px; }
    .tabs { order: 1; flex-basis: auto; }
    .controls { order: 2; }
  }

  :global(:root[data-theme='dark']) .i-moon,
  :global(:root[data-theme='light']) .i-sun {
    display: none;
  }
  :global(:root:not([data-theme])) .theme-btn {
    display: none;
  }

  .mark {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--weight-semi);
    letter-spacing: var(--track-tight);
    white-space: nowrap;
  }
  .mark-logo {
    inline-size: 24px;
    block-size: 24px;
    border-radius: var(--radius-full);
    object-fit: contain;
  }
  .mark-text span {
    color: var(--text-tertiary);
    font-weight: var(--weight-normal);
  }

  .tabs {
    display: flex;
    gap: var(--space-1);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar { display: none; }
  @media (min-width: 620px) {
    .tabs { margin-inline-start: var(--space-4); }
  }
  .tab {
    padding: var(--space-2) var(--space-3);
    white-space: nowrap;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-tertiary);
    transition: color var(--dur-fast) var(--ease-standard),
      background var(--dur-fast) var(--ease-standard);
  }
  .tab:hover {
    color: var(--text-secondary);
    background: var(--surface-hover);
  }
  .tab[aria-current='page'] {
    color: var(--text-primary);
    background: var(--surface-active);
  }

  @media (max-width: 560px) {
    .mark-text span { display: none; }
  }

  /* Compact header search */
  .search-box {
    display: none;
    position: relative;
    flex: none;
  }
  @media (min-width: 800px) {
    .search-box { display: flex; align-items: center; }
  }
  .search-box-icon {
    position: absolute;
    inset-inline-start: 8px;
    color: var(--text-muted);
    pointer-events: none;
  }
  .search-box-input {
    block-size: 28px;
    padding-inline: 28px 10px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: var(--surface-inset);
    color: var(--text-primary);
    font-size: var(--text-sm);
    width: 9rem;
    transition:
      width var(--dur-base) var(--ease-standard),
      border-color var(--dur-fast) var(--ease-standard),
      background var(--dur-fast) var(--ease-standard);
  }
  .search-box-input::placeholder { color: var(--text-muted); }
  .search-box-input:focus {
    outline: 2px solid var(--signal);
    outline-offset: -1px;
    border-color: var(--signal);
    background: var(--surface-raised);
    width: 16rem;
  }
</style>
