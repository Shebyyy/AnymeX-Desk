---
/**
 * InstallBanner.astro
 * Sleek bottom-floating PWA installation banner.
 */
---

<aside id="pwa-install-banner" class="pwa-banner" aria-label="Install AnymeX Desk" style="display: none;">
  <div class="pwa-banner-card">
    <div class="pwa-banner-main">
      <img src="/icons/icon-192.png" width="40" height="40" alt="AnymeX Desk" class="pwa-banner-icon" />
      <div class="pwa-banner-text">
        <strong class="pwa-banner-title">Install AnymeX Desk</strong>
        <span class="pwa-banner-desc">Add to Home Screen for fast, standalone access</span>
      </div>
    </div>

    <div class="pwa-banner-actions">
      <button type="button" class="btn btn-ghost btn-sm pwa-banner-dismiss" id="pwa-banner-dismiss-btn">
        Not now
      </button>
      <button type="button" class="btn btn-primary btn-sm pwa-banner-install" id="pwa-banner-install-btn">
        Install
      </button>
    </div>

    <button type="button" class="pwa-banner-close" id="pwa-banner-close-btn" aria-label="Dismiss install prompt">
      ×
    </button>
  </div>
</aside>

<style>
  .pwa-banner {
    position: fixed;
    inset-inline: var(--space-4);
    inset-block-end: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
    z-index: var(--z-toast, 500);
    pointer-events: none;
    display: flex;
    justify-content: center;
  }

  @media (min-width: 640px) {
    .pwa-banner {
      inset-inline-start: auto;
      inset-inline-end: var(--space-6);
      inset-block-end: var(--space-6);
      justify-content: flex-end;
    }
  }

  .pwa-banner-card {
    pointer-events: auto;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    padding-inline-end: var(--space-8);
    background: var(--surface-modal, #1a1b1e);
    border: 1px solid var(--border-default, rgba(255, 255, 255, 0.12));
    border-radius: var(--radius-lg, 10px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5), 0 2px 6px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(16px);
    max-inline-size: min(100%, 460px);
    animation: pwaSlideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes pwaSlideUp {
    from {
      transform: translateY(120%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .pwa-banner-main {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-inline-size: 0;
  }

  .pwa-banner-icon {
    border-radius: var(--radius-md, 6px);
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }

  .pwa-banner-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-inline-size: 0;
  }

  .pwa-banner-title {
    font-size: var(--text-sm, 13px);
    font-weight: var(--weight-semi, 600);
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pwa-banner-desc {
    font-size: var(--text-xs, 12px);
    color: var(--text-tertiary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pwa-banner-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .pwa-banner-close {
    position: absolute;
    inset-block-start: 4px;
    inset-inline-end: 8px;
    font-size: 18px;
    line-height: 1;
    color: var(--text-muted);
    padding: 4px;
    cursor: pointer;
    background: transparent;
    border: none;
    transition: color 0.15s ease;
  }

  .pwa-banner-close:hover {
    color: var(--text-primary);
  }

  @media (max-width: 480px) {
    .pwa-banner-card {
      flex-direction: column;
      align-items: stretch;
      padding-inline-end: var(--space-4);
      gap: var(--space-3);
    }
    .pwa-banner-actions {
      justify-content: flex-end;
    }
  }
</style>
