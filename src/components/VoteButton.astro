---
interface Props {
  reportId: number;
  votes: number;
  mine?: boolean;
  /**
   * The report is no longer open, so there is nothing to vote on.
   */
  closed?: boolean;
  /**
   * The report has been locked by staff or status. Voting is frozen.
   */
  locked?: boolean;
}
const { reportId, votes, mine = false, closed = false, locked = false } = Astro.props;

const people = votes === 1 ? 'person' : 'people';
const isFrozen = closed || locked;

// A plain form post, so it works with JavaScript off. The endpoint redirects to
// Discord sign-in when there's no session, which means the obvious action never
// dead-ends — it just asks you to sign in and comes back.

/**
 * The word is the control.
 *
 *   not yours -> "Me too"   the invitation, and what the tap means
 *   yours     -> "Counted"  the state, and still tappable to take it back
 */
const word = mine ? 'Counted' : 'Me too';
const said = mine
  ? `Counted. ${votes} ${votes === 1 ? 'person is' : 'people are'} affected. Press to take your report back.`
  : `Me too. This is broken for me. ${votes} ${votes === 1 ? 'person is' : 'people are'} affected.`;
---

{
  isFrozen ? (
    <p class="vote vote-btn vote-tally" title={locked ? `Voting locked — ${votes} ${people} backed this.` : `${votes} ${people} backed this.`}>
      <span class="vote-n">{votes}</span>
      {locked ? (
        <span class="vote-word vote-word-locked">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block;vertical-align:-1px;margin-right:2px;">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          Locked
        </span>
      ) : (
        <span class="vote-word">{people}</span>
      )}
    </p>
  ) : (
    <form method="POST" action="/vote" class="vote">
      <input type="hidden" name="report" value={reportId} />
      <button class="vote-btn" type="submit" aria-pressed={mine} aria-label={said} title={said}>
        <span class="vote-n">{votes}</span>
        <span class="vote-word">{word}</span>
      </button>
    </form>
  )
}

<style>
  .vote { flex: none; }
  /* Two short lines rather than one wide one: the row is 34px of content and
     the board is read on a 390px screen, where a horizontal "6 affected" would
     eat a third of the row from the title. Stacked, the control is the same
     height as the triangle-over-number it replaces. */
  .vote-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    min-inline-size: 58px;
    padding-block: var(--space-1);
    padding-inline: var(--space-2);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--surface-inset);
    color: var(--text-tertiary);
    transition: border-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard),
      background var(--dur-fast) var(--ease-standard);
  }
  .vote-btn:hover {
    border-color: var(--signal-dim);
    color: var(--signal-ink);
    background: var(--signal-fill);
  }
  .vote-n {
    font-family: var(--font-data);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-md);
    font-weight: var(--weight-semi);
    line-height: var(--leading-none);
    letter-spacing: var(--track-tight);
    color: var(--text-primary);
  }
  .vote-word {
    font-size: var(--text-xs);
    line-height: var(--leading-none);
    /* "Me too" must never break across two lines: half a word under a number
       reads as breakage, and it would grow the row. */
    white-space: nowrap;
  }
  /* A tally, not a control: same box so the rows still line up, but nothing
     about it invites a press. */
  .vote-tally { cursor: default; }
  .vote-tally:hover {
    border-color: var(--border-default);
    color: var(--text-tertiary);
    background: var(--surface-inset);
  }

  /* Already counted: filled, unmistakable, still clickable to undo. */
  .vote-btn[aria-pressed='true'] {
    background: var(--signal-fill-hi);
    border-color: var(--signal-dim);
    color: var(--signal-ink);
  }
  .vote-btn[aria-pressed='true'] .vote-n { color: var(--signal-ink); }
</style>
