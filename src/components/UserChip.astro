---
import { atLeast } from '../lib/levels';
import { avatarUrl, currentUser } from '../lib/auth';
import { effectiveStaffLevel } from '../lib/staff';
import { safeReturnTo } from '../lib/redirect';

const user = await currentUser(Astro);
const staffInfo = user ? await effectiveStaffLevel(Astro, user.id) : null;
const effectiveLevel = staffInfo ? staffInfo.effectiveLevel : (user ? user.level : 'user');
const avatar = user ? avatarUrl(user, 48) : null;
const staff = user ? atLeast(effectiveLevel, 'mod') : false;

const here = (() => {
  const ref = Astro.request.headers.get('referer');
  if (ref) {
    const cleaned = safeReturnTo(ref, Astro.url.origin, '');
    if (cleaned) {
      const u = new URL(cleaned, Astro.url.origin);
      u.searchParams.delete('auth');
      u.searchParams.delete('_cb');
      return u.pathname + (u.search ? u.search : '');
    }
  }
  const fallback = Astro.url.pathname + Astro.url.search;
  if (fallback.startsWith('/_server-islands')) return '/';
  const p = new URLSearchParams(Astro.url.searchParams);
  p.delete('auth');
  p.delete('_cb');
  return Astro.url.pathname + (p.toString() ? `?${p.toString()}` : '');
})();

const signInHref = `/auth/login?next=${encodeURIComponent(here)}`;
---

{
  user ? (
    <div class="user-menu-wrapper" data-dropdown>
      <button
        type="button"
        class="user-pill-btn"
        aria-haspopup="true"
        aria-expanded="false"
        data-dropdown-trigger
        title={`Account menu (${user.username})`}
      >
        <div class="user-pill-avatar">
          {avatar ? (
            <img class="avatar-img" src={avatar} alt="" width="26" height="26" />
          ) : (
            <span class="avatar-blank" aria-hidden="true" />
          )}
        </div>
        <span class="user-pill-name">{user.username}</span>
        <svg class="user-pill-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </button>

      <div class="user-dropdown-menu" role="menu">
        <div class="user-menu-header">
          <div class="user-menu-identity">
            <span class="user-menu-name">{user.username}</span>
            {staff && <span class="staff-badge">{user.level}</span>}
          </div>
          <span class="user-menu-sub">
            {user.telegramUsername ? `@${user.telegramUsername}` : (user.discordLinked ? 'Discord account' : 'Telegram account')}
          </span>
        </div>

        <div class="user-menu-divider" />

        <a href="/me" class="user-menu-item" role="menuitem">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" y1="13" x2="8" y2="13" />
            <line x1="16" y1="17" x2="8" y2="17" />
          </svg>
          <span>Your Reports &amp; Activity</span>
        </a>

        <a href={`/user/${user.id}`} class="user-menu-item" role="menuitem">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
          <span>Public Profile</span>
        </a>

        {staff && (
          <>
            <a href="/triage" class="user-menu-item staff-item" role="menuitem">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 11 12 14 22 4" />
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
              </svg>
              <span>Triage Queue</span>
            </a>

            <a href="/admin" class="user-menu-item staff-item" role="menuitem">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                <line x1="3" y1="9" x2="21" y2="9" />
                <line x1="9" y1="21" x2="9" y2="9" />
              </svg>
              <span>Staff Dashboard</span>
            </a>
          </>
        )}

        <button type="button" class="user-menu-item" data-open-prefs role="menuitem">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
          </svg>
          <span>Appearance &amp; Theme</span>
        </button>

        <div class="user-menu-divider" />

        <form method="POST" action="/auth/logout" class="logout-form">
          <button class="user-menu-item signout-btn" type="submit" role="menuitem">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
              <polyline points="16 17 21 12 16 7" />
              <line x1="21" y1="12" x2="9" y2="12" />
            </svg>
            <span>Sign out</span>
          </button>
        </form>
      </div>
    </div>
  ) : (
    <a class="btn btn-primary signin-pill" href={signInHref}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
        <polyline points="10 17 15 12 10 7" />
        <line x1="15" y1="12" x2="3" y2="12" />
      </svg>
      <span>Sign in</span>
    </a>
  )
}

<style>
  .user-menu-wrapper {
    position: relative;
  }

  .user-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2, 8px);
    padding: 3px 10px 3px 4px;
    border-radius: var(--radius-full, 9999px);
    background: var(--surface-raised, rgba(255, 255, 255, 0.05));
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.1));
    color: var(--text-primary, #fff);
    font-size: var(--text-sm, 13px);
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .user-pill-btn:hover {
    background: var(--surface-hover, rgba(255, 255, 255, 0.09));
    border-color: var(--border-default, rgba(255, 255, 255, 0.2));
  }

  .user-pill-avatar {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--surface-active, rgba(255, 255, 255, 0.12));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .avatar-blank {
    width: 100%;
    height: 100%;
    display: block;
    background: var(--surface-active);
  }

  .user-pill-name {
    max-width: 130px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .user-pill-chevron {
    color: var(--text-tertiary, #888);
    transition: transform 0.2s ease;
  }

  .user-menu-wrapper.is-open .user-pill-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown Menu */
  .user-dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 220px;
    background: var(--surface-overlay, #1c1d21);
    border: 1px solid var(--border-default, rgba(255, 255, 255, 0.14));
    border-radius: var(--radius-lg, 12px);
    padding: 6px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.05);
    display: none;
    flex-direction: column;
    z-index: 1000;
    backdrop-filter: blur(20px);
    animation: dropdownFadeIn 0.15s ease;
  }

  @keyframes dropdownFadeIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .user-menu-wrapper.is-open .user-dropdown-menu {
    display: flex;
  }

  .user-menu-header {
    padding: 8px 10px;
  }

  .user-menu-identity {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .user-menu-name {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--text-primary, #fff);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .staff-badge {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 1px 5px;
    border-radius: 4px;
    background: rgba(88, 101, 242, 0.25);
    color: #8ea1e1;
    border: 1px solid rgba(88, 101, 242, 0.4);
  }

  .user-menu-sub {
    font-size: 11px;
    color: var(--text-tertiary, #888);
    display: block;
    margin-top: 2px;
  }

  .user-menu-divider {
    height: 1px;
    background: var(--border-subtle, rgba(255, 255, 255, 0.08));
    margin: 4px 0;
  }

  .user-menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: var(--radius-md, 6px);
    color: var(--text-secondary, #ccc);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    background: transparent;
    border: none;
    width: 100%;
    text-align: left;
    cursor: pointer;
    transition: background 0.12s ease, color 0.12s ease;
  }

  .user-menu-item:hover {
    background: var(--surface-hover, rgba(255, 255, 255, 0.08));
    color: var(--text-primary, #fff);
  }

  .user-menu-item svg {
    color: var(--text-tertiary, #888);
    flex-shrink: 0;
    transition: color 0.12s ease;
  }

  .user-menu-item:hover svg {
    color: var(--text-primary, #fff);
  }

  .staff-item:hover {
    color: #8ea1e1;
  }
  .staff-item:hover svg {
    color: #8ea1e1;
  }

  .logout-form {
    margin: 0;
    padding: 0;
  }

  .signout-btn:hover {
    background: rgba(237, 66, 69, 0.12);
    color: #ff7b7d;
  }
  .signout-btn:hover svg {
    color: #ff7b7d;
  }

  .signin-pill {
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 600px) {
    .user-pill-name {
      display: none;
    }
    .user-pill-btn {
      padding: 2px 6px 2px 2px;
    }
  }
</style>

