{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anymex-desk",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anymex-desk",
      "migrations_dir": "drizzle"
    }
  ],

  "kv_namespaces": [{ "binding": "SESSION", "id": "c242141443344c4a840770b2ff0e05f6" }],

  "vars": {
    "DISCORD_CLIENT_ID": "1483322438551994499",
    "DISCORD_GUILD_ID": "1539489014778826904",
    "MAINTAINER_ROLE_IDS": "",
    "MIN_ACCOUNT_AGE_DAYS": "3",
    "PUBLIC_SITE_NAME": "AnymeX Desk"
  }
}
