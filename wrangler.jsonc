{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anymex-desk",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anymex-desk",
      "migrations_dir": "drizzle"
    }
  ],

  "kv_namespaces": [{ "binding": "SESSION", "id": "c242141443344c4a840770b2ff0e05f6" }],

  "triggers": {
    "crons": ["*/2 * * * *"]
  },

  "vars": {
    "DISCORD_CLIENT_ID": "1483322438551994499",
    "DISCORD_GUILD_ID": "1539489014778826904",
    "CONTRIBUTOR_GUILD_ID": "1545003117018357850",
    "DISCORD_FORUM_BUGS_ID": "1545003724961751096",
    "DISCORD_FORUM_SUGGESTIONS_ID": "1545003626823417906",
    "DISCORD_FORUM_EXTENSIONS_ID": "1545003859380805702",
    "MAINTAINER_ROLE_IDS": "",
    "MIN_ACCOUNT_AGE_DAYS": "3",
    "PUBLIC_SITE_NAME": "AnymeX Desk",
    "DISCORD_SYNC_SECRET": "anymex_sync_8f4a9b2c6e1d3075e82f419c8a74e5bd"
  }
}
